// Встреча с остатками банды (квест 1.4б, Егор 2026-10-09): через 60 дней после взрыва погреба
// первая случайная встреча в пустыне — вожак и 4 бойца, уже как дикари. Карта — копия desert2.
// Вожак заговаривает сам (f2mremc). Уговоренные бойцы при уходе героя идут в лагерь (GV_REMN_JOIN).
#define SCRIPT_REALNAME "f2mremn"
#include "define.h"
#include "updatmap.h"
#include "command.h"
#include "scenepid.h"
#include "sfall.h"
#include "define_extra.h"
#include "f2mod.h"
#include "f2mcv.h"
#include "f2mcamp.h"
#include "f2mtlay.h"
#include "f2mset.h"
#include "f2mpay.h"
#include "f2mraid.h"
#include "f2mlair.h"
#include "f2mremn.h"

#define CAR_HEX     (19096)
#define START_HEX   (20100)   // точка входа на карту (как в desert2)

procedure start;
procedure map_enter_p_proc;
procedure map_update_p_proc;
procedure map_exit_p_proc;
procedure at(variable dir, variable dist);
procedure remn_put;
procedure remn_man(variable tile, variable i);

procedure at(variable dir, variable dist) begin
   return tile_num_in_direction(START_HEX, dir, dist);
end

procedure start begin
end

procedure map_enter_p_proc begin
   Lighting;
   Check_Create_Car(CAR_HEX, 0)
   if (is_loading_game) then return;
   set_sfall_global(GV_REMN, 1);
   set_sfall_global(GV_REMN_FIGHT, 0);
   call remn_put;
end

procedure map_update_p_proc begin
   Lighting;
end

// Уговоренные бойцы (они в команде героя) идут в лагерь сами
procedure map_exit_p_proc begin
   variable c, n := 0;
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (remn_is(c) and not is_critter_dead(c) and not obj_in_party(c)
          and has_trait(TRAIT_OBJECT, c, OBJECT_TEAM_NUM) == TEAM_PLAYER) then n += 1;
   end
   if (n) then begin
      set_sfall_global(GV_REMN_JOIN, get_sfall_global_int(GV_REMN_JOIN) + n);
      display_msg(remn_msg(302));
   end
   if (not car_out_of_fuel) then begin
      if (tile_contains_pid_obj(global_var(GVAR_CAR_PLACED_TILE), 0, PID_DRIVABLE_CAR) != 0) then begin
         set_global_var(GVAR_CAR_PLACED_TILE, 0);
         car_give_to_party;
      end
   end
end

// Вожак с охотничьим ружьем, вокруг него до четырех бойцов с копьями и ножом (сколько ушло из карьера)
procedure remn_put begin
   variable obj, n, i := 0;
   n := get_sfall_global_int(GV_REMN_MEN) - 1;
   if (n > REMN_MEN) then n := REMN_MEN;
   obj := create_object_sid(PID_RAIDER_MALE, cv_free_tile(at(1, 8)), 0, SCRIPT_F2MREMC);
   call gang_setup(obj, REMN_ART_LEAD);
   call cv_arm(obj, PID_HUNTING_RIFLE, PID_223_FMJ);
   if (get_sfall_global_int(GV_REMN_KANE)) then begin
      set_critter_base_stat(obj, STAT_max_hp, 70);   // Кейн, отощавший за два месяца
      critter_heal(obj, 200);
   end
   anim(obj, ANIMATE_ROTATION, 4);
   while (i < n) do begin
      if (i == 0) then call remn_man(at(0, 9), i);
      else if (i == 1) then call remn_man(at(2, 9), i);
      else call remn_man(at(1, 8 + i), i);
      i += 1;
   end
end

procedure remn_man(variable tile, variable i) begin
   variable obj;
   obj := create_object_sid(PID_RAIDER_MALE, cv_free_tile(tile), 0, SCRIPT_F2MREMC);
   if (i % 2) then call gang_setup(obj, REMN_ART_PRMB);
   else call gang_setup(obj, REMN_ART_WARR);
   if (i == 0) then call cv_arm(obj, PID_KNIFE, 0);
   else call cv_arm(obj, PID_SPEAR, 0);
   anim(obj, ANIMATE_ROTATION, 4);
end
