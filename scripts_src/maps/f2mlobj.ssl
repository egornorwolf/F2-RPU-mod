// Предметы логова (квест 1.4): бочка с водой банды, камни над лазом в погреб, сам лаз с лестницей,
// лестница наверх и штабель с запасами внизу.
// Бочка: яд (Poison) с Наукой или Первой помощью 50 — половина банды падает, остальные слабеют.
// Лаз: виден с Восприятием 7 или если Кейн проговорился у ворот; вниз по лестнице — погреб (карта f2mcell).
// Штабель внизу: 2 динамита с Ремонтом или Наукой 40 — заряд рванет, как только герой выберется наверх,
// банда уходит из карьера без еды. Если кто-то из банды видит героя — тревога.
#define SCRIPT_REALNAME "f2mlobj"
#include "define.h"
#include "f2mod.h"
#define NAME                    SCRIPT_F2MLOBJ
#include "command.h"
#include "sfall.h"
#include "define_extra.h"
#include "scenepid.h"
#include "f2mcv.h"
#include "f2mcamp.h"
#include "f2mset.h"
#include "f2mpay.h"
#include "f2mraid.h"
#include "f2mlair.h"

procedure start;
procedure look_at_p_proc;
procedure description_p_proc;
procedure use_p_proc;
procedure use_obj_on_p_proc;
procedure noticed;
procedure poison_water;
procedure set_charge;
procedure cell_down;
procedure cell_up;

#define is_water        (obj_pid(self_obj) == PID_LAIR_WATER)
#define is_hole         (obj_pid(self_obj) == PID_CELL_HOLE)
#define is_ladder       (obj_pid(self_obj) == PID_CELL_LADDER)
#define is_stack        (obj_pid(self_obj) == PID_CELL_STACK)

procedure start begin
end

procedure look_at_p_proc begin
   script_overrides;
   if (is_water) then display_msg(mstr(230));
   else if (is_ladder) then display_msg(mstr(248));
   else if (is_stack) then begin
      if (get_sfall_global_int(GV_CELL_CHARGE)) then display_msg(mstr(252));
      else display_msg(mstr(249));
   end
   else if (is_hole) then display_msg(mstr(241));
   else if (cur_map_index == MAP_F2MOD_CELL) then display_msg(mstr(256));
   else if (get_sfall_global_int(GV_LAIR_CELLAR) == 2) then begin
      display_msg(mstr(243));
      display_msg(mstr(254));
   end
   else display_msg(mstr(240));
end

procedure description_p_proc begin
   call look_at_p_proc;
end

procedure use_p_proc begin
   script_overrides;
   if (is_water) then display_msg(mstr(231));
   else if (is_hole) then call cell_down;
   else if (is_ladder) then call cell_up;
   else if (is_stack) then begin
      if (get_sfall_global_int(GV_CELL_CHARGE)) then display_msg(mstr(252));
      else display_msg(mstr(242));
   end
   // Погреб взорван (Егор 2026-10-09): лаз откроется, когда тут начнут строить базу
   else if (get_sfall_global_int(GV_LAIR_CELLAR) == 2 and cur_map_index != MAP_F2MOD_CELL) then
      float_msg(dude_obj, mstr(255), FLOAT_MSG_YELLOW);
   else call look_at_p_proc;
end

// Вниз по лестнице: погреб — отдельная карта (f2mcell)
procedure cell_down begin
   gfade_out(1);
   load_map(MAP_F2MOD_CELL, 0);
end

// Наверх, в карьер: карта логова поставит героя у лаза (GV_CELL_BACK)
procedure cell_up begin
   set_sfall_global(GV_CELL_BACK, 1);
   gfade_out(1);
   load_map(MAP_F2MOD_LAIR, 0);
end

// Кто-то из банды смотрит на героя прямо сейчас (со Скрытностью 60 — только вплотную)
procedure noticed begin
   variable c;
   if (lair_done or get_sfall_global_int(GV_LAIR_HOW) == LAIR_HOW_ALLY) then return 0;
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (is_gang(c) and not is_critter_dead(c) and lair_seen(c)) then return 1;
   end
   return 0;
end

procedure use_obj_on_p_proc begin
   variable it;
   it := obj_pid(obj_being_used_with);
   // Завал над взорванным погребом: раскопать лопатой самому (Егор 2026-10-09: путь вниз только после расчистки)
   if (it == PID_SHOVEL and not is_hole and not is_ladder and not is_stack and not is_water
       and cur_map_index != MAP_F2MOD_CELL and get_sfall_global_int(GV_LAIR_CELLAR) == 2 and not combat_is_initialized) then begin
      script_overrides;
      if (cell_open) then return;
      gfade_out(1);
      game_time_advance(CELL_DIG_HOURS * ONE_GAME_HOUR);
      set_sfall_global(GV_CELL_OPEN, bld_hour + 1);
      gfade_in(1);
      display_msg(mstr(257));
      call lair_cellar_face;   // камни (этот объект) убирает последним делом
      return;
   end
   if (lair_done or combat_is_initialized) then return;
   if (is_water and it == PID_HYPO_POISON) then begin
      script_overrides;
      if (get_sfall_global_int(GV_LAIR_POISON)) then display_msg(mstr(234));
      else if (has_skill(dude_obj, SKILL_SCIENCE) < LAIR_POISON_SKILL and has_skill(dude_obj, SKILL_FIRST_AID) < LAIR_POISON_SKILL) then
         display_msg(mstr(232));
      else if (noticed) then begin
         display_msg(mstr(250));
         call lair_alarm;
      end else begin
         rm_obj_from_inven(dude_obj, obj_being_used_with);
         destroy_object(obj_being_used_with);
         call poison_water;
      end
   end else if (is_hole and it == PID_DYNAMITE) then begin
      script_overrides;
      display_msg(mstr(251));
   end else if (is_stack and it == PID_DYNAMITE) then begin
      script_overrides;
      if (get_sfall_global_int(GV_CELL_CHARGE)) then display_msg(mstr(252));
      else if (has_skill(dude_obj, SKILL_REPAIR) < LAIR_DYN_SKILL and has_skill(dude_obj, SKILL_SCIENCE) < LAIR_DYN_SKILL) then
         display_msg(mstr(244));
      else if (obj_is_carrying_obj_pid(dude_obj, PID_DYNAMITE) < LAIR_DYN_COUNT) then
         display_msg(mstr(245));
      else if (noticed) then begin
         display_msg(mstr(250));
         call lair_alarm;
      end else begin
         it := obj_being_used_with;
         rm_obj_from_inven(dude_obj, it);
         destroy_object(it);
         it := obj_carrying_pid_obj(dude_obj, PID_DYNAMITE);
         rm_obj_from_inven(dude_obj, it);
         destroy_object(it);
         call set_charge;
      end
   end
end

// Яд в бочке: экран гаснет на ночь, половина рядовых не просыпается, остальным плохо (Кейн жив)
procedure poison_water begin
   variable c, i := 0;
   set_sfall_global(GV_LAIR_POISON, 1);
   gfade_out(1);
   game_time_advance(6 * ONE_GAME_HOUR);
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (is_gang(c) and not is_critter_dead(c) and (obj_art_fid(c) bwand 0xFFF) != GANG_ART_BOSS) then begin
         if (i % 2 == 0) then kill_critter(c, ANIM_fall_front_sf);
         else critter_injure(c, DAM_CRIP_LEG_LEFT);
         i += 1;
      end
   end
   set_sfall_global(GV_LAIR_GANG, lair_gang_alive(0));
   gfade_in(1);
   display_msg(mstr(233));
   give_exp_points(250);
end

// Заряд под запасами банды: фитиль шипит, рванет, когда герой выберется наверх (карта логова, f2mlair.ssl)
procedure set_charge begin
   set_sfall_global(GV_CELL_CHARGE, 1);
   display_msg(mstr(246));
   float_msg(dude_obj, mstr(253), FLOAT_MSG_YELLOW);
end
