// Погреб под логовом налетчиков (квест 1.4, Егор 2026-10-08: лаз с лестницей вниз, как в доме героя).
// Внизу двое охранников банды, запасы (еда, вода, мелочь) и ящик с динамитом. Заряд закладывают здесь,
// у штабеля с запасами (скрипт предметов f2mlobj). Наверх — по лестнице у места, куда спускается герой.
#define SCRIPT_REALNAME "f2mcell"
#include "define.h"
#include "updatmap.h"
#include "command.h"
#include "scenepid.h"
#include "sfall.h"
#include "define_extra.h"
#include "f2mod.h"
#include "f2mcv.h"
#include "f2mcamp.h"
#include "f2mtlay.h"
#include "f2mset.h"
#include "f2mpay.h"
#include "f2mraid.h"
#include "f2mlair.h"
#include "f2mlairl.h"
#include "f2mcelll.h"

procedure start;
procedure map_enter_p_proc;
procedure map_exit_p_proc;
procedure cell_put;
procedure cell_guard(variable tile, variable i);
procedure cell_clear;
procedure cell_ruin;
procedure cell_looted(variable c);
procedure cell_rot;
procedure cell_move;
procedure cell_mv(variable old, variable new, variable pid);

#define GV_CELL_MOVED   "f2mcellm"  // 1 = погреб обставлен по точкам 0.9.6 (на полу пещеры, а не в черной пустоте)

procedure start begin
end

procedure map_enter_p_proc begin
   Cavern_Lighting;
   if (is_loading_game) then return;
   override_map_start_hex(cv_free_tile(CELL_HERO), 0, 2);
   if (not get_sfall_global_int(GV_CELL_PUT)) then begin
      set_sfall_global(GV_CELL_MOVED, 1);
      call cell_put;
   end
   if (not get_sfall_global_int(GV_CELL_MOVED)) then call cell_move;
   if (get_sfall_global_int(GV_LAIR_HOW) == LAIR_HOW_BLAST and not get_sfall_global_int(GV_CELL_RUIN)) then call cell_ruin;
   call cell_rot;
   if (lair_done) then call cell_clear;
end

procedure map_exit_p_proc begin
   variable c;
   if (not lair_done) then set_sfall_global(GV_CELL_GANG, lair_gang_alive(0));
   // Обобранные трупы пропадут через неделю (Егор 2026-10-09): отсчет с первого ухода после обыска
   if (get_sfall_global_int(GV_CELL_LOOT)) then return;
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (is_gang(c) and is_critter_dead(c) and cell_looted(c)) then begin
         set_sfall_global(GV_CELL_LOOT, bld_hour + 1);
         return;
      end
   end
end

// Первый спуск: лестница наверх, запасы банды, динамит и двое охранников (карта сохраняется, ставим один раз)
procedure cell_put begin
   variable box;
   set_sfall_global(GV_CELL_PUT, 1);
   create_object_sid(PID_CELL_LADDER, CELL_LADDER, 0, SCRIPT_F2MLOBJ);
   create_object_sid(PID_CELL_STACK, CELL_STACK, 0, SCRIPT_F2MLOBJ);
   box := create_object(PID_CONTAINER_WOOD_CRATE, CELL_BOX0, 0);
   add_mult_objs_to_inven(box, create_object(PID_IGUANA_ON_A_STICK, 0, 0), 4);
   add_mult_objs_to_inven(box, create_object(PID_MEAT_JERKY, 0, 0), 4);
   box := create_object(PID_CONTAINER_WOOD_CRATE, CELL_BOX1, 0);
   add_mult_objs_to_inven(box, create_object(PID_WATER_FLASK, 0, 0), 4);
   add_mult_objs_to_inven(box, create_object(PID_BEER, 0, 0), 2);
   box := create_object(PID_CONTAINER_WOOD_CRATE, CELL_BOX2, 0);
   item_caps_adjust(box, 300);
   add_mult_objs_to_inven(box, create_object(PID_STIMPAK, 0, 0), 3);
   add_mult_objs_to_inven(box, create_object(PID_SHOTGUN_SHELLS, 0, 0), 2);
   // Динамит для заряда лежит тут же, в погребе (Егор 2026-10-08)
   box := create_object(PID_CONTAINER_WOOD_CRATE, CELL_DYN, 0);
   add_mult_objs_to_inven(box, create_object(PID_DYNAMITE, 0, 0), LAIR_DYN_COUNT);
   set_sfall_global(GV_LAIR_DYN, 2);
   if (lair_done) then return;
   call cell_guard(CELL_GUARD0, 0);
   call cell_guard(CELL_GUARD1, 1);
   set_sfall_global(GV_CELL_GANG, CELL_GUARDS);
end

// Охранник погреба: тот же рядовой налетчик, что и наверху (npc-cards.md)
procedure cell_guard(variable tile, variable i) begin
   variable obj, armor, it;
   obj := create_object_sid(PID_RAIDER_MALE, cv_free_tile(tile), 0, SCRIPT_F2MLRDR);
   if (i % 2) then begin
      call gang_setup(obj, GANG_ART_JACKET);
      armor := PID_LEATHER_JACKET;
   end else begin
      call gang_setup(obj, GANG_ART_ARMOR);
      armor := PID_LEATHER_ARMOR;
   end
   it := create_object(armor, 0, 0);
   add_obj_to_inven(obj, it);
   wield_obj_critter(obj, it);
   if (i % 2) then call cv_arm(obj, PID_10MM_SMG, PID_10MM_JHP);
   else call cv_arm(obj, PID_SAWED_OFF_SHOTGUN, PID_SHOTGUN_SHELLS);
   anim(obj, ANIMATE_ROTATION, random(0, 5));
end

// Логово взято: люди Кейна в союзе — свои, в остальных случаях банда ушла из погреба
procedure cell_clear begin
   variable c;
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (is_gang(c) and not is_critter_dead(c)) then begin
         if (get_sfall_global_int(GV_LAIR_HOW) == LAIR_HOW_ALLY) then
            critter_add_trait(c, TRAIT_OBJECT, OBJECT_TEAM_NUM, TEAM_PLAYER);
         else destroy_object(c);
      end
   end
   set_sfall_global(GV_CELL_GANG, 0);
end

// Погреб после взрыва (Егор 2026-10-09): охрана погибла, штабель с запасами под обвалом.
// Трупы и ящики с тем, что в них было, остаются: спуститься можно только после расчистки (cell_open в f2mlair.h)
procedure cell_ruin begin
   variable c, obj, i := 0;
   set_sfall_global(GV_CELL_RUIN, 1);
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (is_gang(c) and not is_critter_dead(c)) then begin
         if (i % 2 == 0) then kill_critter(c, ANIM_fall_back_blood_sf);
         else kill_critter(c, ANIM_fall_front_sf);
         i += 1;
      end
   end
   obj := tile_contains_pid_obj(CELL_STACK, 0, PID_CELL_STACK);
   if (obj) then destroy_object(obj);
   create_object_sid(PID_LAIR_CELLAR, CELL_STACK, 0, SCRIPT_F2MLOBJ);
   set_sfall_global(GV_CELL_GANG, 0);
end

// Труп обобран: оружия при нем нет (его забрал герой)
procedure cell_looted(variable c) begin
   return not obj_carrying_pid_obj(c, PID_10MM_SMG) and not obj_carrying_pid_obj(c, PID_SAWED_OFF_SHOTGUN);
end

// Неделя после обыска прошла: обобранные трупы убираем, необобранные лежат
procedure cell_rot begin
   variable c, t;
   t := get_sfall_global_int(GV_CELL_LOOT);
   if (not t or bld_hour + 1 < t + 7 * 24) then return;
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (is_gang(c) and is_critter_dead(c) and cell_looted(c)) then destroy_object(c);
   end
end

// Сохранения 0.8.3-0.9.5 (Егор 2026-10-09: черный экран в погребе): лестница, ящики и охрана стояли в черной
// пустоте пещеры. Переносим их на пол, к новым точкам f2mcelll.h; содержимое ящиков и трупы остаются как были
procedure cell_mv(variable old, variable new, variable pid) begin
   variable obj;
   obj := tile_contains_pid_obj(old, 0, pid);
   if (obj) then move_to(obj, new, 0);
end

procedure cell_move begin
   variable c, i := 0;
   set_sfall_global(GV_CELL_MOVED, 1);
   call cell_mv(19899, CELL_LADDER, PID_CELL_LADDER);
   call cell_mv(21309, CELL_STACK, PID_CELL_STACK);
   call cell_mv(21309, CELL_STACK, PID_LAIR_CELLAR);
   call cell_mv(21908, CELL_BOX0, PID_CONTAINER_WOOD_CRATE);
   call cell_mv(20710, CELL_BOX1, PID_CONTAINER_WOOD_CRATE);
   call cell_mv(20908, CELL_BOX2, PID_CONTAINER_WOOD_CRATE);
   call cell_mv(20697, CELL_DYN, PID_CONTAINER_WOOD_CRATE);
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (is_gang(c) and not obj_in_party(c)) then begin
         if (i % 2) then move_to(c, cv_free_tile(CELL_GUARD1), 0);
         else move_to(c, cv_free_tile(CELL_GUARD0), 0);
         i += 1;
      end
   end
end
