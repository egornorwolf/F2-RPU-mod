// Карта встречи с караваном «Хорошее место»: караванщик, два охранника, два брамина,
// три фургона и десять мирных переселенцев.
#define SCRIPT_REALNAME "f2mcrvn"
#include "define.h"
#include "updatmap.h"
#include "command.h"
#include "scenepid.h"
#include "sfall.h"
#include "f2mod.h"
#include "f2mcv.h"

#define CAR_HEX     (19096)
#define START_HEX   (20100)   // точка входа на карту (как в desert2)

procedure start;
procedure map_enter_p_proc;
procedure map_update_p_proc;
procedure map_exit_p_proc;
procedure at(variable dir, variable dist);

procedure at(variable dir, variable dist) begin
   return tile_num_in_direction(START_HEX, dir, dist);
end

procedure start begin
end



procedure map_enter_p_proc begin
   variable obj;
   set_map_exit_tiles(0, 0);
   Lighting;
   Check_Create_Car(CAR_HEX, 0)
   // На эту карту попадаем только через встречу, пока координаты не получены
   if (not is_loading_game and get_sfall_global_int(GV_CARAVAN) == CARAVAN_NONE
       and not tile_contains_pid_obj(tile_num_in_direction(START_HEX, 1, 7), 0, PID_AVERAGE_MERCHANT_MALE)) then begin
      set_sfall_global(GV_CARAVAN_HOSTILE, 0);
      // На встречу караван всегда приходит целым: потери прошлой дороги забываем
      set_sfall_global(GV_CARAVAN_DEAD, 0);
      obj := cv_ted(at(1, 7));
      item_caps_adjust(obj, random(50, 150));
      call cv_guard(CV_SLOT_GUARD, at(0, 8));
      call cv_guard(CV_SLOT_SARA, at(2, 8));
      call cv_brahmin(CV_SLOT_BRAHMIN, at(1, 10));
      call cv_brahmin(CV_SLOT_BRAHMIN + 1, at(2, 11));
      call cv_wagons(at(1, 14));
      call cv_civilians(at(1, 14), 0);
      #ifdef F2MOD_DEBUG
      display_msg("F2mod (отладка): караван поставлен, герой на клетке " + dude_tile + ", уровень " + dude_elevation + ".");
      #endif
   end
end

procedure map_update_p_proc begin
   Lighting;
end

procedure map_exit_p_proc begin
   if (not car_out_of_fuel) then begin
      if (tile_contains_pid_obj(global_var(GVAR_CAR_PLACED_TILE), 0, PID_DRIVABLE_CAR) != 0) then begin
         set_global_var(GVAR_CAR_PLACED_TILE, 0);
         car_give_to_party;
      end
   end
end
