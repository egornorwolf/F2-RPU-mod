// Карта встречи с караваном «Хорошее место»: караванщик, два охранника и два брамина.
#define SCRIPT_REALNAME "f2mcrvn"
#include "define.h"
#include "updatmap.h"
#include "command.h"
#include "scenepid.h"
#include "sfall.h"
#include "f2mod.h"

#define CAR_HEX     (19096)
#define START_HEX   (20100)   // точка входа на карту (как в desert2)

procedure start;
procedure map_enter_p_proc;
procedure map_update_p_proc;
procedure map_exit_p_proc;
procedure put_critter(variable pid, variable sid, variable dir, variable dist);
procedure arm(variable who, variable weapon, variable ammo);

procedure start begin
end

procedure put_critter(variable pid, variable sid, variable dir, variable dist) begin
   variable obj;
   obj := create_object_sid(pid, tile_num_in_direction(START_HEX, dir, dist), 0, sid);
   critter_add_trait(obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, TEAM_CARAVAN);
   return obj;
end

procedure arm(variable who, variable weapon, variable ammo) begin
   variable item;
   item := create_object(weapon, 0, 0);
   add_obj_to_inven(who, item);
   wield_obj_critter(who, item);
   if (ammo) then add_mult_objs_to_inven(who, create_object(ammo, 0, 0), 2);
end

procedure map_enter_p_proc begin
   variable obj;
   set_map_exit_tiles(0, 0);
   Lighting;
   Check_Create_Car(CAR_HEX, 0)
   // На эту карту попадаем только через встречу, пока координаты не получены
   if (not is_loading_game and get_sfall_global_int(GV_CARAVAN) == CARAVAN_NONE
       and not tile_contains_pid_obj(tile_num_in_direction(START_HEX, 1, 7), 0, PID_AVERAGE_MERCHANT_MALE)) then begin
      set_sfall_global(GV_CARAVAN_HOSTILE, 0);
      obj := put_critter(PID_AVERAGE_MERCHANT_MALE, SCRIPT_F2MCMST, 1, 7);
      critter_add_trait(obj, TRAIT_OBJECT, OBJECT_AI_PACKET, AI_STORE_OWNER);
      item_caps_adjust(obj, random(50, 150));
      obj := put_critter(PID_GUN_GUARD_MALE, SCRIPT_F2MCGRD, 0, 8);
      call arm(obj, PID_10MM_SMG, PID_10MM_JHP);
      obj := put_critter(PID_GUN_GUARD_FEMALE, SCRIPT_F2MCGRD, 2, 8);
      call arm(obj, PID_HUNTING_RIFLE, PID_223_FMJ);
      call put_critter(PID_BRAHMIN, SCRIPT_ECBRAHMN, 1, 10);
      call put_critter(PID_BRAHMIN, SCRIPT_ECBRAHMN, 2, 11);
      #ifdef F2MOD_DEBUG
      display_msg("F2mod (отладка): караван поставлен, герой на клетке " + dude_tile + ", уровень " + dude_elevation + ".");
      #endif
   end
end

procedure map_update_p_proc begin
   Lighting;
end

procedure map_exit_p_proc begin
   if (not car_out_of_fuel) then begin
      if (tile_contains_pid_obj(global_var(GVAR_CAR_PLACED_TILE), 0, PID_DRIVABLE_CAR) != 0) then begin
         set_global_var(GVAR_CAR_PLACED_TILE, 0);
         car_give_to_party;
      end
   end
end
