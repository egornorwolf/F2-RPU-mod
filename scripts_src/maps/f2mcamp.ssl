// Карта поселения «Лагерь у скал». М1: пустая карта, свет по времени суток и машина героя.
// М2 (тестовый режим): после координат караван Теда Бернса уже стоит в лагере.
// Позже: караван приходит через пару недель, а в М3 здесь появится палаточный лагерь.
#define SCRIPT_REALNAME "f2mcamp"
#include "define.h"
#include "updatmap.h"
#include "command.h"
#include "scenepid.h"
#include "sfall.h"
#include "f2mod.h"
#include "f2mcv.h"

// Где ставить машину (та же точка, что в desert1, с которой взят пол карты)
#define CAR_HEX   (19096)

procedure start;
procedure map_enter_p_proc;
procedure map_update_p_proc;
procedure map_exit_p_proc;

#define START_HEX   (20100)
variable spawned;

procedure start begin
end



procedure map_enter_p_proc begin
   variable base;
   set_map_exit_tiles(0, 0);
   Lighting;
   Check_Create_Car(CAR_HEX, 0)
   // Карта сохраняется, поэтому караван ставим один раз, при первом входе после координат
   if (spawned or is_loading_game or get_sfall_global_int(GV_CARAVAN) != CARAVAN_DONE
       or get_sfall_global_int(GV_CAMP_CARAVAN)) then return;
   spawned := 1;
   set_sfall_global(GV_CAMP_CARAVAN, 1);
   base := tile_num_in_direction(START_HEX, 1, 10);
   // Дошли все, кто уцелел в пути (после координат без дороги — все)
   call cv_ted(base);
   call cv_guard(CV_SLOT_GUARD, tile_num_in_direction(base, 0, 3));
   call cv_guard(CV_SLOT_SARA, tile_num_in_direction(base, 2, 3));
   call cv_brahmin(CV_SLOT_BRAHMIN, tile_num_in_direction(base, 1, 6));
   call cv_brahmin(CV_SLOT_BRAHMIN + 1, tile_num_in_direction(base, 2, 6));
   call cv_wagons(tile_num_in_direction(base, 1, 12));
   call cv_civilians(tile_num_in_direction(base, 1, 12), 0);
end

procedure map_update_p_proc begin
   Lighting;
end

procedure map_exit_p_proc begin
   if (not car_out_of_fuel) then begin
      if (tile_contains_pid_obj(global_var(GVAR_CAR_PLACED_TILE), 0, PID_DRIVABLE_CAR) != 0) then begin
         set_global_var(GVAR_CAR_PLACED_TILE, 0);
         car_give_to_party;
      end
   end
end
