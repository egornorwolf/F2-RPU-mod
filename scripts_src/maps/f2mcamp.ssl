// Карта поселения «Лагерь у скал». М1: пустая карта, свет по времени суток и машина героя.
// М2 (тестовый режим): после координат караван Теда Бернса уже стоит в лагере.
// М3: палаточный лагерь (f2mlay.h): костер, стол старосты, 3 палатки переселенцев и палатка героя
// с сундуком, старый заколоченный колодец, прораб Хэнк. Позже караван будет приходить через пару недель.
#define SCRIPT_REALNAME "f2mcamp"
#include "define.h"
#include "updatmap.h"
#include "command.h"
#include "scenepid.h"
#include "sfall.h"
#include "f2mod.h"
#include "f2mcv.h"
#include "f2mcamp.h"
#include "f2mlay.h"
#include "f2mset.h"

// Где ставить машину (та же точка, что в desert1, с которой взят пол карты)
#define CAR_HEX   (19096)

procedure start;
procedure map_enter_p_proc;
procedure map_update_p_proc;
procedure map_exit_p_proc;
procedure camp_layout;
procedure camp_sync_people;
procedure camp_sync_pid(variable pid);

#define START_HEX   (20100)
variable spawned;

procedure start begin
end

procedure map_enter_p_proc begin
   variable wag, old;
   set_map_exit_tiles(0, 0);
   Lighting;
   Check_Create_Car(CAR_HEX, 0)
   // Старый колодец починен: убираем спрятанный заколоченный (на его месте открытый)
   if (not is_loading_game and get_sfall_global_int(GV_WELL_OLD) == WELL_OLD_FIXED) then begin
      old := tile_contains_pid_obj(LAY_OLDWELL, 0, PID_WELL_OLD);
      if (old) then destroy_object(old);
   end
   // Ушедшие из лагеря исчезают, вернувшиеся снова у костра (f2mset.h, недельный тик)
   if (not is_loading_game and get_sfall_global_int(GV_CAMP_CARAVAN)) then call camp_sync_people;
   // Карта сохраняется, поэтому все ставим один раз, при первом входе после координат
   if (spawned or is_loading_game or get_sfall_global_int(GV_CARAVAN) != CARAVAN_DONE) then return;
   spawned := 1;
   // Сначала палатки и костер, чтобы люди встали не в стену. В старых сохранениях (0.2.x)
   // караван уже стоит: тогда добавляется только сам лагерь и прораб.
   if (not get_sfall_global_int(GV_CAMP_LAYOUT)) then call camp_layout;
   if (get_sfall_global_int(GV_CAMP_CARAVAN)) then return;
   set_sfall_global(GV_CAMP_CARAVAN, 1);
   wag := tile_num_in_direction(tile_num_in_direction(START_HEX, 1, 10), 1, 12);
   // Дошли все, кто уцелел в пути (после координат без дороги — все)
   call cv_ted(LAY_TED);
   call cv_guard(CV_SLOT_GUARD, LAY_CHIEF);
   call cv_guard(CV_SLOT_SARA, tile_num_in_direction(LAY_CHIEF, 2, 3));
   call cv_brahmin(CV_SLOT_BRAHMIN, tile_num_in_direction(wag, 4, 4));
   call cv_brahmin(CV_SLOT_BRAHMIN + 1, tile_num_in_direction(wag, 3, 4));
   call cv_wagons(wag);
   call cv_civilians(LAY_FIRE, 0);
end

// Палаточный лагерь и прораб Хэнк (с монтировкой: у его модели nmpeas есть анимации дубины)
procedure camp_layout begin
   variable who, i := 0;
   set_sfall_global(GV_CAMP_LAYOUT, 1);
   set_sfall_global(GV_CAMP_DAY, game_time / ONE_GAME_HOUR);
   call lay_camp;
   while (i < BUILD_COUNT) do begin
      if (camp_built(i)) then call lay_slot(i);
      i += 1;
   end
   who := cv_put(PID_DOCK_WORKER, SCRIPT_F2MCFRM, LAY_FOREMAN);
   call cv_arm(who, PID_CROWBAR, 0);
end

// Сколько людей такого вида должно быть в лагере (живы и не ушли) и сколько стоит на карте.
// Лишних убираем, недостающих ставим у костра. Переселенцы одного вида взаимозаменяемы.
procedure camp_sync_pid(variable pid) begin
   variable i := CV_SLOT_SARA, want := 0, c, n := 0, obj;
   while (i < CV_SLOTS) do begin
      if (i != CV_SLOT_BRAHMIN and i != CV_SLOT_BRAHMIN + 1 and cv_slot_pid(i) == pid and set_here(i)) then want += 1;
      i += 1;
   end
   set_sfall_global(GV_SET_LEAVING, 1);
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (obj_pid(c) == pid and not is_critter_dead(c)) then begin
         n += 1;
         if (n > want) then destroy_object(c);
      end
   end
   set_sfall_global(GV_SET_LEAVING, 0);
   while (n < want) do begin
      if (pid == PID_GUN_GUARD_FEMALE) then
         call cv_guard(CV_SLOT_SARA, tile_num_in_direction(LAY_CHIEF, 2, 3));
      else begin
         obj := cv_put(pid, SCRIPT_F2MCCIV, tile_num_in_direction(LAY_FIRE, random(0, 5), random(2, 4)));
         critter_add_trait(obj, TRAIT_OBJECT, OBJECT_AI_PACKET, AI_ADDICT_WIMPY);
      end
      n += 1;
   end
end

procedure camp_sync_people begin
   call camp_sync_pid(PID_GUN_GUARD_FEMALE);
   call camp_sync_pid(PID_WEAK_PEASANT_MALE);
   call camp_sync_pid(PID_AVERAGE_PEASANT_MALE);
   call camp_sync_pid(PID_WEAK_PEASANT_FEMALE);
   call camp_sync_pid(PID_AVERAGE_PEASANT_FEMALE);
   call camp_sync_pid(PID_CHILD_MALE);
   call camp_sync_pid(PID_CHILD_FEMALE);
end

procedure map_update_p_proc begin
   Lighting;
end

procedure map_exit_p_proc begin
   if (not car_out_of_fuel) then begin
      if (tile_contains_pid_obj(global_var(GVAR_CAR_PLACED_TILE), 0, PID_DRIVABLE_CAR) != 0) then begin
         set_global_var(GVAR_CAR_PLACED_TILE, 0);
         car_give_to_party;
      end
   end
end
