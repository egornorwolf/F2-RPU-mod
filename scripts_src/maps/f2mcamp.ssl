// Карта поселения «Лагерь у скал». М1: пустая карта, свет по времени суток и машина героя.
// М2 (тестовый режим): после координат караван Теда Бернса уже стоит в лагере.
// 0.5.0: лагерь на карте города (f2mset.map, f2mtlay.h). М3: палаточный лагерь (раньше f2mlay.h): костер, стол старосты, 3 палатки переселенцев и палатка героя
// с сундуком, старый заколоченный колодец, прораб Хэнк. Позже караван будет приходить через пару недель.
// 0.7.0: уровни зданий (f2mbld.h, f2mlvl.h): достроенное без героя встает на карту при входе.
#define SCRIPT_REALNAME "f2mcamp"
#include "define.h"
#include "updatmap.h"
#include "command.h"
#include "scenepid.h"
#include "sfall.h"
#include "define_extra.h"
#include "f2mod.h"
#include "f2mcv.h"
#include "f2mcamp.h"
#include "f2mtlay.h"
#include "f2mset.h"
#include "f2msync.h"
#include "f2mfence.h"
#include "f2mpay.h"
#include "f2mraid.h"
#include "f2mspots.h"
#include "f2mlvl.h"
#include "f2mhome.h"
#include "f2mbldap.h"
#include "f2mgore.h"
#include "f2msam.h"
#include "f2mfarm.h"
#include "f2mlair.h"
#include "f2mremn.h"


procedure start;
procedure map_enter_p_proc;
procedure map_update_p_proc;
procedure map_exit_p_proc;
procedure camp_layout;
procedure camp_people_put;
procedure camp_ruins;
procedure raid_decor;
procedure raid_corpse(variable pid, variable tile, variable art);
procedure raid_blood(variable center, variable n, variable r);
procedure raid_crates(variable center, variable n);
procedure wagon_walk(variable t, variable rot, variable cnt);
procedure wagon_steal;
procedure wagon_back;
procedure boss_leftovers;
procedure boss_corpse;
procedure hank_move;
procedure camp_peace;
procedure grave_fix;
procedure sam_enter;
procedure farm_enter;
procedure shovel_put;



procedure start begin
end

procedure map_enter_p_proc begin
   variable old;
   set_map_exit_tiles(0, 0);
   Lighting;
   Check_Create_Car(LAY_CAR, 0)
   if (is_loading_game) then return;
   // Старый колодец починен: убираем спрятанный заколоченный (на его месте открытый)
   if (get_sfall_global_int(GV_WELL_OLD) == WELL_OLD_FIXED) then begin
      old := tile_contains_pid_obj(LAY_OLDWELL, 0, PID_WELL_OLD);
      if (old) then destroy_object(old);
   end
   // Развалины на участках будущих зданий стоят с первого визита (и появляются в сохранениях 0.5.0)
   if (get_sfall_global_int(GV_TOWN_RUINS) < 5) then call camp_ruins;
   if (get_sfall_global_int(GV_CARAVAN) != CARAVAN_DONE) then return;
   // Карта сохраняется: лагерь и люди ставятся один раз, при первом входе после координат.
   // Сохранения с прежней карты лагеря (173, до 0.5.0): все, что построено, и все, кто жив, — на новой карте.
   if (not get_sfall_global_int(GV_TOWN_LAYOUT)) then call camp_layout;
   if (not get_sfall_global_int(GV_TOWN_PEOPLE)) then call camp_people_put;
   // Набег 1.3: пора, а герой был в отлучке — считаем его до расстановки людей (погибший житель исчезнет с карты)
   if (raid_due) then call raid_do;
   set_sfall_global(GV_RAID_AWAY, 0);
   if (get_sfall_global_int(GV_FENCE)) then call lay_fence;
   // До 0.5.6 палатку героя ставили сразу: в таких сохранениях она уже стоит, считаем ее построенной
   if (not camp_built(BUILD_HERO) and tile_contains_pid_obj(LAY_HEROTENT, 0, LAY_HEROPID)) then call camp_set_built(BUILD_HERO);
   // Ушедшие из лагеря исчезают, вернувшиеся снова у костра (f2mset.h, недельный тик); двойников убираем
   call camp_sync_people;
   call camp_dedupe;
   // Горящие бочки у людей и свет кострища
   call lay_lights;
   // Уровни зданий (0.7.0): что Хэнк достроил, пока героя не было, встает на карту
   call bld_commit;
   call bld_apply;
   call bld_fire_light;
   call sam_enter;
   call farm_enter;
   call remn_arrive;
   call shovel_put;
   set_sfall_global(GV_SET_SYNC, 0);
   // Следы набега, угнанный фургон, главарь у ворот (1.3а)
   if (get_sfall_global_int(GV_RAID_DECOR)) then call raid_decor;
   if (get_sfall_global_int(GV_WAGON) == 1 and game_time / ONE_GAME_HOUR >= get_sfall_global_int(GV_RAID_HOUR) + WAGON_HOURS) then call wagon_back;
   call boss_leftovers;
   call hank_move;
   call camp_peace;
   call grave_fix;
   call gore_update;
   call camp_spread(0);
   if (get_sfall_global_int(GV_BOSS_NOTE) == 2) then begin
      set_sfall_global(GV_BOSS_NOTE, 1);
      display_msg("Рик обыскал главаря налетчиков: «Знаем, где их нора. Старый карьер в горах, день пути на северо-восток».");
   end
   if (boss_due) then begin
      call boss_put;
      display_msg("У южных ворот стоит главарь налетчиков. Его люди ждут на краю карты.");
   end
end

// Лопата (Shovel) всегда лежит у северного частокола (Егор 2026-10-09): ею раскапывают завал погреба в карьере.
// Унес и потерял — при следующем входе в лагерь на месте новая
procedure shovel_put begin
   if (tile_contains_pid_obj(CAMP_SHOVEL, 0, PID_SHOVEL) or obj_carrying_pid_obj(dude_obj, PID_SHOVEL)) then return;
   create_object(PID_SHOVEL, CAMP_SHOVEL, 0);
end

// Радист (0.7.1): живет у старосты, стол с радио; новости о его приходе
procedure sam_enter begin
   variable st, nw;
   st := get_sfall_global_int(GV_SAM);
   nw := get_sfall_global_int(GV_SAM_NEWS);
   if (st >= SAM_HERE and st <= SAM_RADIO) then call sam_put;
   call sam_radio_decor;
   if (nw == 1) then display_msg(message_str(SCRIPT_F2MRADIO, 304));
   else if (nw == 2) then display_msg(message_str(SCRIPT_F2MRADIO, 305));
   if (nw == 1 or (nw == 2 and st != SAM_NONE)) then set_sfall_global(GV_SAM_NEWS, 0);
end

// Старший фермер (2.2, 2.3): живет на огородах; новость о его приходе
procedure farm_enter begin
   if (not farm_here) then return;
   call farm_put;
   if (get_sfall_global_int(GV_FARM_NEWS) == 1) then begin
      set_sfall_global(GV_FARM_NEWS, 0);
      display_msg(farm_msg(205));
   end
end

// Хэнк на своем месте у ворот: при первом входе после 0.6.6 и если после боя остался у костра
procedure hank_move begin
   variable c;
   if (combat_is_initialized) then return;
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (obj_pid(c) == PID_DOCK_WORKER and not is_critter_dead(c) and not obj_in_party(c)
          and (get_sfall_global_int(GV_HANK_MOVED) < 2 or tile_distance(tile_num(c), HANK_SPOT) > 3)) then begin
         critter_attempt_placement(c, HANK_SPOT, 0);
         anim(c, ANIMATE_ROTATION, 2);
      end
   end
   set_sfall_global(GV_HANK_MOVED, 2);
end

// Герой ушел с карты и вернулся: лагерь опускает оружие, Тед (или Рик) требует штраф (f2mfine.h)
procedure camp_peace begin
   variable c;
   if (not get_sfall_global_int(GV_CARAVAN_HOSTILE)) then return;
   set_sfall_global(GV_CARAVAN_HOSTILE, 0);
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (not is_critter_dead(c) and has_trait(TRAIT_OBJECT, c, OBJECT_TEAM_NUM) == TEAM_CARAVAN) then
         set_object_data(c, OBJ_DATA_WHO_HIT_ME, 0);
   end
   if (get_sfall_global_int(GV_CAMP_FINE) > 0) then
      display_msg("Жители опустили оружие, но смотрят косо. За стрельбу по своим с вас требуют штраф: " + get_sfall_global_int(GV_CAMP_FINE) + " крышек.");
   else
      display_msg("Жители опустили оружие, но смотрят косо.");
end

// Надгробие до 0.6.6 ставилось с чужим скриптом могилы из прототипа (в игре «Error»): ставим заново, без скрипта
procedure grave_fix begin
   variable g;
   if (get_sfall_global_int(GV_GRAVE_FIX)) then return;
   set_sfall_global(GV_GRAVE_FIX, 1);
   g := tile_contains_pid_obj(BURY_GRAVE, 0, PID_BURY_STONE);
   if (not g) then return;
   destroy_object(g);
   create_object_sid(PID_BURY_STONE, BURY_GRAVE, 0, -1);
end

procedure boss_corpse begin
   variable c;
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (is_critter_dead(c) and obj_pid(c) == PID_RAIDER_MALE and (obj_art_fid(c) bwand 0xFFF) == GANG_ART_BOSS) then return c;
   end
   return 0;
end

// Бой у ворот кончился без героя на карте или банда пережила бой: живых налетчиков больше нет у лагеря
procedure boss_leftovers begin
   if (get_sfall_global_int(GV_BOSS) != BOSS_FIGHT) then return;
   call gang_remove;
   set_sfall_global(GV_BOSS, BOSS_BEATEN);
end

// Труп без скрипта (погибший житель или налетчик), налетчику — модель банды
procedure raid_corpse(variable pid, variable tile, variable art) begin
   variable obj;
   obj := create_object_sid(pid, cv_free_tile(tile), 0, -1);
   if (art) then art_change_fid_num(obj, art);
   kill_critter(obj, ANIM_fall_back_blood_sf);
end

procedure raid_blood(variable center, variable n, variable r) begin
   call gore_blood_mark;
   while (n > 0) do begin
      create_object(PID_BLOOD_1 + random(0, 8), tile_num_in_direction(center, random(0, 5), random(1, r)), 0);
      n -= 1;
   end
end

// Разбросанные ящики и коробки (crate1-3, boxes1-4 из карт F2)
procedure raid_crates(variable center, variable n) begin
   variable pid, t;
   while (n > 0) do begin
      pid := random(0, 6);
      if (pid < 3) then pid := 33554833 + pid;   // crate1-3
      else pid := 33554652 + pid - 3;           // boxes1-4
      t := tile_num_in_direction(center, random(0, 5), random(2, 4));
      if (not obj_blocking_tile(t, 0, BLOCKING_TYPE_BLOCK)) then create_object(pid, t, 0);
      n -= 1;
   end
end

// Обход клеток-блоков фургона так же, как их ставит Create_EW_Caravan (scenepid.h RPU): блоки убираем
procedure wagon_walk(variable t, variable rot, variable cnt) begin
   variable obj;
   while (cnt > 0) do begin
      t := tile_num_in_direction(t, rot, 1);
      obj := tile_contains_pid_obj(t, 0, PID_BLOCKING_HEX);
      if (obj) then destroy_object(obj);
      cnt -= 1;
   end
   return t;
end

// Налетчики угнали фургон (разбитых фургонов в игре нет): на его месте дышло и вывалившиеся ящики
procedure wagon_steal begin
   variable w, obj, t;
   w := RAID_WAGON;
   obj := tile_contains_pid_obj(w, 0, PID_EW_RED_CARAVAN);
   if (not obj) then return;
   destroy_object(obj);
   t := wagon_walk(w, 1, 1);
   t := wagon_walk(t, 3, 2);
   t := wagon_walk(t, 4, 2);
   t := wagon_walk(t, 5, 1);
   t := wagon_walk(t, 0, 1);
   t := wagon_walk(t, 5, 1);
   t := wagon_walk(t, 1, 2);
   t := wagon_walk(w, 3, 1);
   t := wagon_walk(t, 4, 1);
   t := wagon_walk(t, 0, 1);
   create_object(PID_RED_CARAVAN_HANDLE, w, 0);
   call raid_crates(w, 4);
end

// Тед купил новый фургон у каравана
procedure wagon_back begin
   variable w, obj;
   set_sfall_global(GV_WAGON, 2);
   w := RAID_WAGON;
   obj := tile_contains_pid_obj(w, 0, PID_RED_CARAVAN_HANDLE);
   if (obj) then destroy_object(obj);
   if (not tile_contains_pid_obj(w, 0, PID_EW_RED_CARAVAN)) then begin
      Create_EW_Red_Caravan(w, 0)
   end
   display_msg("Тед купил у проходящего каравана новый фургон.");
end

// Следы набега (1.3) и свод потерь в окно сообщений
procedure raid_decor begin
   variable out, dead, i, n := 0, msg;
   set_sfall_global(GV_RAID_DECOR, 0);
   out := get_sfall_global_int(GV_RAID_OUT);
   dead := get_sfall_global_int(GV_RAID_DEAD);
   // кровь у ворот и у костра, трупы налетчиков перед воротами, погибший житель у ворот
   call raid_blood(RAID_GATE_IN, 3 + 2 * (out != RAID_OUT_NONE), 5);
   call raid_blood(RAID_GATE_OUT, 3, 4);
   call raid_blood(camp_fire, 2, 4);
   i := 2;
   if (out == RAID_OUT_GUARD) then i := 5;
   while (i > 0) do begin
      if (i % 2) then
         call raid_corpse(PID_RAIDER_MALE, tile_num_in_direction(RAID_GATE_OUT, random(0, 5), random(1, 5)), GANG_ART_JACKET);
      else
         call raid_corpse(PID_RAIDER_MALE, tile_num_in_direction(RAID_GATE_OUT, random(0, 5), random(1, 5)), GANG_ART_ARMOR);
      i -= 1;
   end
   if (dead) then call raid_corpse(dead, RAID_GATE_IN, 0);
   // палатки и фургон
   i := BUILD_TENT;
   while (i < BUILD_HERO) do begin
      if (get_sfall_global_int(GV_RAID_TENTS) bwand cv_bit(i)) then begin
         call lay_slot_clear(i);
         n += 1;
      end
      i += 1;
   end
   if (get_sfall_global_int(GV_WAGON) == 1) then call wagon_steal;
   else if (out == RAID_OUT_FENCE) then call raid_crates(LAY_WAGONS, 5);
   else call raid_crates(LAY_WAGONS, 2);

   msg := "Пока вас не было, ночью на лагерь напали налетчики. ";
   if (out == RAID_OUT_NONE) then
      msg += "Унесли все запасы";
   else if (out == RAID_OUT_FENCE) then
      msg += "Частокол помог, но не спас. Унесли пятую часть запасов";
   else
      msg += "Охрана отбилась. Унесли десятую часть запасов";
   msg += ": еды " + get_sfall_global_int(GV_RAID_FOOD) + ", воды " + get_sfall_global_int(GV_RAID_WATER) + " пайков.";
   display_msg(msg);
   if (n) then display_msg("Сломаны палатки: " + n + ".");
   if (get_sfall_global_int(GV_WAGON) == 1) then display_msg("Угнан фургон.");
   if (dead) then display_msg("Погиб один из жителей. Люди злы: дух -10% на неделю.");
   if (out == RAID_OUT_GUARD) then display_msg("Налетчики это запомнят: следующий набег будет сильнее.");
end

// Развалины (f2mtlay.h): целые куски руин из карт развалин города city1/city2. Что уже построено на участке жилья (палатки 4-8), стоит без развалин
procedure camp_ruins begin
   variable i := 3;
   if (get_sfall_global_int(GV_TOWN_RUINS)) then call lay_ruins_old;   // руины 0.5.1-0.5.5 в сохранении
   set_sfall_global(GV_TOWN_RUINS, 5);
   call lay_ruins;
   while (i < BUILD_HERO) do begin
      if (camp_built(i)) then call lay_ruin_clear(i - 3);
      i += 1;
   end
end

// Палаточный лагерь (1-й уровень зданий города, f2mtlay.h) и прораб Хэнк
// (с монтировкой: у его модели nmpeas есть анимации дубины)
procedure camp_layout begin
   variable who, i := 0;
   set_sfall_global(GV_TOWN_LAYOUT, 1);
   if (not get_sfall_global_int(GV_CAMP_LAYOUT)) then begin
      set_sfall_global(GV_CAMP_LAYOUT, 1);
      set_sfall_global(GV_CAMP_DAY, game_time / ONE_GAME_HOUR);
   end else
      call camp_set_built(BUILD_HERO);   // лагерь с прежней карты (до 0.5.0): там палатка героя уже стояла
   call lay_camp;
   while (i < BUILD_COUNT) do begin
      if (camp_built(i)) then call lay_slot(i);
      i += 1;
   end
   who := cv_put(PID_DOCK_WORKER, SCRIPT_F2MCFRM, HANK_SPOT);
   set_sfall_global(GV_HANK_MOVED, 1);
   call cv_arm(who, PID_CROWBAR, 0);
end

// Караван у костра: Тед у стола, охрана у южной дороги, фургоны и брамины во дворе, переселенцы у костра.
// Дошли все, кто уцелел в пути (после координат без дороги — все); ушедших уберет camp_sync_people.
procedure camp_people_put begin
   set_sfall_global(GV_TOWN_PEOPLE, 1);
   set_sfall_global(GV_CAMP_CARAVAN, 1);
   call cv_ted(LAY_TED);
   call cv_guard(CV_SLOT_GUARD, LAY_CHIEF);
   call cv_guard(CV_SLOT_SARA, tile_num_in_direction(LAY_CHIEF, 2, 3));
   call cv_brahmin(CV_SLOT_BRAHMIN, tile_num_in_direction(LAY_WAGONS, 4, 4));
   call cv_brahmin(CV_SLOT_BRAHMIN + 1, tile_num_in_direction(LAY_WAGONS, 3, 4));
   call cv_wagons(LAY_WAGONS);
   call cv_civilians(camp_fire, 0);
end

procedure map_update_p_proc begin
   Lighting;
   // днем жители у палаток и на огородах, ночью в палатках (f2mhome.h)
   if (get_sfall_global_int(GV_CARAVAN) == CARAVAN_DONE and not is_loading_game) then begin
      call camp_spread(1);
      call gore_update;   // кровь сохнет, собаки едят тела (f2mgore.h)
   end
end

procedure map_exit_p_proc begin
   // Набег 1.3 ждет, пока герой не уйдет; спутник, оставленный в лагере, считается охраной
   if (get_sfall_global_int(GV_CARAVAN) == CARAVAN_DONE) then begin
      set_sfall_global(GV_RAID_AWAY, 1);
      set_sfall_global(GV_COMP_STAY, raid_companion_left);
      // Кейн убит, а герой его не обыскал: обыщет Рик и расскажет при следующем входе
      if (not get_sfall_global_int(GV_BOSS_NOTE) and boss_corpse) then set_sfall_global(GV_BOSS_NOTE, 2);
   end
   if (not car_out_of_fuel) then begin
      if (tile_contains_pid_obj(global_var(GVAR_CAR_PLACED_TILE), 0, PID_DRIVABLE_CAR) != 0) then begin
         set_global_var(GVAR_CAR_PLACED_TILE, 0);
         car_give_to_party;
      end
   end
end
