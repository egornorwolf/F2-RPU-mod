// Карта поселения «Лагерь у скал». М1: пустая карта, свет по времени суток и машина героя.
// М2 (тестовый режим): после координат караван Теда Бернса уже стоит в лагере.
// 0.5.0: лагерь на карте города (f2mset.map, f2mtlay.h). М3: палаточный лагерь (раньше f2mlay.h): костер, стол старосты, 3 палатки переселенцев и палатка героя
// с сундуком, старый заколоченный колодец, прораб Хэнк. Позже караван будет приходить через пару недель.
#define SCRIPT_REALNAME "f2mcamp"
#include "define.h"
#include "updatmap.h"
#include "command.h"
#include "scenepid.h"
#include "sfall.h"
#include "f2mod.h"
#include "f2mcv.h"
#include "f2mcamp.h"
#include "f2mtlay.h"
#include "f2mset.h"
#include "f2msync.h"


procedure start;
procedure map_enter_p_proc;
procedure map_update_p_proc;
procedure map_exit_p_proc;
procedure camp_layout;
procedure camp_people_put;


procedure start begin
end

procedure map_enter_p_proc begin
   variable old;
   set_map_exit_tiles(0, 0);
   Lighting;
   Check_Create_Car(LAY_CAR, 0)
   if (is_loading_game) then return;
   // Старый колодец починен: убираем спрятанный заколоченный (на его месте открытый)
   if (get_sfall_global_int(GV_WELL_OLD) == WELL_OLD_FIXED) then begin
      old := tile_contains_pid_obj(LAY_OLDWELL, 0, PID_WELL_OLD);
      if (old) then destroy_object(old);
   end
   if (get_sfall_global_int(GV_CARAVAN) != CARAVAN_DONE) then return;
   // Карта сохраняется: лагерь и люди ставятся один раз, при первом входе после координат.
   // Сохранения с прежней карты лагеря (173, до 0.5.0): все, что построено, и все, кто жив, — на новой карте.
   if (not get_sfall_global_int(GV_TOWN_LAYOUT)) then call camp_layout;
   if (not get_sfall_global_int(GV_TOWN_PEOPLE)) then call camp_people_put;
   // Ушедшие из лагеря исчезают, вернувшиеся снова у костра (f2mset.h, недельный тик)
   call camp_sync_people;
   set_sfall_global(GV_SET_SYNC, 0);
end

// Палаточный лагерь (1-й уровень зданий города, f2mtlay.h) и прораб Хэнк
// (с монтировкой: у его модели nmpeas есть анимации дубины)
procedure camp_layout begin
   variable who, i := 0;
   set_sfall_global(GV_TOWN_LAYOUT, 1);
   if (not get_sfall_global_int(GV_CAMP_LAYOUT)) then begin
      set_sfall_global(GV_CAMP_LAYOUT, 1);
      set_sfall_global(GV_CAMP_DAY, game_time / ONE_GAME_HOUR);
   end
   call lay_camp;
   while (i < BUILD_COUNT) do begin
      if (camp_built(i)) then call lay_slot(i);
      i += 1;
   end
   who := cv_put(PID_DOCK_WORKER, SCRIPT_F2MCFRM, LAY_FOREMAN);
   call cv_arm(who, PID_CROWBAR, 0);
end

// Караван у костра: Тед у стола, охрана у южной дороги, фургоны и брамины во дворе, переселенцы у костра.
// Дошли все, кто уцелел в пути (после координат без дороги — все); ушедших уберет camp_sync_people.
procedure camp_people_put begin
   set_sfall_global(GV_TOWN_PEOPLE, 1);
   set_sfall_global(GV_CAMP_CARAVAN, 1);
   call cv_ted(LAY_TED);
   call cv_guard(CV_SLOT_GUARD, LAY_CHIEF);
   call cv_guard(CV_SLOT_SARA, tile_num_in_direction(LAY_CHIEF, 2, 3));
   call cv_brahmin(CV_SLOT_BRAHMIN, tile_num_in_direction(LAY_WAGONS, 4, 4));
   call cv_brahmin(CV_SLOT_BRAHMIN + 1, tile_num_in_direction(LAY_WAGONS, 3, 4));
   call cv_wagons(LAY_WAGONS);
   call cv_civilians(LAY_FIRE, 0);
end

procedure map_update_p_proc begin
   Lighting;
end

procedure map_exit_p_proc begin
   if (not car_out_of_fuel) then begin
      if (tile_contains_pid_obj(global_var(GVAR_CAR_PLACED_TILE), 0, PID_DRIVABLE_CAR) != 0) then begin
         set_global_var(GVAR_CAR_PLACED_TILE, 0);
         car_give_to_party;
      end
   end
end
