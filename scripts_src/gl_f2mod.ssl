/*
   Мод поселения F2mod: главный глобальный скрипт.
   М0: пишет в окно сообщений, что мод загружен.
   М2: подменяет случайную встречу встречей с караваном «Хорошее место»;
       отмечает случайные (не прицельные) попадания героя и спутников по каравану;
       на дороге с караваном держит героя на карте мира у места встречи (движок после
       load_map на карту без города переносит героя в Арройо).
   М4: недельный тик поселения (f2mset.h): еда, вода, касса, дух, уход и возврат жителей.
   1.3: первый набег за кадром, пока героя нет в лагере; 1.3а: главарь у ворот через сутки после набега,
        если герой в лагере (иначе его поставит карта лагеря при следующем приходе).
*/

#include "sfall.h"
#include "define_extra.h"
#define SCRIPT_REALNAME "gl_f2mod"
#include "define.h"
#include "command.h"
#include "f2mod.h"
#include "scenepid.h"
#include "f2mcv.h"
#include "f2mcamp.h"
#include "f2mtlay.h"
#include "f2mset.h"
#include "f2msync.h"
#include "f2mpay.h"
#include "f2mraid.h"
#include "f2mspots.h"
#include "f2mlvl.h"
#include "f2msam.h"
#include "f2mlair.h"
#include "f2mlairl.h"
#include "f2mfarm.h"
#include "f2mwild.h"
#include "f2mspots.h"
#include "f2mthief.h"
#include "f2mremn.h"

#define F2MOD_VERSION "0.9.3"

procedure start;
procedure encounter_handler;
procedure combatdamage_handler;
procedure keep_escort_wm_pos;
procedure camp_fade_sync;
procedure raid_tick;
procedure boss_search;
procedure step_toward(variable a, variable b, variable s);
procedure sam_arrive;
procedure lair_cellar_look;

variable lair_hint;

procedure start begin
   variable st;
   if (game_loaded) then begin
      // Потолок статов героя F2MOD_STAT_MAX вместо 10 (sfall, не сохраняется — ставим при каждой загрузке)
      for (st := STAT_st; st <= STAT_lu; st++) set_pc_stat_max(st, F2MOD_STAT_MAX);
      register_hook_proc(HOOK_ENCOUNTER, encounter_handler);
      register_hook_proc(HOOK_COMBATDAMAGE, combatdamage_handler);
      set_global_script_repeat(60);
      display_msg("Мод поселения F2mod " + F2MOD_VERSION + " загружен.");
   end else begin
      call keep_escort_wm_pos;
      call set_tick_all;
      call bld_commit;   // стройки Хэнка (0.7.0): срок вышел — у здания новый уровень, на карту его ставят Хэнк или карта лагеря
      call camp_fade_sync;
      call raid_tick;
      call sam_tick;
      call sam_arrive;
      call lair_tick;
      call lair_cellar_look;
      call farm_tick;
      call wild_tick;
      call thief_tick;
   end
end

// Набег идет, пока герой где-то еще (на другой карте). Главарь приходит при герое в лагере:
// ждем, пока закрыты диалог, бой и окна, экран гаснет, Кейн у ворот.
procedure raid_tick begin
   if (cur_map_index != MAP_F2MOD_CAMP) then begin
      if (raid_due) then call raid_do;
      return;
   end
   call boss_search;
   if (not boss_due or combat_is_initialized or (get_game_mode bwand 0x3FFFFD) != 0) then return;
   gfade_out(1);
   call boss_put;
   gfade_in(1);
   display_msg("У южных ворот встал главарь налетчиков. Его люди ждут на краю карты.");
end

// Обыск тела Кейна (предмета-записки нет, Егор 2026-10-08): герой подошел к телу вплотную вне боя —
// строка в журнал и реплика героя над головой. Не обыскал и ушел — обыщет Рик (f2mcamp.ssl, map_exit)
procedure boss_search begin
   variable c;
   if (get_sfall_global_int(GV_BOSS_NOTE) or combat_is_initialized) then return;
   if (get_sfall_global_int(GV_BOSS) != BOSS_FIGHT and get_sfall_global_int(GV_BOSS) != BOSS_BEATEN) then return;
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (is_critter_dead(c) and obj_pid(c) == PID_RAIDER_MALE and (obj_art_fid(c) bwand 0xFFF) == GANG_ART_BOSS
          and tile_distance_objs(c, dude_obj) <= 1) then begin
         set_sfall_global(GV_BOSS_NOTE, 1);
         display_msg(message_str(SCRIPT_F2MBOSS, 250));
         float_msg(dude_obj, message_str(SCRIPT_F2MBOSS, 252), FLOAT_MSG_YELLOW);
         return;
      end
   end
end

// Логово (1.4): погреб под камнями замечает герой с Восприятием 7 (или знает от Кейна) рядом с ним
procedure lair_cellar_look begin
   if (cur_map_index != MAP_F2MOD_LAIR or lair_done or get_sfall_global_int(GV_LAIR_CELLAR) == 2) then return;
   if (tile_distance(tile_num(dude_obj), LAIR_CELLAR) > 4 or combat_is_initialized) then return;
   if (get_sfall_global_int(GV_LAIR_CELLAR) == 0) then begin
      if (get_critter_stat(dude_obj, STAT_pe) < LAIR_PE) then return;
      set_sfall_global(GV_LAIR_CELLAR, 1);
      call lair_cellar_face;   // камни в сторону: виден лаз с лестницей
      display_msg(lair_msg(223));
   end else if (get_sfall_global_int(GV_LAIR_CELLAR) == 1 and not lair_hint) then begin
      // подсказка над головой один раз за приход на карту
   end else return;
   lair_hint := 1;
   float_msg(dude_obj, lair_msg(224), FLOAT_MSG_YELLOW);
end

// Радист пришел, пока герой в лагере: ждем, пока закрыты окна и нет боя, экран гаснет, Сэм у старосты
procedure sam_arrive begin
   if (cur_map_index != MAP_F2MOD_CAMP or get_sfall_global_int(GV_SAM_NEWS) != 1) then return;
   if (combat_is_initialized or (get_game_mode bwand 0x3FFFFD) != 0) then return;
   set_sfall_global(GV_SAM_NEWS, 0);
   gfade_out(1);
   call sam_put;
   gfade_in(1);
   display_msg(message_str(SCRIPT_F2MRADIO, 304));
end

procedure step_toward(variable a, variable b, variable s) begin
   if (a < b) then begin
      if (a + s > b) then return b;
      return a + s;
   end
   if (a - s < b) then return b;
   return a - s;
end

// Герой в лагере, а люди ушли или вернулись: экран гаснет, на карте меняются люди, экран светлеет.
// Ждем, пока закрыты диалог, бой, инвентарь и прочие окна (все режимы, кроме самой карты).
procedure camp_fade_sync begin
   if (not get_sfall_global_int(GV_SET_SYNC) or cur_map_index != MAP_F2MOD_CAMP) then return;
   if ((get_game_mode bwand 0x3FFFFD) != 0) then return;
   set_sfall_global(GV_SET_SYNC, 0);
   gfade_out(1);
   call camp_sync_people;
   gfade_in(1);
end

// На картах дороги: точка встречи, сдвинутая к лагерю на ESCORT_WM_STEP за каждый участок
procedure keep_escort_wm_pos begin
   variable x, y, s;
   if (not is_escort_map(cur_map_index)) then return;
   x := get_sfall_global_int(GV_ESCORT_WMX);
   if (x <= 0) then return;
   y := get_sfall_global_int(GV_ESCORT_WMY);
   s := get_sfall_global_int(GV_ESCORT_STAGE) * ESCORT_WM_STEP;
   x := step_toward(x, CAMP_WM_X, s);
   y := step_toward(y, CAMP_WM_Y, s);
   if (get_world_map_x_pos != x or get_world_map_y_pos != y) then set_world_map_pos(x, y);
end

// Случайная встреча в пути: после 10 уровня, пока координаты не получены, вместо нее грузим караван.
// В тестовой версии караван ждет на каждой встрече, пока герой не возьмет координаты.
procedure encounter_handler begin
   variable event, map_id, special;
   event := get_sfall_arg;
   map_id := get_sfall_arg;
   special := get_sfall_arg;
   if (event != 0 or special) then return;
   // Остатки банды (1.4б): через 60 дней после взрыва погреба, один раз
   if (remn_due) then begin
      set_sfall_return(MAP_F2MOD_REMN);
      set_sfall_return(1);
      return;
   end
   if (get_pc_stat(PCSTAT_level) < CARAVAN_MIN_LEVEL) then return;
   if (get_sfall_global_int(GV_CARAVAN) != CARAVAN_NONE) then return;
   set_sfall_return(MAP_F2MOD_CARAVAN);
   set_sfall_return(1);
end

// Попадание по людям каравана: прицельное (цель атаки) или случайное (очередь, взрыв).
// Урон не меняем, только запоминаем; охранник в damage_p_proc решает, обидеться или нет.
procedure combatdamage_handler begin
   variable args, target, attacker, hits;
   args := get_sfall_args;
   target := args[0];
   attacker := args[1];
   if (not target or not attacker) then return;
   if (has_trait(TRAIT_OBJECT, target, OBJECT_TEAM_NUM) != TEAM_CARAVAN) then return;
   if (not is_dude_side(attacker)) then return;
   hits := load_array(ARR_CARAVAN_HITS);
   if (not hits) then begin
      hits := create_array_map;
      save_array(ARR_CARAVAN_HITS, hits);
   end
   // Прицельное = это и есть цель, которую выбрал герой. Ее движок хранит в C_ATTACK_MAIN_TARGET;
   // C_ATTACK_TARGET при промахе меняется на того, в кого пуля попала по пути (так брамин
   // получал «прицельный» выстрел, когда герой промахивался по врагу рядом с ним).
   hits[target] := (target != get_object_data(args[12], C_ATTACK_MAIN_TARGET));
end
