/*
   Мод поселения F2mod: главный глобальный скрипт.
   М0: пишет в окно сообщений, что мод загружен.
   М2: подменяет случайную встречу встречей с караваном «Хорошее место».
*/

#include "sfall.h"
#define SCRIPT_REALNAME "gl_f2mod"
#include "define.h"
#include "command.h"
#include "f2mod.h"

#define F2MOD_VERSION "0.2.0"

procedure start;
procedure encounter_handler;

procedure start begin
   if (game_loaded) then begin
      register_hook_proc(HOOK_ENCOUNTER, encounter_handler);
      display_msg("Мод поселения F2mod " + F2MOD_VERSION + " загружен.");
   end
end

// Случайная встреча в пути: после 10 уровня, пока координаты не получены, вместо неё грузим караван.
// В тестовой версии караван ждёт на каждой встрече, пока герой не возьмёт координаты.
procedure encounter_handler begin
   variable event, map_id, special;
   event := get_sfall_arg;
   map_id := get_sfall_arg;
   special := get_sfall_arg;
   if (event != 0 or special) then return;
   if (get_pc_stat(PCSTAT_level) < CARAVAN_MIN_LEVEL) then return;
   if (get_sfall_global_int(GV_CARAVAN) != CARAVAN_NONE) then return;
   set_sfall_global(GV_CARAVAN_HERE, 1);
   set_sfall_return(MAP_F2MOD_CARAVAN);
   set_sfall_return(1);
end
