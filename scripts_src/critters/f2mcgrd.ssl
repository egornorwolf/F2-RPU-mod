procedure critter_p_proc;
procedure combat_p_proc;
procedure damage_p_proc;
procedure accidental_hit;
procedure pickup_p_proc;
procedure talk_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;
procedure destroy_p_proc;
procedure Node001;
procedure Node002;
procedure Node003;
procedure Node004;
procedure Node005;
procedure Node010;
procedure Node011;
procedure Node012;
procedure Node013;
procedure Node020;
procedure Node021;
procedure Node022;
procedure Node023;
procedure Node024;
procedure Node025;
procedure Node026;
procedure Node027;
procedure Node030;
procedure Node031;
procedure armor_pay(variable who);
procedure armor_raiders;
procedure armor_count;
procedure militia_pay(variable who);
procedure militia_put(variable n);
procedure defense_text;
procedure Node999;

variable warned;
variable go_militia;
variable called;   // когда Рик в последний раз звал героя насчет базы (мс)

// База в карьере построена или улучшена, а бойцов туда Рик еще не прислал (0.9.9, Егор 2026-10-11)
#define GV_BASE_INVITE  "f2mbinvt"
// При людях Кейна (мир, f2mlairh = 2) база не пустая и наемников Рик не предлагает (Егор 2026-10-15, тест 0.9.10)
#define base_invite_due (get_sfall_global_int("f2mlairs") >= 2 and bld_level(U_BASE_UNIT) > get_sfall_global_int(GV_BASE_INVITE) \
                         and get_sfall_global_int("f2mlairh") != 2)

// Разведка (Егор 2026-10-15, тест 0.9.10): лагерь стоит сутки, набега еще не было, а герой сидит в лагере. Рик зовет его
// пройтись по окрестностям: повод уйти, без которого набег не начнется (он ждет, пока героя нет). Награда при возвращении (f2mcamp.ssl)
#define scout_due       (is_chief and not get_sfall_global_int(GV_RAID) and not get_sfall_global_int(GV_SCOUT) \
                         and get_sfall_global_int(GV_CARAVAN) == CARAVAN_DONE and set_founded and game_time / ONE_GAME_HOUR - get_sfall_global_int(GV_CAMP_DAY) >= RAID_HOURS)

// Повторный налет отбит (Егор 2026-10-15): Рик говорит, что пора искать логово, раз за каждый налет
#define raid2_talk_due  (get_sfall_global_int("f2mraid2") == 2 and get_sfall_global_int("f2mlairs") < 2 \
                         and get_sfall_global_int("f2mr2tld") < get_sfall_global_int("f2mr2num"))

// Боевая броня всей охране (Егор 2026-10-15): после стройки базы, если на базе есть свои — люди Кейна после мира
// или наемники Рика (или бывшие налетчики у поста). Цена одна за всех: 8000 (Егор, тест 0.9.10). Денег не хватает — пункт остается
#define GV_ARMOR_TOLD   "f2marmtd"
#define armor_due       (bld_level(U_BASE_UNIT) >= 1 and not armor_bought and (armor_raiders or get_sfall_global_int(GV_BASE_INVITE) >= 1))
#define armor_total     (ARMOR_TOTAL)
variable go_armor;

// Сколько ополченцев можно нанять: четверо, но не больше свободных мест у поста (там уже могут жить бывшие налетчики, 1.4б)
#define hire_n          ((milit_free < MILITIA_COUNT) * milit_free + (milit_free >= MILITIA_COUNT) * MILITIA_COUNT)
#define hire_price      (MILITIA_PRICE * hire_n / MILITIA_COUNT)
#define can_hire        (not get_sfall_global_int(GV_MIL_HIRED) and milit_free > 0)

// Ополчение (1.3): трое наемников (Mercenary, модель hmlthr) и наемница (Nomad, hflthr) — модели героя, анимации всего оружия

procedure start begin
end

#define in_camp     (cur_map_index == MAP_F2MOD_CAMP)
#define is_rick     (obj_pid(self_obj) == PID_GUN_GUARD_MALE)
// Начальник охраны в лагере: Рик, а если он погиб в пути — Сара
#define is_chief    (in_camp and (is_rick or cv_is_dead(CV_SLOT_GUARD)))

procedure look_at_p_proc begin
   script_overrides;
   if (not in_camp) then
      display_msg(mstr(100));
   else if (is_chief and is_rick) then
      display_msg(mstr(160));
   else if (is_chief) then
      display_msg(mstr(161));
   else
      display_msg(mstr(162));
end

procedure description_p_proc begin
   script_overrides;
   display_msg(mstr(101));
end

procedure critter_p_proc begin
   if (get_sfall_global_int(GV_CARAVAN_HOSTILE)) then begin
      attack(dude_obj);
      return;
   end
   if (not combat_is_initialized) then begin
      if (cv_fight) then return;
   end
   // Зовет героя, как другие с делом: разведка или база ждет бойцов
   if (scout_due and not combat_is_initialized and not get_sfall_global_int(GV_BURY_ON) and tile_distance_objs(self_obj, dude_obj) <= 15
       and self_can_see_dude and (not called or get_uptime >= called + 20000 or get_uptime < called)) then begin
      called := get_uptime;
      floater(260);
   end
   if (is_chief and base_invite_due and not combat_is_initialized and not get_sfall_global_int(GV_BURY_ON) and tile_distance_objs(self_obj, dude_obj) <= 15
       and self_can_see_dude and (not called or get_uptime >= called + 20000 or get_uptime < called)) then begin
      called := get_uptime;
      floater(196);
   end
   if (not warned and not in_camp and self_can_see_dude and not get_sfall_global_int(GV_BURY_ON) and tile_distance_objs(self_obj, dude_obj) < 6) then begin
      if (greet_turn) then begin
         warned := 1;
         floater(random(102, 104));
      end
   end
end

// На дороге охрана и караванщик стреляют по налетчикам и зверям сами
procedure combat_p_proc begin
   if (fixed_param == COMBAT_SUBTYPE_TURN or fixed_param == COMBAT_SUBTYPE_NONCOM_TURN) then
      call cv_fight;
end

procedure talk_p_proc begin
   if (get_sfall_global_int(GV_CARAVAN_HOSTILE) or not in_camp) then begin
      floater(random(110, 113));
      return;
   end
   // штраф за стрельбу по своим берет Тед, без Теда — начальник охраны (f2mfine.h)
   if (fine_due and (not is_chief or fine_ted_here)) then begin
      float_msg(self_obj, FINE_MSG(487 + not fine_ted_here), FLOAT_MSG_NORMAL);
      return;
   end
   if (not is_chief) then begin
      if (get_sfall_global_int("f2mraid2") == 2 and get_sfall_global_int("f2mlairs") < 2) then floater(greet_pick(220, 3));
      else floater(greet_pick(170, 6));
      return;
   end
   start_gdialog(NAME, self_obj, 4, -1, -1);
   gSay_Start;
      if (fine_due) then
         call fine_node;
      else if (get_sfall_global_int(GV_RAID) and not (get_sfall_global_int(GV_RAID_TOLD) bwand 2)) then
         call Node003;
      else if (raid2_talk_due) then
         call Node022;
      else if (scout_due) then
         call Node030;
      else if (base_invite_due) then
         call Node020;
      else if (armor_due and not get_sfall_global_int(GV_ARMOR_TOLD)) then
         call Node024;
      else
         call Node001;
   gSay_End;
   end_dialogue;
   // Ополчение приходит к вечеру: экран гаснет, 6 часов, четверо у южных ворот
   if (go_militia) then begin
      gfade_out(1);
      game_time_advance(6 * ONE_GAME_HOUR);
      call militia_put(go_militia);
      gfade_in(1);
      if (go_militia == MILITIA_COUNT) then display_msg(mstr(188));
      else display_msg(mstr(194) + go_militia + mstr(195));
      go_militia := 0;
   end
   if (go_armor) then begin
      call armor_dress_camp;
      if (go_armor == 1) then display_msg(mstr(246));
      else display_msg(mstr(250));
      go_armor := 0;
   end
end

procedure militia_put(variable n) begin
   variable i := 0, obj;
   set_sfall_global(GV_MIL_HIRED, 1);
   set_sfall_global(GV_SET_MILIT, get_sfall_global_int(GV_SET_MILIT) + n);   // к бойцам из остатков банды (1.4б), если они уже пришли
   while (i < n) do begin
      if (i == MILITIA_COUNT - 1) then
         obj := cv_put(PID_MILITIA_FEMALE, SCRIPT_F2MCMIL, tile_num_in_direction(RAID_GATE_IN, i, 2));
      else
         obj := cv_put(PID_MILITIA_MALE, SCRIPT_F2MCMIL, tile_num_in_direction(RAID_GATE_IN, i, 2));
      if (i == 0) then
         call cv_arm(obj, PID_HUNTING_RIFLE, PID_223_FMJ);
      else
         call cv_arm(obj, PID_10MM_PISTOL, PID_10MM_JHP);
      call cv_stims(obj, 2);
      anim(obj, ANIMATE_ROTATION, 2);
      i += 1;
   end
end

// Начальник охраны лагеря
// Представляется один раз (0.9.9, Егор: Рик каждый раз рассказывал про себя и Сару)
#define GV_CHIEF_MET    "f2mchmet"
procedure Node001 begin
   if (get_sfall_global_int(GV_CHIEF_MET)) then
      Reply(137 + random(0, 2));
   else if (not is_rick) then
      Reply(132);
   else if (cv_is_dead(CV_SLOT_SARA)) then
      Reply(131);
   else
      Reply(130);
   set_sfall_global(GV_CHIEF_MET, 1);
   NOption(133, Node002, 4);
   if (can_hire) then NOption(136, Node010, 4);
   if (armor_due) then NOption(247, Node024, 4);
   NOption(134, Node999, 4);
   NLowOption(135, Node999);
end

// База в карьере готова: прислать туда бойцов
procedure Node020 begin
   if (get_sfall_global_int(GV_BASE_INVITE)) then Reply(198);
   else Reply(197);
   NOption(199, Node021, 4);
   NOption(201, Node001, 4);
   NLowOption(202, Node021);
end

procedure Node021 begin
   // первый раз с бойцами идут командир базы и наемник в погреб, а троих Рик оставляет в охране лагеря (f2mlair.ssl, f2mcell.ssl, f2mpost.h)
   if (get_sfall_global_int(GV_BASE_INVITE)) then Reply(200);
   else Reply(203);
   set_sfall_global(GV_BASE_INVITE, bld_level(U_BASE_UNIT));
   NOption(141, Node999, 4);
   NLowOption(135, Node999);
end

// После повторного налета: в следующий раз их будет больше, не отобьемся — надо брать логово
procedure Node022 begin
   variable t;
   set_sfall_global("f2mr2tld", get_sfall_global_int("f2mr2num"));
   if (get_sfall_global_int("f2mr2num") >= 2) then t := mstr(211);
   else t := mstr(210);
   if (get_sfall_global_int("f2mlairs") >= 1) then t := t + " " + mstr(212);
   else t := t + " " + mstr(213);
   Reply(t);
   NOption(214, Node023, 4);
   if (can_hire) then NOption(151, Node010, 4);
   NOption(215, Node023, 4);
   NLowOption(135, Node999);
end

procedure Node023 begin
   Reply(216);
   NOption(141, Node001, 4);
   NOption(134, Node999, 4);
   NLowOption(135, Node999);
end

// Обновки: боевая броня на каждого бойца, цена из меню снаряжения (guards.md, 3), платит герой, касса или вскладчину
procedure Node024 begin
   variable c, p;
   set_sfall_global(GV_ARMOR_TOLD, 1);
   p := armor_total;
   c := pay_cash_now;
   // про «горе-налетчиков» — только если они у нас есть (Егор, тест 0.9.10: на базе были наемники)
   if (armor_raiders) then Reply(mstr(240) + " " + mstr(241) + armor_count + mstr(242) + p + mstr(244));
   else Reply(mstr(248) + " " + mstr(241) + armor_count + mstr(242) + p + mstr(244));
   if (can_pay_hero(p)) then NOption(mstr(193) + p + mstr(189), Node025, 4);
   if (can_pay_cash(p)) then NOption(mstr(182) + c + mstr(185), Node026, 4);
   if (can_pay_split(p)) then NOption(mstr(183) + c + mstr(184) + (p - c) + mstr(189), Node027, 4);
   NOption(186, Node001, 4);
   NLowOption(135, Node999);
end

procedure armor_pay(variable who) begin
   call pay_do(armor_total, who);
   set_sfall_global(GV_BASE_ARMOR, 1);
   go_armor := 1 + (not armor_raiders);
   if (armor_raiders) then Reply(245);
   else Reply(249);
   NOption(141, Node999, 4);
   NLowOption(135, Node999);
end

procedure Node025 begin
   call armor_pay(PAY_HERO);
end

procedure Node026 begin
   call armor_pay(PAY_CASH);
end

procedure Node027 begin
   call armor_pay(PAY_SPLIT);
end

// Разведка окрестностей перед набегом
procedure Node030 begin
   Reply(261);
   NOption(262, Node031, 4);
   NOption(263, Node001, 4);
   NLowOption(265, Node031);
end

procedure Node031 begin
   set_sfall_global(GV_SCOUT, 1);
   Reply(264);
   NOption(141, Node999, 4);
   NLowOption(135, Node999);
end

// Бывшие налетчики у нас: люди Кейна после мира (гарнизон карьера) или остатки банды у поста (модели дикарей)
procedure armor_raiders begin
   variable c, a;
   if (get_sfall_global_int("f2mlairh") == 2) then return 1;
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      a := obj_art_fid(c) bwand 0xFFF;
      if (armor_is_guard(c) and not is_critter_dead(c) and (a == (FID_NMWARR bwand 0xFFF) or a == (FID_NMPRMB bwand 0xFFF))) then return 1;
   end
   return 0;
end

// Сколько бойцов одевать: охрана лагеря, гарнизон базы (по последнему приходу или по местам) и наемник в погребе
procedure armor_count begin
   variable c, n := 0, lv, b;
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (armor_is_guard(c) and not is_critter_dead(c) and not obj_in_party(c)) then n += 1;
   end
   lv := bld_level(U_BASE_UNIT);
   if (lv > get_sfall_global_int(GV_BASE_INVITE)) then lv := get_sfall_global_int(GV_BASE_INVITE);
   b := (lv >= 1) * (4 + 2 * lv);
   if (get_sfall_global_int("f2mbgarr") > b) then b := get_sfall_global_int("f2mbgarr");
   return n + b + get_sfall_global_int("f2mcmerc");
end

// Как с обороной: что уже есть, и подсказка про ополчение и спутника
procedure defense_text begin
   variable t, f, m;
   f := get_sfall_global_int(GV_FENCE);
   m := get_sfall_global_int(GV_SET_MILIT);
   if (not f and not m) then begin
      if (get_sfall_global_int(GV_RAID)) then t := mstr(147);   // налетчики уже нашли лагерь (причина и следствие, 2026-10-15)
      else if (cv_is_dead(CV_SLOT_GUARD) or cv_is_dead(CV_SLOT_SARA)) then t := mstr(142);
      else t := mstr(140);
   end else if (f and m) then
      t := mstr(145);
   else if (f) then
      t := mstr(143);
   else
      t := mstr(144);
   if (can_hire) then t := t + " " + mstr(146);
   return t;
end

procedure Node002 begin
   Reply(defense_text);
   if (can_hire) then NOption(136, Node010, 4);
   NOption(141, Node001, 4);
   NOption(134, Node999, 4);
   NLowOption(135, Node999);
end

// После набега (1.3)
procedure Node003 begin
   variable f, m;
   set_sfall_global(GV_RAID_TOLD, get_sfall_global_int(GV_RAID_TOLD) bwor 2);
   f := get_sfall_global_int(GV_FENCE);
   m := get_sfall_global_int(GV_MIL_HIRED) or get_sfall_global_int(GV_RAID_OUT) == RAID_OUT_GUARD;
   // что говорит Рик, зависит от того, что в лагере уже есть: ни забора, ни охраны — винит себя;
   // есть и то и другое — про усиление: больше людей, учить их и вооружить
   if (f and m) then Reply(157);
   else if (m) then Reply(156);
   else if (f) then Reply(158);
   else Reply(150);
   if (can_hire) then NOption(151, Node010, 4);
   if (not get_sfall_global_int(GV_FENCE)) then NOption(152, Node004, 4);
   NOption(154, Node005, 4);
   NLowOption(135, Node999);
end

procedure Node004 begin
   Reply(153);
   NOption(141, Node001, 4);
   NOption(134, Node999, 4);
   NLowOption(135, Node999);
end

procedure Node005 begin
   Reply(155);
   NOption(141, Node001, 4);
   NOption(134, Node999, 4);
   NLowOption(135, Node999);
end

// Ополчение: кто платит — герой, касса или вскладчину
procedure Node010 begin
   variable c;
   c := pay_cash_now;
   if (hire_n == MILITIA_COUNT) then begin
      Reply(180);
      if (can_pay_hero(hire_price)) then NOption(181, Node011, 4);
   end else begin
      Reply(mstr(190) + hire_n + mstr(191) + hire_price + mstr(192));
      if (can_pay_hero(hire_price)) then NOption(mstr(193) + hire_price + mstr(189), Node011, 4);
   end
   if (can_pay_cash(hire_price)) then NOption(mstr(182) + c + mstr(185), Node012, 4);
   if (can_pay_split(hire_price)) then NOption(mstr(183) + c + mstr(184) + (hire_price - c) + mstr(189), Node013, 4);
   NOption(186, Node001, 4);
   NLowOption(135, Node999);
end

procedure militia_pay(variable who) begin
   go_militia := hire_n;
   call pay_do(hire_price, who);
   Reply(187);
   NOption(141, Node999, 4);
   NLowOption(135, Node999);
end

procedure Node011 begin
   call militia_pay(PAY_HERO);
end

procedure Node012 begin
   call militia_pay(PAY_CASH);
end

procedure Node013 begin
   call militia_pay(PAY_SPLIT);
end

procedure Node999 begin
end


// Свой попал случайно (очередью или взрывом) — прощаем и ругаемся; прицельно — бой
procedure accidental_hit begin
   variable hits, r := 0;
   hits := load_array(ARR_CARAVAN_HITS);
   if (hits) then begin
      r := hits[self_obj];
      hits[self_obj] := 0;
   end
   return r;
end

procedure damage_p_proc begin
   if (is_dude_side(source_obj)) then begin
      if (accidental_hit) then
         floater(random(120, 120 + 2));
      else begin
         camp_fine_wound;
         set_sfall_global(GV_CARAVAN_HOSTILE, 1);
         attack(dude_obj);
      end
   end else
      attack(source_obj);
end

procedure pickup_p_proc begin
   attack(source_obj);
end

// Охранник погиб от руки героя или спутника, пусть даже случайно: караван воюет.
// На следующем участке дороги погибшего уже нет.
procedure destroy_p_proc begin
   if (get_sfall_global_int(GV_SET_LEAVING)) then return;   // лагерь убирает лишнего или ушедшего: это не смерть
   if (is_dude_side(source_obj)) then begin
      camp_fine_add(CAMP_FINE_KILL);
      set_sfall_global(GV_CARAVAN_HOSTILE, 1);
   end
   call cv_mark_dead(obj_pid(self_obj));
end
