// Охранник каравана «Хорошее место». Случайное попадание героя или спутника прощает и ругается;
// прицельный выстрел или смерть охранника от их руки — весь караван воюет с героем.
// В лагере у скал охранник Рик — начальник охраны (если погиб в пути, начальник — Сара).
// 1.3: нанимает ополчение (четверо наемников у южных ворот, 500; платит герой, касса или вскладчину),
// после набега: «Я не снимаю вины с себя».
#define SCRIPT_REALNAME "f2mcgrd"
#include "define.h"
#include "f2mod.h"
#define NAME                    SCRIPT_F2MCGRD
#include "command.h"
#include "sfall.h"
#include "define_extra.h"
#include "f2mcfgt.h"
#include "scenepid.h"
#include "f2mcv.h"
#include "f2mcamp.h"
#include "f2mset.h"
#include "f2mpay.h"
#include "f2mfine.h"
#include "f2mgreet.h"
#include "f2marmr.h"

