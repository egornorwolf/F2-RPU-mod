// Охранник каравана «Хорошее место». Случайное попадание героя или спутника прощает и ругается;
// прицельный выстрел или смерть охранника от их руки — весь караван воюет с героем.
// В лагере у скал охранник Рик — начальник охраны (если погиб в пути, начальник — Сара).
#define SCRIPT_REALNAME "f2mcgrd"
#include "define.h"
#include "f2mod.h"
#define NAME                    SCRIPT_F2MCGRD
#include "command.h"
#include "sfall.h"
#include "define_extra.h"
#include "f2mcfgt.h"
#include "f2mcdead.h"

procedure start;
procedure critter_p_proc;
procedure combat_p_proc;
procedure damage_p_proc;
procedure accidental_hit;
procedure pickup_p_proc;
procedure talk_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;
procedure destroy_p_proc;
procedure Node001;
procedure Node002;
procedure Node999;

variable warned;

procedure start begin
end

#define in_camp     (cur_map_index == MAP_F2MOD_CAMP)
#define is_rick     (obj_pid(self_obj) == PID_GUN_GUARD_MALE)
// Начальник охраны в лагере: Рик, а если он погиб в пути — Сара
#define is_chief    (in_camp and (is_rick or cv_is_dead(CV_SLOT_GUARD)))

procedure look_at_p_proc begin
   script_overrides;
   if (not in_camp) then
      display_msg(mstr(100));
   else if (is_chief and is_rick) then
      display_msg(mstr(160));
   else if (is_chief) then
      display_msg(mstr(161));
   else
      display_msg(mstr(162));
end

procedure description_p_proc begin
   script_overrides;
   display_msg(mstr(101));
end

procedure critter_p_proc begin
   if (get_sfall_global_int(GV_CARAVAN_HOSTILE)) then begin
      attack(dude_obj);
      return;
   end
   if (not combat_is_initialized) then begin
      if (cv_fight) then return;
   end
   if (not warned and not in_camp and self_can_see_dude and tile_distance_objs(self_obj, dude_obj) < 6) then begin
      warned := 1;
      floater(random(102, 104));
   end
end

// На дороге охрана и караванщик стреляют по налетчикам и зверям сами
procedure combat_p_proc begin
   if (fixed_param == COMBAT_SUBTYPE_TURN or fixed_param == COMBAT_SUBTYPE_NONCOM_TURN) then
      call cv_fight;
end

procedure talk_p_proc begin
   if (get_sfall_global_int(GV_CARAVAN_HOSTILE) or not in_camp) then begin
      floater(random(110, 113));
      return;
   end
   if (not is_chief) then begin
      floater(random(170, 172));
      return;
   end
   start_gdialog(NAME, self_obj, 4, -1, -1);
   gSay_Start;
      call Node001;
   gSay_End;
   end_dialogue;
end

// Начальник охраны лагеря
procedure Node001 begin
   if (not is_rick) then
      Reply(132);
   else if (cv_is_dead(CV_SLOT_SARA)) then
      Reply(131);
   else
      Reply(130);
   NOption(133, Node002, 4);
   NOption(134, Node999, 4);
   NLowOption(135, Node999);
end

procedure Node002 begin
   if (cv_is_dead(CV_SLOT_GUARD) or cv_is_dead(CV_SLOT_SARA)) then
      Reply(142);
   else
      Reply(140);
   NOption(141, Node001, 4);
   NOption(134, Node999, 4);
   NLowOption(135, Node999);
end

procedure Node999 begin
end


// Свой попал случайно (очередью или взрывом) — прощаем и ругаемся; прицельно — бой
procedure accidental_hit begin
   variable hits, r := 0;
   hits := load_array(ARR_CARAVAN_HITS);
   if (hits) then begin
      r := hits[self_obj];
      hits[self_obj] := 0;
   end
   return r;
end

procedure damage_p_proc begin
   if (is_dude_side(source_obj)) then begin
      if (accidental_hit) then
         floater(random(120, 120 + 2));
      else begin
         set_sfall_global(GV_CARAVAN_HOSTILE, 1);
         attack(dude_obj);
      end
   end else
      attack(source_obj);
end

procedure pickup_p_proc begin
   attack(source_obj);
end

// Охранник погиб от руки героя или спутника, пусть даже случайно: караван воюет.
// На следующем участке дороги погибшего уже нет.
procedure destroy_p_proc begin
   if (is_dude_side(source_obj)) then set_sfall_global(GV_CARAVAN_HOSTILE, 1);
   call cv_mark_dead(obj_pid(self_obj));
end
