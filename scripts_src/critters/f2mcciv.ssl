// Мирный переселенец каравана «Хорошее место»: мужчина, женщина или ребенок. Оружия нет, в бою убегает.
// Случайное попадание героя или спутника прощает; прицельный выстрел или смерть от их руки — караван воюет.
#define SCRIPT_REALNAME "f2mcciv"
#include "define.h"
#include "f2mod.h"
#define NAME                    SCRIPT_F2MCCIV
#include "command.h"
#include "sfall.h"
#include "define_extra.h"
#include "f2mcdead.h"
#include "f2mcamp.h"
#include "f2mgreet.h"

procedure start;
procedure critter_p_proc;
procedure damage_p_proc;
procedure accidental_hit;
procedure talk_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;
procedure destroy_p_proc;
procedure is_child;
procedure use_stim;
procedure bar_stock;
procedure med_stock;
procedure trade_talk(variable node);
procedure Node020;
procedure Node010;
procedure Node011;
procedure Node999;

variable greeted;

// LVAR 0: 1 = свой стим уже вколот (хранится в сохранении)
#define LVAR_STIM_USED   (0)

procedure start begin
end

procedure is_child begin
   return (obj_pid(self_obj) == PID_CHILD_MALE or obj_pid(self_obj) == PID_CHILD_FEMALE);
end

procedure look_at_p_proc begin
   script_overrides;
   if (is_child) then
      display_msg(mstr(102));
   else if (get_critter_stat(self_obj, STAT_gender) == GENDER_FEMALE) then
      display_msg(mstr(101));
   else
      display_msg(mstr(100));
end

procedure description_p_proc begin
   script_overrides;
   if (is_child) then
      display_msg(mstr(104));
   else
      display_msg(mstr(103));
end

procedure critter_p_proc begin
   variable k;
   if (not greeted and not combat_is_initialized and self_can_see_dude and not get_sfall_global_int(GV_BURY_ON)
       and tile_distance_objs(self_obj, dude_obj) < 5 and random(0, 3) == 0) then begin
      if (not greet_turn) then return;   // только что говорил другой: по очереди, не хором
      greeted := 1;
      if (cur_map_index == MAP_F2MOD_CAMP and not is_child) then
         floater(greet_pick(200, 10));
      else if (cur_map_index == MAP_F2MOD_CAMP) then begin
         // дети: 140-142 и 146-149
         k := greet_pick(0, 7);
         if (k < 3) then floater(140 + k);
         else floater(143 + k);
      end else if (is_child) then
         floater(random(140, 142));
      else
         floater(random(143, 145));
   end
end

procedure talk_p_proc begin
   variable it, k;
   // хозяйка медальона у дома героя (2.6, Егор 2026-10-11): медальон у героя — отдать, нет — просит найти вора
   if (cur_map_index == MAP_F2MOD_CAMP and thief_victim_on and not get_sfall_global_int(GV_CARAVAN_HOSTILE)
       and tile_distance(tile_num(self_obj), THIEF_VICTIM_SPOT) <= 1 and not is_child) then begin
      it := obj_carrying_pid_obj(dude_obj, PID_GOLD_LOCKET);
      if (it) then begin
         rm_obj_from_inven(dude_obj, it);
         destroy_object(it);
         set_sfall_global(GV_LOCKET_BACK, 1);
         floater(301);
         // конец квеста 2.6 (Егор 2026-10-15: раньше не давал ничего): 300 опыта и дух +5 навсегда (как за похороны:
         // постоянная прибавка f2msmbon, и сразу в текущий дух f2msmorl; имена GV — f2mset.h)
         give_exp_points(300);
         set_sfall_global("f2msmbon", get_sfall_global_int("f2msmbon") + 5);
         set_sfall_global("f2msmorl", get_sfall_global_int("f2msmorl") + 5);
         if (get_sfall_global_int("f2msmorl") > 50) then set_sfall_global("f2msmorl", 50);
         display_msg(mstr(302) + 300 + mstr(303));
      end else
         floater(300);
      return;
   end
   // работник бара за стойкой (до Ноя): торгует выпивкой
   if (cur_map_index == MAP_F2MOD_CAMP and get_sfall_global_int(GV_BAR_TEND) and not get_sfall_global_int(GV_NOAH_HERE)
       and not get_sfall_global_int(GV_CARAVAN_HOSTILE) and not is_child
       and tile_distance(tile_num(self_obj), get_sfall_global_int(GV_BAR_TEND)) <= 1) then begin
      call bar_stock;
      call trade_talk(10);
      return;
   end
   // временный доктор у стола медпункта (Егор 2026-10-15): продает порошки, стимпаки и противоядия
   if (cur_map_index == MAP_F2MOD_CAMP and get_sfall_global_int(GV_MED_TEND)
       and not get_sfall_global_int(GV_CARAVAN_HOSTILE) and not is_child
       and tile_distance(tile_num(self_obj), get_sfall_global_int(GV_MED_TEND)) <= 1) then begin
      call med_stock;
      call trade_talk(20);
      return;
   end
   if (get_sfall_global_int(GV_CARAVAN_HOSTILE)) then
      floater(random(150, 152));
   else if (is_child) then
      floater(random(120, 123));
   else if (cur_map_index != MAP_F2MOD_CAMP) then
      floater(random(110, 114));
   else if (not camp_has_water) then
      floater(random(180, 182));
   else
      floater(greet_pick(183, 6));
end

// Свой попал случайно (очередью или взрывом) — прощаем; прицельно — бой
procedure accidental_hit begin
   variable hits, r := 0;
   hits := load_array(ARR_CARAVAN_HITS);
   if (hits) then begin
      r := hits[self_obj];
      hits[self_obj] := 0;
   end
   return r;
end

// У каждого мирного один стим. Самим предметом в инвентаре его не даем: ИИ трусливых
// жителей колет стимы сразу в начале боя, даже без ран (проверено в игре, 0.2.4).
// Поэтому стим «в кармане» считаем по LVAR: колем по скрипту, когда здоровья меньше половины,
// а если мирный погиб, так и не вколов его, стим остается на трупе.
procedure use_stim begin
   if (is_critter_dead(self_obj) or local_var(LVAR_STIM_USED)) then return;
   if (get_critter_stat(self_obj, STAT_current_hp) * 2 >= get_critter_stat(self_obj, STAT_max_hp)) then return;
   set_local_var(LVAR_STIM_USED, 1);
   critter_heal(self_obj, random(10, 20));
   floater(random(160, 161));
end

procedure damage_p_proc begin
   call use_stim;
   if (is_dude_side(source_obj)) then begin
      if (accidental_hit) then
         floater(random(130, 132));
      else begin
         camp_fine_wound;
         set_sfall_global(GV_CARAVAN_HOSTILE, 1);
         floater(random(150, 152));
      end
   end
end

// Погиб от руки героя или спутника, пусть даже случайно: караван воюет.
// На следующем участке дороги погибшего уже нет.
procedure destroy_p_proc begin
   if (get_sfall_global_int(GV_SET_LEAVING)) then return;   // лагерь убирает лишнего или ушедшего: это не смерть
   if (is_dude_side(source_obj)) then begin
      camp_fine_add(CAMP_FINE_KILL);
      set_sfall_global(GV_CARAVAN_HOSTILE, 1);
   end
   call cv_mark_dead(obj_pid(self_obj));
   if (not local_var(LVAR_STIM_USED)) then begin
      set_local_var(LVAR_STIM_USED, 1);
      add_obj_to_inven(self_obj, create_object(PID_STIMPAK, 0, 0));
   end
end

// Бар до Ноя (Егор 2026-10-15): раз в неделю завоз выпивки тому, кто стоит за стойкой. Товар лежит у работника
// (как у торговцев игры), крышки на сдачу — до 50
#define BAR_BEER    (6)
#define BAR_BOOZE   (3)
#define BAR_GAMMA   (1)
#define BAR_CAPS    (50)
// Торговля жителя (бар или медпункт): движок дает торговать только существу с флагом «бартер» в прототипе,
// у жителей его нет — включаем на время разговора
procedure trade_talk(variable node) begin
   variable k;
   k := get_proto_data(obj_pid(self_obj), PROTO_CR_FLAGS);
   set_proto_data(obj_pid(self_obj), PROTO_CR_FLAGS, k bwor CFLG_BARTER);
   start_gdialog(NAME, self_obj, 4, -1, -1);
   gSay_Start;
      if (node == 20) then call Node020;
      else call Node010;
   gSay_End;
   end_dialogue;
   set_proto_data(obj_pid(self_obj), PROTO_CR_FLAGS, k);
end

// Завоз раз в неделю или новому работнику (роль закреплена, но работник мог погибнуть): товар лежит у того, кто за стойкой
procedure bar_stock begin
   variable n, id;
   id := f2m_obj_id(self_obj);
   if (get_sfall_global_int(GV_BAR_WEEK) == game_time / ONE_GAME_WEEK + 1 and get_sfall_global_int(GV_BAR_WHO) == id) then return;
   set_sfall_global(GV_BAR_WEEK, game_time / ONE_GAME_WEEK + 1);
   set_sfall_global(GV_BAR_WHO, id);
   n := obj_is_carrying_obj_pid(self_obj, PID_BEER);
   if (n < BAR_BEER) then add_mult_objs_to_inven(self_obj, create_object(PID_BEER, 0, 0), BAR_BEER - n);
   n := obj_is_carrying_obj_pid(self_obj, PID_BOOZE);
   if (n < BAR_BOOZE) then add_mult_objs_to_inven(self_obj, create_object(PID_BOOZE, 0, 0), BAR_BOOZE - n);
   n := obj_is_carrying_obj_pid(self_obj, PID_GAMMA_GULP_BEER);
   if (n < BAR_GAMMA) then add_mult_objs_to_inven(self_obj, create_object(PID_GAMMA_GULP_BEER, 0, 0), BAR_GAMMA - n);
   n := item_caps_total(self_obj);
   if (n < BAR_CAPS) then item_caps_adjust(self_obj, BAR_CAPS - n);
end

// Лекарства временного доктора: порошки (Healing Powder), стимпаки, противоядия (Antidote), крышки на сдачу до 50
#define MED_POWDER  (4)
#define MED_STIM    (2)
#define MED_ANTI    (2)
procedure med_stock begin
   variable n, id;
   id := f2m_obj_id(self_obj);
   if (get_sfall_global_int(GV_MED_WEEK) == game_time / ONE_GAME_WEEK + 1 and get_sfall_global_int(GV_MED_WHO) == id) then return;
   set_sfall_global(GV_MED_WEEK, game_time / ONE_GAME_WEEK + 1);
   set_sfall_global(GV_MED_WHO, id);
   n := obj_is_carrying_obj_pid(self_obj, PID_HEALING_POWDER);
   if (n < MED_POWDER) then add_mult_objs_to_inven(self_obj, create_object(PID_HEALING_POWDER, 0, 0), MED_POWDER - n);
   // свой стим жителя (LVAR_STIM_USED) не трогаем: стимпаки на продажу сверх него
   n := obj_is_carrying_obj_pid(self_obj, PID_STIMPAK);
   if (n < MED_STIM) then add_mult_objs_to_inven(self_obj, create_object(PID_STIMPAK, 0, 0), MED_STIM - n);
   n := obj_is_carrying_obj_pid(self_obj, PID_ANTIDOTE);
   if (n < MED_ANTI) then add_mult_objs_to_inven(self_obj, create_object(PID_ANTIDOTE, 0, 0), MED_ANTI - n);
   n := item_caps_total(self_obj);
   if (n < BAR_CAPS) then item_caps_adjust(self_obj, BAR_CAPS - n);
end

procedure Node020 begin
   Reply(random(320, 322));
   NOption(323, Node011, 4);
   NOption(314, Node999, 4);
   NLowOption(324, Node011);
end

procedure Node010 begin
   Reply(random(310, 312));
   NOption(313, Node011, 4);
   NOption(314, Node999, 4);
   NLowOption(315, Node011);
end

procedure Node011 begin
   gdialog_mod_barter(0);
   Reply(316);
   NOption(314, Node999, 4);
   NLowOption(314, Node999);
end

procedure Node999 begin
end
