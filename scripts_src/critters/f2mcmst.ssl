// Караванщик Тед Бернс: встреча «Хорошее место».
// Первый вариант — проводить караван за 300 (три нападения в пути), второй — просто узнать,
// где место: за 500 крышек или бесплатно (Красноречие 75% или Привлекательность 7).
// После третьего нападения караван с героем сразу приходит в лагерь у скал (карта лагеря).
// В лагере у скал Тед — староста: рассказывает про воду (квест «Вода»), дела лагеря и кто за что отвечает.
// М4: отчет по лагерю (еда, вода, касса, дух), вклад в кассу, брошенный лагерь и возврат людей (1.7).
// 1.3: рассказ о набеге, похороны погибшего (дух +5%), следы (Скиталец 50%), вернуть запасы за деньги (кто платит).
#define SCRIPT_REALNAME "f2mcmst"
#include "define.h"
#include "f2mod.h"
#define NAME                    SCRIPT_F2MCMST
#include "command.h"
#include "sfall.h"
#include "define_extra.h"
#include "f2mcfgt.h"
#include "f2mcdead.h"
#include "f2mcamp.h"
#include "f2mset.h"
#include "f2mpay.h"
#include "f2mbury.h"

procedure start;
procedure critter_p_proc;
procedure combat_p_proc;
procedure talk_p_proc;
procedure damage_p_proc;
procedure accidental_hit;
procedure pickup_p_proc;
procedure destroy_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;

procedure Node001;
procedure Node002;
procedure Node003;
procedure Node004;
procedure Node005;
procedure Node006;
procedure Node007;
procedure Node008;
procedure Node009;
procedure Node010;
procedure Node011;
procedure Node012;
procedure Node013;
procedure Node014;
procedure Node015;
procedure Node020;
procedure Node021;
procedure Node022;
procedure Node023;
procedure Node024;
procedure Node025;
procedure Node026;
procedure Node027;
procedure Node028;
procedure Node030;
procedure Node031;
procedure Node032;
procedure Node033;
procedure Node034;
procedure Node035;
procedure pay_return(variable price, variable caravan);
procedure morale_text;
procedure Node040;
procedure Node041;
procedure Node042;
procedure Node043;
procedure Node044;
procedure Node045;
procedure Node046;
procedure Node047;
procedure Node048;
procedure Node049;
procedure raid_options;
procedure raid_open;
procedure raid_price;
procedure raid_restore(variable who);
procedure timed_event_p_proc;
procedure Node999;
procedure camp_people;
procedure give_coords;
procedure enemies_left;

variable said_hello;
variable go_next;
variable go_camp;
variable go_bury;

// Бесплатно: Красноречие от 75% или Привлекательность от 7
#define free_coords   ((has_skill(dude_obj, SKILL_SPEECH) >= 75) or (get_critter_stat(dude_obj, STAT_ch) >= 7))
#define on_escort     ((get_sfall_global_int(GV_CARAVAN) == CARAVAN_ESCORT) and is_escort_map(cur_map_index))

procedure start begin
end

procedure look_at_p_proc begin
   script_overrides;
   display_msg(mstr(100));
end

procedure description_p_proc begin
   script_overrides;
   display_msg(mstr(101));
end

procedure critter_p_proc begin
   if (get_sfall_global_int(GV_CARAVAN_HOSTILE)) then begin
      attack(dude_obj);
      return;
   end
   if (not combat_is_initialized) then begin
      if (cv_fight) then return;
   end
   if (not said_hello and self_can_see_dude and not on_escort) then begin
      said_hello := 1;
      if (get_sfall_global_int(GV_CARAVAN_LAST) == CARAVAN_LAST_ABANDONED) then
         floater(random(106, 108));
      else if (get_sfall_global_int(GV_CARAVAN_LAST) == CARAVAN_LAST_REFUSED) then
         floater(random(106, 107));
      else
         floater(random(102, 104));
   end
end


// Свой попал случайно (очередью или взрывом) — прощаем и ругаемся; прицельно — бой
procedure accidental_hit begin
   variable hits, r := 0;
   hits := load_array(ARR_CARAVAN_HITS);
   if (hits) then begin
      r := hits[self_obj];
      hits[self_obj] := 0;
   end
   return r;
end

procedure damage_p_proc begin
   if (is_dude_side(source_obj)) then begin
      if (accidental_hit) then
         floater(random(205, 205 + 2));
      else begin
         set_sfall_global(GV_CARAVAN_HOSTILE, 1);
         attack(dude_obj);
      end
   end else
      attack(source_obj);
end

procedure pickup_p_proc begin
   attack(source_obj);
end

procedure destroy_p_proc begin
   if (get_sfall_global_int(GV_SET_LEAVING)) then return;   // лагерь убирает лишнего или ушедшего: это не смерть
   if (is_dude_side(source_obj)) then set_sfall_global(GV_CARAVAN_HOSTILE, 1);
   // Погиб в пути или при встрече: караван больше не встречается (иначе на следующей встрече
   // карта снова ставила живого Теда со всем караваном)
   if (get_sfall_global_int(GV_CARAVAN) == CARAVAN_ESCORT
       or (get_sfall_global_int(GV_CARAVAN) == CARAVAN_NONE and cur_map_index == MAP_F2MOD_CARAVAN)) then begin
      set_sfall_global(GV_CARAVAN, CARAVAN_FAILED);
      display_msg(mstr(210));
   end
end

// Живые враги на дороге (список в f2mod.h: is_escort_enemy)
procedure enemies_left begin
   variable c, n := 0;
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (not is_critter_dead(c) and is_escort_enemy(obj_pid(c))) then n += 1;
   end
   return n;
end

// На дороге охрана и караванщик стреляют по налетчикам и зверям сами
procedure combat_p_proc begin
   if (fixed_param == COMBAT_SUBTYPE_TURN or fixed_param == COMBAT_SUBTYPE_NONCOM_TURN) then
      call cv_fight;
end

procedure talk_p_proc begin
   if (on_escort and enemies_left > 0) then begin
      floater(random(195, 197));
      return;
   end
   start_gdialog(NAME, self_obj, 4, -1, -1);
   gSay_Start;
      if (get_sfall_global_int(GV_CARAVAN) == CARAVAN_DONE) then
         call Node007;
      else if (on_escort) then begin
         if (get_sfall_global_int(GV_ESCORT_STAGE) < ESCORT_STAGES) then
            call Node010;
         else
            call Node012;
      end else if (get_sfall_global_int(GV_CARAVAN_LAST) == CARAVAN_LAST_ABANDONED) then
         call Node015;
      else if (get_sfall_global_int(GV_CARAVAN_LAST) == CARAVAN_LAST_REFUSED) then
         call Node014;
      else
         call Node001;
   gSay_End;
   end_dialogue;
   // Переход на следующий участок дороги: сутки пути и новая карта
   if (go_next) then begin
      go_next := 0;
      set_sfall_global(GV_ESCORT_MOVING, 1);
      game_time_advance(ONE_GAME_DAY);
      load_map(escort_map(get_sfall_global_int(GV_ESCORT_STAGE)), 0);
   end
   if (go_bury) then begin
      go_bury := 0;
      call bury_start(1);
   end
   // Последний участок пройден: еще сутки пути, и караван с героем уже в лагере у скал
   if (go_camp) then begin
      go_camp := 0;
      game_time_advance(ONE_GAME_DAY);
      load_map(MAP_F2MOD_CAMP, 0);
   end
end

procedure give_coords begin
   set_sfall_global(GV_CARAVAN, CARAVAN_DONE);
   set_sfall_global(GV_CARAVAN_LAST, 0);
   set_sfall_global(GV_ESCORT_RESUME, 0);
   mark_area_known(MARK_TYPE_TOWN, AREA_F2MOD_CAMP, MARK_STATE_KNOWN);
end

procedure timed_event_p_proc begin
   call bury_step(fixed_param);
end

procedure Node001 begin
   Reply(110);
   NOption(111, Node002, 4);
   NOption(112, Node005, 4);
   NLowOption(113, Node002);
end

procedure Node002 begin
   Reply(120);
   NOption(125, Node008, 4);
   NOption(122, Node004, 4);
   NOption(123, Node005, 4);
   NLowOption(126, Node008);
   NLowOption(124, Node004);
end

// Координаты даром (проверка Красноречия или Привлекательности)
procedure Node003 begin
   // Без дороги в лагерь приходят все, кто жив (бросил на дороге — погибшие там остаются)
   if (not get_sfall_global_int(GV_ESCORT_RESUME)) then set_sfall_global(GV_CARAVAN_DEAD, 0);
   call give_coords;
   give_exp_points(CARAVAN_XP_TALK);
   Reply(130);
   NOption(131, Node999, 4);
   NLowOption(132, Node999);
end

// Просто узнать, где место: платно или с проверкой
procedure Node004 begin
   Reply(140);
   if (free_coords) then
      GOption(144, Node003, 4);
   if (dude_caps >= CARAVAN_PRICE) then
      NOption(141, Node006, 4);
   NOption(145, Node008, 4);
   NOption(142, Node005, 4);
   NLowOption(143, Node005);
end

procedure Node005 begin
   set_sfall_global(GV_CARAVAN_REFUSED, get_sfall_global_int(GV_CARAVAN_REFUSED) + 1);
   set_sfall_global(GV_CARAVAN_LAST, CARAVAN_LAST_REFUSED);
   Reply(150);
   NOption(151, Node999, 4);
   NLowOption(152, Node999);
end

procedure Node006 begin
   item_caps_adjust(dude_obj, -CARAVAN_PRICE);
   item_caps_adjust(self_obj, CARAVAN_PRICE);
   if (not get_sfall_global_int(GV_ESCORT_RESUME)) then set_sfall_global(GV_CARAVAN_DEAD, 0);
   call give_coords;
   give_exp_points(CARAVAN_XP_BUY);
   Reply(160);
   NOption(161, Node999, 4);
   NLowOption(132, Node999);
end

procedure Node007 begin
   if (cur_map_index == MAP_F2MOD_CAMP) then begin
      call Node020;
      return;
   end
   Reply(170);
   NOption(171, Node999, 4);
   NLowOption(132, Node999);
end

// Предложение сопровождения
procedure Node008 begin
   if (get_sfall_global_int(GV_ESCORT_RESUME)) then
      Reply(184);
   else
      Reply(180);
   NOption(181, Node009, 4);
   NOption(182, Node005, 4);
   NLowOption(183, Node009);
end

// Выходим: первый участок дороги
procedure Node009 begin
   set_sfall_global(GV_CARAVAN, CARAVAN_ESCORT);
   // Бросил дорогу раньше: продолжаем с несделанного нападения теми, кто уцелел.
   // Иначе выходят все, с первого нападения.
   if (get_sfall_global_int(GV_ESCORT_RESUME)) then
      set_sfall_global(GV_ESCORT_STAGE, get_sfall_global_int(GV_ESCORT_RESUME));
   else begin
      set_sfall_global(GV_ESCORT_STAGE, 1);
      set_sfall_global(GV_CARAVAN_DEAD, 0);
      set_sfall_global(GV_ESCORT_S3, 0);
   end
   set_sfall_global(GV_ESCORT_RESUME, 0);
   set_sfall_global(GV_CARAVAN_LAST, 0);
   // Запоминаем, где на карте мира встретили караван: дорога пойдет отсюда, а не из Арройо
   set_sfall_global(GV_ESCORT_WMX, get_world_map_x_pos);
   set_sfall_global(GV_ESCORT_WMY, get_world_map_y_pos);
   go_next := 1;
end

// После нападения: идем дальше или герой сначала собирает трофеи
procedure Node010 begin
   Reply(189 + get_sfall_global_int(GV_ESCORT_STAGE));
   NOption(193, Node011, 4);
   NOption(194, Node999, 4);
   NLowOption(183, Node011);
end

procedure Node011 begin
   set_sfall_global(GV_ESCORT_STAGE, get_sfall_global_int(GV_ESCORT_STAGE) + 1);
   go_next := 1;
end

// Последнее нападение отбито: идем к скалам вместе
procedure Node012 begin
   variable k;
   // Кого гекконы убили до прихода героя (карта дороги, GV_ESCORT_S3): 1 Сара, 2 брамин, 4 мирные
   k := get_sfall_global_int(GV_ESCORT_S3) bwand 3;
   if (k == 3) then
      Reply(200);
   else if (k == 2) then
      Reply(202);
   else if (k == 1) then
      Reply(203);
   else if (get_sfall_global_int(GV_ESCORT_S3) bwand 4) then
      Reply(204);
   else
      Reply(198);
   NOption(201, Node013, 4);
   NOption(194, Node999, 4);
   NLowOption(183, Node013);
end

// Дошли: плата, координаты, опыт, переход в лагерь
procedure Node013 begin
   item_caps_adjust(dude_obj, CARAVAN_ESCORT_PAY);
   call give_coords;
   give_exp_points(CARAVAN_XP_ESCORT);
   display_msg(mstr(211));
   go_camp := 1;
end

// Снова встретились после отказа
procedure Node014 begin
   Reply(114);
   NOption(115, Node002, 4);
   NOption(125, Node008, 4);
   NOption(122, Node004, 4);
   NOption(116, Node005, 4);
   NLowOption(117, Node002);
end

// Снова встретились после того, как герой бросил караван на дороге
procedure Node015 begin
   Reply(118);
   NOption(119, Node008, 4);
   NOption(122, Node004, 4);
   NOption(116, Node005, 4);
   NLowOption(117, Node008);
end

// Лагерь у скал: Тед — староста
procedure Node020 begin
   variable news;
   if (get_sfall_global_int(GV_SET_ABANDON) == ABANDON_YES) then begin
      call Node030;
      return;
   end
   // После набега (1.3) первым делом рассказ о нем
   if (get_sfall_global_int(GV_RAID) and not (get_sfall_global_int(GV_RAID_TOLD) bwand 1)) then begin
      call Node040;
      return;
   end
   news := get_sfall_global_int(GV_SET_NEWS);
   set_sfall_global(GV_SET_NEWS, 0);
   if (get_sfall_global_int(GV_QUEST_WATER) == 0 and not camp_has_water) then begin
      set_sfall_global(GV_QUEST_WATER, 1);
      Reply(220);
   end else if (get_sfall_global_int(GV_SET_ABANDON) == ABANDON_RETURN) then
      Reply(330);
   else if (news == 1) then
      Reply(262);
   else if (news == 2) then
      Reply(263);
   else
      Reply(221);
   NOption(222, Node021, 4);
   NOption(223, Node022, 4);
   NOption(224, Node023, 4);
   NOption(264, Node024, 4);
   if (raid_open) then NOption(438, Node041, 4);
   NOption(225, Node999, 4);
   NLowOption(226, Node022);
   NLowOption(132, Node999);
end

// Сколько народу в лагере: Тед, Хэнк, охрана и переселенцы, кто жив и не ушел
procedure camp_people begin
   return set_people;
end

// Пара слов о духе людей (growth.md 13)
procedure morale_text begin
   variable m;
   m := get_sfall_global_int(GV_SET_MORALE);
   if (get_sfall_global_int(GV_SET_WSHORT) > 0) then return mstr(276);
   if (get_sfall_global_int(GV_SET_FSHORT) > 0) then return mstr(277);
   if (m <= -20) then return mstr(278);
   if (m < 0) then return mstr(279);
   return mstr(280);
end

// Отчет старосты: числа прямо в реплике (окно сообщений во время диалога не видно)
procedure Node021 begin
   variable t;
   if (camp_has_water) then
      t := mstr(230);
   else
      t := mstr(231);
   t := t + " " + mstr(232) + camp_people + mstr(233)
      + " " + mstr(270) + (get_sfall_global_int(GV_SET_WEEK) + 1) + "."
      + " " + mstr(271) + get_sfall_global_int(GV_SET_FOOD) + mstr(272) + set_food_prod + "."
      + " " + mstr(273) + get_sfall_global_int(GV_SET_WATER) + mstr(274) + (set_wells * SET_WELL_WATER) + "."
      + " " + mstr(275) + get_sfall_global_int(GV_SET_CASH) + "."
      + " " + mstr(281) + get_sfall_global_int(GV_SET_MORALE) + "%. " + morale_text;
   Reply(t);
   NOption(227, Node020, 4);
   NLowOption(132, Node999);
end

procedure Node022 begin
   variable left, n;
   n := camp_people;
   left := 0;
   if (n > 0) then left := get_sfall_global_int(GV_SET_WATER) * 7 / n;
   if (camp_has_water) then
      Reply(240);
   else if (left > 0) then
      Reply(mstr(243) + left + mstr(244) + " " + mstr(241) + " " + mstr(245));
   else
      Reply(mstr(242) + " " + mstr(245));
   NOption(227, Node020, 4);
   NLowOption(132, Node999);
end

// Вклад в кассу (economy.md 1): берет только сам герой, Тед кассу не отдает
procedure Node024 begin
   Reply(mstr(265) + get_sfall_global_int(GV_SET_CASH) + mstr(266));
   if (dude_caps >= 100) then NOption(267, Node025, 4);
   if (dude_caps >= 500) then NOption(268, Node026, 4);
   if (dude_caps >= 1000) then NOption(269, Node027, 4);
   NOption(227, Node020, 4);
   NLowOption(132, Node999);
end

procedure Node028 begin
   Reply(mstr(282) + get_sfall_global_int(GV_SET_CASH) + mstr(283));
   NOption(227, Node020, 4);
   NOption(225, Node999, 4);
   NLowOption(132, Node999);
end

procedure Node025 begin
   item_caps_adjust(dude_obj, -100);
   set_sfall_global(GV_SET_CASH, get_sfall_global_int(GV_SET_CASH) + 100);
   call Node028;
end

procedure Node026 begin
   item_caps_adjust(dude_obj, -500);
   set_sfall_global(GV_SET_CASH, get_sfall_global_int(GV_SET_CASH) + 500);
   call Node028;
end

procedure Node027 begin
   item_caps_adjust(dude_obj, -1000);
   set_sfall_global(GV_SET_CASH, get_sfall_global_int(GV_SET_CASH) + 1000);
   call Node028;
end

// 1.7: лагерь брошен, остались Тед, Хэнк и один охранник
procedure Node030 begin
   if (get_sfall_global_int(GV_SET_NEWS)) then begin
      set_sfall_global(GV_SET_NEWS, 0);
      Reply(300);
   end else
      Reply(301);
   NOption(302, Node031, 4);
   if (not get_sfall_global_int(GV_SET_HALF)) then NOption(303, Node032, 4);
   NOption(304, Node033, 4);
   NOption(225, Node999, 4);
   NLowOption(305, Node031);
   NLowOption(132, Node999);
end

// Колодец и тысяча (или полцены после уговора)
procedure Node031 begin
   variable price;
   price := RETURN_PRICE;
   if (get_sfall_global_int(GV_SET_HALF)) then price := RETURN_PRICE_CH;
   if (not camp_has_water) then begin
      Reply(310);
   end else begin
      Reply(mstr(311) + price + mstr(312));
      if (dude_caps >= price) then NOption(mstr(313) + price + mstr(314), Node034, 4);
   end
   NOption(227, Node030, 4);
   NLowOption(132, Node999);
end

// Уговор (Красноречие 60%): полцены. Колодец есть и деньги при себе — платим сразу.
procedure Node032 begin
   if (has_skill(dude_obj, SKILL_SPEECH) >= RETURN_SPEECH) then begin
      set_sfall_global(GV_SET_HALF, 1);
      if (not camp_has_water) then
         Reply(mstr(320) + " " + mstr(310));
      else begin
         Reply(mstr(320) + " " + mstr(311) + RETURN_PRICE_CH + mstr(312));
         if (dude_caps >= RETURN_PRICE_CH) then NOption(mstr(313) + RETURN_PRICE_CH + mstr(314), Node034, 4);
      end
   end else
      Reply(321);
   NOption(227, Node030, 4);
   NLowOption(132, Node999);
end

// Караван привозит людей без колодца: придут, но пить нечего
procedure Node033 begin
   Reply(mstr(322) + RETURN_CARAVAN + mstr(323));
   if (dude_caps >= RETURN_CARAVAN) then NOption(mstr(313) + RETURN_CARAVAN + mstr(314), Node035, 4);
   NOption(227, Node030, 4);
   NLowOption(132, Node999);
end

procedure pay_return(variable price, variable caravan) begin
   item_caps_adjust(dude_obj, -price);
   set_sfall_global(GV_SET_ABANDON, ABANDON_RETURN);
   set_sfall_global(GV_SET_RETURN, set_weeks_now + RETURN_WEEKS);
   set_sfall_global(GV_SET_HALF, 0);
   if (caravan and not camp_has_water) then set_sfall_global(GV_SET_NOLEAVE, 1);
end

procedure Node034 begin
   variable price;
   price := RETURN_PRICE;
   if (get_sfall_global_int(GV_SET_HALF)) then price := RETURN_PRICE_CH;
   call pay_return(price, 0);
   Reply(324);
   NOption(225, Node999, 4);
   NLowOption(132, Node999);
end

procedure Node035 begin
   call pay_return(RETURN_CARAVAN, 1);
   Reply(325);
   NOption(225, Node999, 4);
   NLowOption(132, Node999);
end

procedure Node023 begin
   if (cv_is_dead(CV_SLOT_GUARD) and cv_is_dead(CV_SLOT_SARA)) then
      Reply(252);
   else if (cv_is_dead(CV_SLOT_GUARD)) then
      Reply(251);
   else
      Reply(250);
   NOption(227, Node020, 4);
   NLowOption(132, Node999);
end

// ---- Набег 1.3 ----

// Что еще можно сделать после набега: похоронить, пойти по следам, вернуть запасы
procedure raid_open begin
   return (get_sfall_global_int(GV_RAID_DEAD) and not get_sfall_global_int(GV_RAID_BURY))
       or not get_sfall_global_int(GV_RAID_TRACK)
       or (raid_price > 0 and not get_sfall_global_int(GV_RAID_PAID));
end

// Вернуть унесенное у каравана: еда 10 за паек, вода 21 (economy.md)
procedure raid_price begin
   return get_sfall_global_int(GV_RAID_FOOD) * SET_FOOD_PRICE + get_sfall_global_int(GV_RAID_WATER) * SET_WATER_PRICE;
end

procedure raid_options begin
   variable dead;
   dead := get_sfall_global_int(GV_RAID_DEAD);
   if (dead) then NOption(400, Node042, 4);
   if (dead and not get_sfall_global_int(GV_RAID_BURY)) then NOption(401, Node043, 4);
   if (not get_sfall_global_int(GV_RAID_TRACK)) then NOption(402, Node044, 4);
   if (raid_price > 0 and not get_sfall_global_int(GV_RAID_PAID)) then NOption(403, Node045, 4);
   NOption(404, Node046, 4);
   NOption(227, Node020, 4);
   NOption(225, Node999, 4);
   NLowOption(132, Node999);
end

// Рассказ: «Они пришли ночью. Взяли что смогли» и итог по тому, что герой успел
procedure Node040 begin
   variable out, t;
   set_sfall_global(GV_RAID_TOLD, get_sfall_global_int(GV_RAID_TOLD) bwor 1);
   out := get_sfall_global_int(GV_RAID_OUT);
   t := mstr(440) + " ";
   if (out == RAID_OUT_NONE) then begin
      if (get_sfall_global_int(GV_RAID_TENTS)) then t := t + mstr(441);
      else t := t + mstr(442);
   end else if (out == RAID_OUT_FENCE) then begin
      if (get_sfall_global_int(GV_RAID_DEAD)) then t := t + mstr(443);
      else t := t + mstr(446);
   end else
      t := t + mstr(444);
   if (get_sfall_global_int(GV_WAGON) == 1) then t := t + " " + mstr(445);
   Reply(t);
   call raid_options;
end

procedure Node041 begin
   Reply(405);
   call raid_options;
end

// Кто погиб
procedure Node042 begin
   if (get_sfall_global_int(GV_RAID_DEAD) == PID_CHILD_MALE) then
      Reply(410);
   else
      Reply(411);
   call raid_options;
end

// Похоронить: копает Хэнк; если Хэнка нет, Тед собирает людей сам
procedure Node043 begin
   if (bury_speaker(PID_HANK, 0)) then begin
      Reply(418);
      call raid_options;
      return;
   end
   go_bury := 1;
   Reply(412);
   NOption(413, Node999, 4);
   NLowOption(413, Node999);
end

// Пойти по следам: Скиталец 50% — намек на логово (сам квест 1.4 открывается позже)
procedure Node044 begin
   if (has_skill(dude_obj, SKILL_OUTDOORSMAN) >= RAID_TRACK_SKILL) then begin
      set_sfall_global(GV_RAID_TRACK, 1);
      Reply(415);
      display_msg(mstr(416));
   end else begin
      set_sfall_global(GV_RAID_TRACK, 2);
      Reply(417);
   end
   call raid_options;
end

// Вернуть запасы деньгами: кто платит
procedure Node045 begin
   variable p, c;
   p := raid_price;
   c := pay_cash_now;
   Reply(mstr(420) + p + mstr(421));
   if (can_pay_hero(p)) then NOption(mstr(422) + p + mstr(429), Node047, 4);
   if (can_pay_cash(p)) then NOption(mstr(423) + c + mstr(424), Node048, 4);
   if (can_pay_split(p)) then NOption(mstr(425) + c + mstr(426) + (p - c) + mstr(429), Node049, 4);
   NOption(427, Node041, 4);
   NLowOption(132, Node999);
end

procedure raid_restore(variable who) begin
   call pay_do(raid_price, who);
   set_sfall_global(GV_SET_FOOD, get_sfall_global_int(GV_SET_FOOD) + get_sfall_global_int(GV_RAID_FOOD));
   set_sfall_global(GV_SET_WATER, get_sfall_global_int(GV_SET_WATER) + get_sfall_global_int(GV_RAID_WATER));
   set_sfall_global(GV_RAID_PAID, 1);
   Reply(428);
   call raid_options;
end

procedure Node047 begin
   call raid_restore(PAY_HERO);
end

procedure Node048 begin
   call raid_restore(PAY_CASH);
end

procedure Node049 begin
   call raid_restore(PAY_SPLIT);
end

procedure Node046 begin
   Reply(430);
   call raid_options;
end

procedure Node999 begin
end
