// Караванщик Тед Бернс: встреча «Хорошее место».
// Первый вариант — проводить караван за 300 (три нападения в пути), второй — просто узнать,
// где место: за 500 крышек или бесплатно (Красноречие 75% или Привлекательность 7).
// После третьего нападения караван с героем сразу приходит в лагерь у скал (карта лагеря).
// В лагере у скал Тед — староста: рассказывает про воду (квест «Вода»), дела лагеря и кто за что отвечает.
#define SCRIPT_REALNAME "f2mcmst"
#include "define.h"
#include "f2mod.h"
#define NAME                    SCRIPT_F2MCMST
#include "command.h"
#include "sfall.h"
#include "define_extra.h"
#include "f2mcfgt.h"
#include "f2mcdead.h"
#include "f2mcamp.h"

procedure start;
procedure critter_p_proc;
procedure combat_p_proc;
procedure talk_p_proc;
procedure damage_p_proc;
procedure accidental_hit;
procedure pickup_p_proc;
procedure destroy_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;

procedure Node001;
procedure Node002;
procedure Node003;
procedure Node004;
procedure Node005;
procedure Node006;
procedure Node007;
procedure Node008;
procedure Node009;
procedure Node010;
procedure Node011;
procedure Node012;
procedure Node013;
procedure Node014;
procedure Node015;
procedure Node020;
procedure Node021;
procedure Node022;
procedure Node023;
procedure Node999;
procedure camp_people;
procedure give_coords;
procedure enemies_left;

variable said_hello;
variable go_next;
variable go_camp;

// Бесплатно: Красноречие от 75% или Привлекательность от 7
#define free_coords   ((has_skill(dude_obj, SKILL_SPEECH) >= 75) or (get_critter_stat(dude_obj, STAT_ch) >= 7))
#define on_escort     ((get_sfall_global_int(GV_CARAVAN) == CARAVAN_ESCORT) and is_escort_map(cur_map_index))

procedure start begin
end

procedure look_at_p_proc begin
   script_overrides;
   display_msg(mstr(100));
end

procedure description_p_proc begin
   script_overrides;
   display_msg(mstr(101));
end

procedure critter_p_proc begin
   if (get_sfall_global_int(GV_CARAVAN_HOSTILE)) then begin
      attack(dude_obj);
      return;
   end
   if (not combat_is_initialized) then begin
      if (cv_fight) then return;
   end
   if (not said_hello and self_can_see_dude and not on_escort) then begin
      said_hello := 1;
      if (get_sfall_global_int(GV_CARAVAN_LAST) == CARAVAN_LAST_ABANDONED) then
         floater(random(106, 108));
      else if (get_sfall_global_int(GV_CARAVAN_LAST) == CARAVAN_LAST_REFUSED) then
         floater(random(106, 107));
      else
         floater(random(102, 104));
   end
end


// Свой попал случайно (очередью или взрывом) — прощаем и ругаемся; прицельно — бой
procedure accidental_hit begin
   variable hits, r := 0;
   hits := load_array(ARR_CARAVAN_HITS);
   if (hits) then begin
      r := hits[self_obj];
      hits[self_obj] := 0;
   end
   return r;
end

procedure damage_p_proc begin
   if (is_dude_side(source_obj)) then begin
      if (accidental_hit) then
         floater(random(205, 205 + 2));
      else begin
         set_sfall_global(GV_CARAVAN_HOSTILE, 1);
         attack(dude_obj);
      end
   end else
      attack(source_obj);
end

procedure pickup_p_proc begin
   attack(source_obj);
end

procedure destroy_p_proc begin
   if (is_dude_side(source_obj)) then set_sfall_global(GV_CARAVAN_HOSTILE, 1);
   // Погиб в пути или при встрече: караван больше не встречается (иначе на следующей встрече
   // карта снова ставила живого Теда со всем караваном)
   if (get_sfall_global_int(GV_CARAVAN) == CARAVAN_ESCORT
       or (get_sfall_global_int(GV_CARAVAN) == CARAVAN_NONE and cur_map_index == MAP_F2MOD_CARAVAN)) then begin
      set_sfall_global(GV_CARAVAN, CARAVAN_FAILED);
      display_msg(mstr(210));
   end
end

// Живые враги на дороге (список в f2mod.h: is_escort_enemy)
procedure enemies_left begin
   variable c, n := 0;
   foreach (c in list_as_array(LIST_CRITTERS)) begin
      if (not is_critter_dead(c) and is_escort_enemy(obj_pid(c))) then n += 1;
   end
   return n;
end

// На дороге охрана и караванщик стреляют по налетчикам и зверям сами
procedure combat_p_proc begin
   if (fixed_param == COMBAT_SUBTYPE_TURN or fixed_param == COMBAT_SUBTYPE_NONCOM_TURN) then
      call cv_fight;
end

procedure talk_p_proc begin
   if (on_escort and enemies_left > 0) then begin
      floater(random(195, 197));
      return;
   end
   start_gdialog(NAME, self_obj, 4, -1, -1);
   gSay_Start;
      if (get_sfall_global_int(GV_CARAVAN) == CARAVAN_DONE) then
         call Node007;
      else if (on_escort) then begin
         if (get_sfall_global_int(GV_ESCORT_STAGE) < ESCORT_STAGES) then
            call Node010;
         else
            call Node012;
      end else if (get_sfall_global_int(GV_CARAVAN_LAST) == CARAVAN_LAST_ABANDONED) then
         call Node015;
      else if (get_sfall_global_int(GV_CARAVAN_LAST) == CARAVAN_LAST_REFUSED) then
         call Node014;
      else
         call Node001;
   gSay_End;
   end_dialogue;
   // Переход на следующий участок дороги: сутки пути и новая карта
   if (go_next) then begin
      go_next := 0;
      set_sfall_global(GV_ESCORT_MOVING, 1);
      game_time_advance(ONE_GAME_DAY);
      load_map(escort_map(get_sfall_global_int(GV_ESCORT_STAGE)), 0);
   end
   // Последний участок пройден: еще сутки пути, и караван с героем уже в лагере у скал
   if (go_camp) then begin
      go_camp := 0;
      game_time_advance(ONE_GAME_DAY);
      load_map(MAP_F2MOD_CAMP, 0);
   end
end

procedure give_coords begin
   set_sfall_global(GV_CARAVAN, CARAVAN_DONE);
   set_sfall_global(GV_CARAVAN_LAST, 0);
   set_sfall_global(GV_ESCORT_RESUME, 0);
   mark_area_known(MARK_TYPE_TOWN, AREA_F2MOD_CAMP, MARK_STATE_KNOWN);
end

procedure Node001 begin
   Reply(110);
   NOption(111, Node002, 4);
   NOption(112, Node005, 4);
   NLowOption(113, Node002);
end

procedure Node002 begin
   Reply(120);
   NOption(125, Node008, 4);
   NOption(122, Node004, 4);
   NOption(123, Node005, 4);
   NLowOption(126, Node008);
   NLowOption(124, Node004);
end

// Координаты даром (проверка Красноречия или Привлекательности)
procedure Node003 begin
   // Без дороги в лагерь приходят все, кто жив (бросил на дороге — погибшие там остаются)
   if (not get_sfall_global_int(GV_ESCORT_RESUME)) then set_sfall_global(GV_CARAVAN_DEAD, 0);
   call give_coords;
   give_exp_points(CARAVAN_XP_TALK);
   Reply(130);
   NOption(131, Node999, 4);
   NLowOption(132, Node999);
end

// Просто узнать, где место: платно или с проверкой
procedure Node004 begin
   Reply(140);
   if (free_coords) then
      GOption(144, Node003, 4);
   if (dude_caps >= CARAVAN_PRICE) then
      NOption(141, Node006, 4);
   NOption(145, Node008, 4);
   NOption(142, Node005, 4);
   NLowOption(143, Node005);
end

procedure Node005 begin
   set_sfall_global(GV_CARAVAN_REFUSED, get_sfall_global_int(GV_CARAVAN_REFUSED) + 1);
   set_sfall_global(GV_CARAVAN_LAST, CARAVAN_LAST_REFUSED);
   Reply(150);
   NOption(151, Node999, 4);
   NLowOption(152, Node999);
end

procedure Node006 begin
   item_caps_adjust(dude_obj, -CARAVAN_PRICE);
   item_caps_adjust(self_obj, CARAVAN_PRICE);
   if (not get_sfall_global_int(GV_ESCORT_RESUME)) then set_sfall_global(GV_CARAVAN_DEAD, 0);
   call give_coords;
   give_exp_points(CARAVAN_XP_BUY);
   Reply(160);
   NOption(161, Node999, 4);
   NLowOption(132, Node999);
end

procedure Node007 begin
   if (cur_map_index == MAP_F2MOD_CAMP) then begin
      call Node020;
      return;
   end
   Reply(170);
   NOption(171, Node999, 4);
   NLowOption(132, Node999);
end

// Предложение сопровождения
procedure Node008 begin
   if (get_sfall_global_int(GV_ESCORT_RESUME)) then
      Reply(184);
   else
      Reply(180);
   NOption(181, Node009, 4);
   NOption(182, Node005, 4);
   NLowOption(183, Node009);
end

// Выходим: первый участок дороги
procedure Node009 begin
   set_sfall_global(GV_CARAVAN, CARAVAN_ESCORT);
   // Бросил дорогу раньше: продолжаем с несделанного нападения теми, кто уцелел.
   // Иначе выходят все, с первого нападения.
   if (get_sfall_global_int(GV_ESCORT_RESUME)) then
      set_sfall_global(GV_ESCORT_STAGE, get_sfall_global_int(GV_ESCORT_RESUME));
   else begin
      set_sfall_global(GV_ESCORT_STAGE, 1);
      set_sfall_global(GV_CARAVAN_DEAD, 0);
      set_sfall_global(GV_ESCORT_S3, 0);
   end
   set_sfall_global(GV_ESCORT_RESUME, 0);
   set_sfall_global(GV_CARAVAN_LAST, 0);
   // Запоминаем, где на карте мира встретили караван: дорога пойдет отсюда, а не из Арройо
   set_sfall_global(GV_ESCORT_WMX, get_world_map_x_pos);
   set_sfall_global(GV_ESCORT_WMY, get_world_map_y_pos);
   go_next := 1;
end

// После нападения: идем дальше или герой сначала собирает трофеи
procedure Node010 begin
   Reply(189 + get_sfall_global_int(GV_ESCORT_STAGE));
   NOption(193, Node011, 4);
   NOption(194, Node999, 4);
   NLowOption(183, Node011);
end

procedure Node011 begin
   set_sfall_global(GV_ESCORT_STAGE, get_sfall_global_int(GV_ESCORT_STAGE) + 1);
   go_next := 1;
end

// Последнее нападение отбито: идем к скалам вместе
procedure Node012 begin
   variable k;
   // Кого гекконы убили до прихода героя (карта дороги, GV_ESCORT_S3): 1 Сара, 2 брамин, 4 мирные
   k := get_sfall_global_int(GV_ESCORT_S3) bwand 3;
   if (k == 3) then
      Reply(200);
   else if (k == 2) then
      Reply(202);
   else if (k == 1) then
      Reply(203);
   else if (get_sfall_global_int(GV_ESCORT_S3) bwand 4) then
      Reply(204);
   else
      Reply(198);
   NOption(201, Node013, 4);
   NOption(194, Node999, 4);
   NLowOption(183, Node013);
end

// Дошли: плата, координаты, опыт, переход в лагерь
procedure Node013 begin
   item_caps_adjust(dude_obj, CARAVAN_ESCORT_PAY);
   call give_coords;
   give_exp_points(CARAVAN_XP_ESCORT);
   display_msg(mstr(211));
   go_camp := 1;
end

// Снова встретились после отказа
procedure Node014 begin
   Reply(114);
   NOption(115, Node002, 4);
   NOption(125, Node008, 4);
   NOption(122, Node004, 4);
   NOption(116, Node005, 4);
   NLowOption(117, Node002);
end

// Снова встретились после того, как герой бросил караван на дороге
procedure Node015 begin
   Reply(118);
   NOption(119, Node008, 4);
   NOption(122, Node004, 4);
   NOption(116, Node005, 4);
   NLowOption(117, Node008);
end

// Лагерь у скал: Тед — староста
procedure Node020 begin
   if (get_sfall_global_int(GV_QUEST_WATER) == 0 and not camp_has_water) then begin
      set_sfall_global(GV_QUEST_WATER, 1);
      Reply(220);
   end else
      Reply(221);
   NOption(222, Node021, 4);
   NOption(223, Node022, 4);
   NOption(224, Node023, 4);
   NOption(225, Node999, 4);
   NLowOption(226, Node022);
   NLowOption(132, Node999);
end

// Сколько народу в лагере: Тед, Хэнк, живые охранники и переселенцы
procedure camp_people begin
   return 2 + (not cv_is_dead(CV_SLOT_GUARD)) + (not cv_is_dead(CV_SLOT_SARA)) + cv_civs_alive;
end

procedure Node021 begin
   // Числа вставляем прямо в реплику: окно сообщений во время диалога не видно
   if (camp_has_water) then
      Reply(mstr(230) + " " + mstr(232) + camp_people + mstr(233));
   else
      Reply(mstr(231) + " " + mstr(232) + camp_people + mstr(233));
   NOption(227, Node020, 4);
   NLowOption(132, Node999);
end

procedure Node022 begin
   variable left;
   left := CAMP_WATER_DAYS - camp_days;
   if (camp_has_water) then
      Reply(240);
   else if (left > 0) then begin
      Reply(mstr(243) + left + mstr(244) + " " + mstr(241));
   end else
      Reply(242);
   NOption(227, Node020, 4);
   NLowOption(132, Node999);
end

procedure Node023 begin
   if (cv_is_dead(CV_SLOT_GUARD) and cv_is_dead(CV_SLOT_SARA)) then
      Reply(252);
   else if (cv_is_dead(CV_SLOT_GUARD)) then
      Reply(251);
   else
      Reply(250);
   NOption(227, Node020, 4);
   NLowOption(132, Node999);
end

procedure Node999 begin
end
