// Старший фермер Дэйв Хольц (docs/npc-cards.md): ведет огороды, дает два квеста —
// 2.2 «Крысы в огороде» (ночью сам зовет героя) и 2.3 «Пропавший брамин» (пути: следы, охрана, пастух, новый брамин).
// Вне боя держится на своем огороде, в бою прячется, как жители.
#define SCRIPT_REALNAME "f2mfarm"
#include "define.h"
#include "f2mod.h"
#define NAME                    SCRIPT_F2MFARM
#include "command.h"
#include "sfall.h"
#include "scenepid.h"
#include "f2mcv.h"
#include "f2mcamp.h"
#include "f2mtlay.h"
#include "f2mbld.h"
#include "f2mspots.h"
#include "f2mlvl.h"
#include "f2mset.h"
#include "f2msam.h"
#include "f2mfarm.h"
#include "f2mfine.h"

procedure start;
procedure critter_p_proc;
procedure damage_p_proc;
procedure talk_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;
procedure destroy_p_proc;
procedure brah_found(variable xp);
procedure brah_lost;
procedure Node001;
procedure Node010;
procedure Node020;
procedure Node021;
procedure Node022;
procedure Node023;
procedure Node024;
procedure Node025;
procedure Node030;
procedure Node999;

// LVAR 0: 1 = уже знакомы
#define LVAR_MET        (0)

variable greeted;

procedure start begin
end

procedure look_at_p_proc begin
   script_overrides;
   display_msg(mstr(100));
end

procedure description_p_proc begin
   script_overrides;
   display_msg(mstr(101));
end

procedure critter_p_proc begin
   if (combat_is_initialized or cur_map_index != MAP_F2MOD_CAMP or get_sfall_global_int(GV_BURY_ON)) then return;
   // Ночью крысы на грядках: фермер зовет героя
   if (get_sfall_global_int(GV_RATS) == 1) then begin
      if (self_can_see_dude and tile_distance_objs(self_obj, dude_obj) < 8) then floater(110);
      return;
   end
   if (tile_distance(tile_num(self_obj), farm_spot) > 3 and not anim_busy(self_obj)) then
      animate_move_obj_to_tile(self_obj, farm_spot, 0);
   if (not greeted and self_can_see_dude and tile_distance_objs(self_obj, dude_obj) < 6) then begin
      greeted := 1;
      floater(random(102, 104));
   end
end

procedure damage_p_proc begin
   if (is_dude_side(source_obj)) then begin
      camp_fine_wound;
      set_sfall_global(GV_CARAVAN_HOSTILE, 1);
      floater(105);
   end
end

procedure destroy_p_proc begin
   if (get_sfall_global_int(GV_SET_LEAVING)) then return;
   set_sfall_global(GV_FARM, 9);
   if (is_dude_side(source_obj)) then begin
      camp_fine_add(CAMP_FINE_KILL);
      set_sfall_global(GV_CARAVAN_HOSTILE, 1);
   end
end

procedure talk_p_proc begin
   if (get_sfall_global_int(GV_CARAVAN_HOSTILE)) then begin
      floater(105);
      return;
   end
   if (fine_due) then begin
      floater(106);
      return;
   end
   start_gdialog(NAME, self_obj, 4, -1, -1);
   gSay_Start;
      call Node001;
   gSay_End;
   end_dialogue;
end

procedure Node001 begin
   if (not local_var(LVAR_MET)) then begin
      set_local_var(LVAR_MET, 1);
      Reply(120);
   end else if (get_sfall_global_int(GV_BRAH) == 1) then
      Reply(122);
   else
      Reply(121);
   NOption(123, Node010, 4);
   if (get_sfall_global_int(GV_BRAH) == 1) then NOption(124, Node020, 4);
   NOption(125, Node030, 4);
   NOption(126, Node999, 4);
   NLowOption(127, Node999);
end

// Кто ты и откуда
procedure Node010 begin
   Reply(130);
   NOption(131, Node001, 4);
   NLowOption(127, Node999);
end

// 2.3 Пропавший брамин: пути
procedure Node020 begin
   Reply(140);
   NOption(141, Node021, 4);                                        // пойти по следам
   if (set_here(CV_SLOT_GUARD) or set_here(CV_SLOT_SARA)) then NOption(142, Node022, 4);   // послать охрану
   if (dude_caps >= BRAH_PAY) then NOption(143, Node023, 4);        // заплатить пастуху
   if (has_skill(dude_obj, SKILL_SPEECH) >= BRAH_SPEECH and dude_caps >= BRAH_BUY) then
      NOption(144, Node024, 4);                                     // купить нового у каравана
   NOption(145, Node025, 4);                                        // не искать
   NLowOption(127, Node999);
end

// Брамин нашелся: еда цела, опыт
procedure brah_found(variable xp) begin
   set_sfall_global(GV_BRAH, 2);
   if (xp) then give_exp_points(xp);
end

// Брамина так и не нашли: мяса меньше (минус части недельного сбора)
procedure brah_lost begin
   set_sfall_global(GV_BRAH, 3);
   call farm_loss(BRAH_LOSS);
end

// (1) По следам: Скиталец 50 — наверняка, без навыка — как повезет
procedure Node021 begin
   gfade_out(1);
   game_time_advance(3 * ONE_GAME_HOUR);
   gfade_in(1);
   if (has_skill(dude_obj, SKILL_OUTDOORSMAN) >= BRAH_OUTDOOR or random(1, 100) <= BRAH_CHANCE) then begin
      call brah_found(BRAH_XP);
      Reply(150);
   end else begin
      call brah_lost;
      Reply(151);
   end
   NOption(159, Node999, 4);
   NLowOption(127, Node999);
end

// (2) Охрана: половина на половину
procedure Node022 begin
   gfade_out(1);
   game_time_advance(4 * ONE_GAME_HOUR);
   gfade_in(1);
   if (random(1, 100) <= BRAH_CHANCE) then begin
      call brah_found(0);
      Reply(152);
   end else begin
      call brah_lost;
      Reply(153);
   end
   NOption(159, Node999, 4);
   NLowOption(127, Node999);
end

// (3) Пастух за 50 крышек: он знает, где брамин любит ходить
procedure Node023 begin
   item_caps_adjust(dude_obj, -BRAH_PAY);
   item_caps_adjust(self_obj, BRAH_PAY);
   gfade_out(1);
   game_time_advance(4 * ONE_GAME_HOUR);
   gfade_in(1);
   if (random(1, 100) <= BRAH_PAY_CHANCE) then begin
      call brah_found(0);
      Reply(154);
   end else begin
      call brah_lost;
      Reply(155);
   end
   NOption(159, Node999, 4);
   NLowOption(127, Node999);
end

// (4) Новый брамин у каравана: Красноречие 40 и 100 крышек
procedure Node024 begin
   item_caps_adjust(dude_obj, -BRAH_BUY);
   call brah_found(0);
   Reply(156);
   NOption(159, Node999, 4);
   NLowOption(127, Node999);
end

// (5) Не искать
procedure Node025 begin
   call brah_lost;
   Reply(157);
   NOption(159, Node999, 4);
   NLowOption(127, Node999);
end

// Как дела на огородах
procedure Node030 begin
   if (bld_shown(U_GARDEN) >= 1 or bld_shown(U_GARDEN + 1) >= 1) then Reply(random(160, 163));
   else Reply(164);
   NOption(131, Node001, 4);
   NLowOption(127, Node999);
end

procedure Node999 begin
end
