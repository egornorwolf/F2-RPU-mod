// LVAR 0: 1 = уже знакомы
#define LVAR_MET        (0)

// Что строим: вид постройки (KIND_*), цена, нужные Сила и Выносливость, часы работы, опыт за помощь
#define KIND_WELL       (0)
#define KIND_GARDEN     (1)
#define KIND_TENT       (2)
#define kind_price(k)   (40 * ((k) == KIND_WELL) + 15 * ((k) == KIND_GARDEN) + 10 * ((k) == KIND_TENT))
#define kind_stat(k)    (6 * ((k) == KIND_WELL) + 5 * ((k) != KIND_WELL))
#define kind_hours(k)   (12 * ((k) == KIND_WELL) + 4 * ((k) == KIND_GARDEN) + 3 * ((k) == KIND_TENT))
#define kind_xp(k)      (50 * ((k) == KIND_WELL) + 25 * ((k) != KIND_WELL))
#define can_help(k)     (get_critter_stat(dude_obj, STAT_st) >= kind_stat(k) and get_critter_stat(dude_obj, STAT_en) >= kind_stat(k))

variable greeted;
variable sel := -1;        // выбранное место в диалоге
variable go_build := -1;   // что строить после диалога
variable helped;           // герой помогал сам
variable go_fence;         // строить частокол после диалога
variable go_bury;          // похороны после диалога: какая речь (f2mbury.h)
variable fled;             // убегал от боя к костру: после боя вернуться к воротам
variable sel_u := -1;      // улучшения (0.7.0): выбранное здание (U_*), -1 — шатры вместо всех палаток разом
variable sel_lv;           // на какой уровень
variable sel_price;
variable go_l1 := -1;      // строить 1-й уровень после диалога (сразу, как палатки)
variable go_wait;          // ждать на месте, пока бригада go_wait достроит

procedure start begin
end

procedure look_at_p_proc begin
   script_overrides;
   display_msg(mstr(100));
end

procedure description_p_proc begin
   script_overrides;
   display_msg(mstr(101));
end

procedure critter_p_proc begin
   if (get_sfall_global_int(GV_BLD_SYNC)) then call bld_map_sync;
   // бой кончился: назад на свое место у ворот
   if (fled and not combat_is_initialized and cur_map_index == MAP_F2MOD_CAMP and not get_sfall_global_int(GV_BURY_ON)) then begin
      if (tile_distance(tile_num(self_obj), HANK_SPOT) <= 1) then begin
         fled := 0;
         anim(self_obj, ANIMATE_ROTATION, 2);
      end else if (not anim_busy(self_obj)) then
         animate_move_obj_to_tile(self_obj, HANK_SPOT, 0);
      return;
   end
   if (not greeted and not combat_is_initialized and self_can_see_dude
       and tile_distance_objs(self_obj, dude_obj) < 6) then begin
      greeted := 1;
      floater(random(102, 104));
   end
end

// Свой попал случайно (очередью или взрывом) — прощаем; прицельно — весь лагерь воюет
procedure accidental_hit begin
   variable hits, r := 0;
   hits := load_array(ARR_CARAVAN_HITS);
   if (hits) then begin
      r := hits[self_obj];
      hits[self_obj] := 0;
   end
   return r;
end

procedure damage_p_proc begin
   if (is_dude_side(source_obj)) then begin
      if (accidental_hit) then
         floater(random(105, 106));
      else begin
         camp_fine_wound;
         set_sfall_global(GV_CARAVAN_HOSTILE, 1);
         floater(107);
      end
   end
end

// Хэнк не воин (Егор 2026-10-08): в бою не дерется, а бежит вглубь лагеря, к костру. В бою движок не дает
// скриптам двигать людей, кроме reg_anim_* после reg_anim_combat_check(0) (sfall); -1 — бежит до места за один ход
procedure combat_p_proc begin
   if (fixed_param != COMBAT_SUBTYPE_TURN or cur_map_index != MAP_F2MOD_CAMP) then return;
   script_overrides;
   if (tile_distance(tile_num(self_obj), HANK_SAFE) > 2) then begin   // HANK_SAFE: у шатра старосты — LVL_SAFE2
      fled := 1;
      reg_anim_combat_check(0);
      reg_anim_begin();
      reg_anim_obj_run_to_tile(self_obj, HANK_SAFE, -1);
      reg_anim_end();
   end
end

procedure destroy_p_proc begin
   if (get_sfall_global_int(GV_SET_LEAVING)) then return;   // лагерь убирает лишнего или ушедшего: это не смерть
   if (is_dude_side(source_obj)) then begin
      camp_fine_add(CAMP_FINE_KILL);
      set_sfall_global(GV_CARAVAN_HOSTILE, 1);
   end
end

procedure talk_p_proc begin
   if (get_sfall_global_int(GV_CARAVAN_HOSTILE)) then begin
      floater(107);
      return;
   end
   if (fine_due) then begin
      float_msg(self_obj, FINE_MSG(487 + not fine_ted_here), FLOAT_MSG_NORMAL);
      return;
   end
   go_build := -1;
   go_bury := 0;
   go_l1 := -1;
   go_wait := 0;
   start_gdialog(NAME, self_obj, 4, -1, -1);
   gSay_Start;
      call Node001;
   gSay_End;
   end_dialogue;
   if (go_build >= 0) then call do_build;
   if (go_fence) then call do_fence;
   if (go_bury) then call bury_start(go_bury);
   if (go_l1 >= 0) then call do_l1;
   if (go_wait) then call do_wait;
end

procedure timed_event_p_proc begin
   call bury_step(fixed_param);
end

// Частокол: экран гаснет, 4 дня, колья стоят (f2mfence.h)
procedure do_fence begin
   go_fence := 0;
   gfade_out(1);
   game_time_advance(FENCE_DAYS * ONE_GAME_DAY);
   set_sfall_global(GV_FENCE, 1);
   call lay_fence;
   gfade_in(1);
   display_msg(mstr(217));
end

// Первое свободное место из диапазона, -1 если все занято
procedure free_slot(variable first, variable last) begin
   while (first <= last) do begin
      if (not camp_built(first)) then return first;
      first += 1;
   end
   return -1;
end

procedure kind_of(variable slot) begin
   if (slot == BUILD_WELL) then return KIND_WELL;
   if (slot < BUILD_TENT) then return KIND_GARDEN;
   return KIND_TENT;
end

// Стройка после диалога: экран гаснет, проходят часы, постройка на месте
procedure do_build begin
   variable k;
   k := kind_of(go_build);
   gfade_out(1);
   game_time_advance(kind_hours(k) * ONE_GAME_HOUR);
   call camp_set_built(go_build);
   call lay_slot(go_build);
   call camp_spread(0);
   gfade_in(1);
   if (go_build == BUILD_HERO) then display_msg(mstr(201));
   else display_msg(mstr(190 + k));
   if (helped) then begin
      give_exp_points(kind_xp(k));
      display_msg(mstr(195) + kind_xp(k) + mstr(196));
   end
   if (k == KIND_WELL) then call camp_water_done(mstr(197));
   go_build := -1;
end

// Текст о выбранной постройке: у палатки героя свой
procedure build_reply(variable k) begin
   if (sel == BUILD_HERO) then Reply(200);
   else Reply(130 + k);
end

procedure Node001 begin
   if (local_var(LVAR_MET)) then
      Reply(111);
   else begin
      set_local_var(LVAR_MET, 1);
      Reply(110);
   end
   NOption(112, Node010, 4);
   if (get_sfall_global_int(GV_WELL_OLD) == WELL_OLD_BROKEN) then
      NOption(113, Node020, 4);
   NOption(400, Node060, 4);
   NOption(114, Node030, 4);
   if (get_sfall_global_int(GV_RAID_DEAD) and not get_sfall_global_int(GV_RAID_BURY)) then NOption(300, Node050, 4);
   // Погреб в карьере взорван (1.4): расчистить, пока там не строят базу
   if (get_sfall_global_int("f2mlairc") == 2 and not get_sfall_global_int(GV_CELL_OPEN) and bld_level(U_BASE_UNIT) < 1) then
      NOption(800, Node140, 4);
   NOption(115, Node999, 4);
   NLowOption(116, Node010);
   NLowOption(117, Node999);
end

// Что можно построить
procedure Node010 begin
   variable g, t, w, h;
   w := not camp_built(BUILD_WELL);
   g := free_slot(BUILD_GARDEN, BUILD_TENT - 1);
   t := free_slot(BUILD_TENT, BUILD_HERO - 1);
   h := not camp_built(BUILD_HERO);
   if (not w and g < 0 and t < 0 and not h and get_sfall_global_int(GV_FENCE)) then begin
      Reply(126);
      NOption(125, Node001, 4);
      NLowOption(117, Node999);
      return;
   end
   Reply(120);
   if (w) then NOption(121, Node015, 4);
   if (g >= 0) then begin
      if (camp_has_water) then
         NOption(122, Node016, 4);
      else
         NOption(123, Node013, 4);
   end
   if (t >= 0) then NOption(124, Node017, 4);
   if (h) then NOption(202, Node018, 4);
   if (not get_sfall_global_int(GV_FENCE)) then NOption(128, Node040, 4);
   NOption(125, Node001, 4);
   if (w) then NLowOption(127, Node015);
   NLowOption(117, Node999);
end

// Выбрали постройку: колодец, огород или палатка
procedure Node015 begin
   sel := BUILD_WELL;
   call Node011;
end

procedure Node016 begin
   sel := free_slot(BUILD_GARDEN, BUILD_TENT - 1);
   call Node011;
end

procedure Node017 begin
   sel := free_slot(BUILD_TENT, BUILD_HERO - 1);
   call Node011;
end

procedure Node018 begin
   sel := BUILD_HERO;
   call Node011;
end

// Цена и условия выбранной постройки
procedure Node011 begin
   variable k;
   if (sel < 0) then begin
      call Node010;
      return;
   end
   k := kind_of(sel);
   call build_reply(k);
   NOption(133 + k, Node012, 4);
   if (dude_caps >= kind_price(k)) then
      NOption(136 + k, Node014, 4);
   NOption(139, Node010, 4);
   NLowOption(140, Node012);
   NLowOption(117, Node999);
end

// Герой помогает сам: Сила и Выносливость
procedure Node012 begin
   variable k;
   k := kind_of(sel);
   if (can_help(k)) then begin
      helped := 1;
      go_build := sel;
      Reply(150 + k);
      NOption(153, Node999, 4);
      NLowOption(154, Node999);
   end else begin
      Reply(155);
      if (dude_caps >= kind_price(k)) then
         NOption(136 + k, Node014, 4);
      NOption(139, Node010, 4);
      NLowOption(117, Node999);
   end
end

// Огород без воды не нужен
procedure Node013 begin
   Reply(160);
   NOption(125, Node010, 4);
   NLowOption(117, Node999);
end

// Платит крышками
procedure Node014 begin
   variable k;
   k := kind_of(sel);
   item_caps_adjust(dude_obj, -kind_price(k));
   item_caps_adjust(self_obj, kind_price(k));
   helped := 0;
   go_build := sel;
   Reply(165);
   NOption(166, Node999, 4);
   NLowOption(154, Node999);
end

// Детали для старого колодца
procedure Node020 begin
   Reply(170);
   if (dude_caps >= WELL_PARTS_PRICE) then
      NOption(171, Node021, 4);
   NOption(172, Node001, 4);
   NLowOption(117, Node999);
end

procedure Node021 begin
   item_caps_adjust(dude_obj, -WELL_PARTS_PRICE);
   item_caps_adjust(self_obj, WELL_PARTS_PRICE);
   set_sfall_global(GV_WELL_OLD, WELL_OLD_PARTS);
   Reply(173);
   NOption(174, Node001, 4);
   NLowOption(117, Node999);
end

procedure Node030 begin
   Reply(180);
   NOption(181, Node001, 4);
   NLowOption(117, Node999);
end

// Частокол (1.3): кто платит — герой, касса или вскладчину
procedure Node040 begin
   variable c;
   c := pay_cash_now;
   Reply(210);
   if (can_pay_hero(FENCE_PRICE)) then NOption(211, Node041, 4);
   if (can_pay_cash(FENCE_PRICE)) then NOption(mstr(212) + c + mstr(215), Node042, 4);
   if (can_pay_split(FENCE_PRICE)) then NOption(mstr(213) + c + mstr(214) + (FENCE_PRICE - c) + mstr(219), Node043, 4);
   NOption(218, Node010, 4);
   NLowOption(117, Node999);
end

procedure fence_pay(variable who) begin
   call pay_do(FENCE_PRICE, who);
   go_fence := 1;
   Reply(216);
   NOption(166, Node999, 4);
   NLowOption(154, Node999);
end

procedure Node041 begin
   call fence_pay(PAY_HERO);
end

procedure Node042 begin
   call fence_pay(PAY_CASH);
end

procedure Node043 begin
   call fence_pay(PAY_SPLIT);
end

// ---- Похороны после набега (1.3): герой дает 50 крышек, Хэнк не берет и копает сам ----
procedure Node050 begin
   Reply(301);
   if (dude_caps >= 50) then NOption(302, Node051, 4);
   NOption(303, Node052, 4);
   NOption(304, Node001, 4);
   NLowOption(305, Node052);
end

procedure Node051 begin
   Reply(306);
   NOption(308, Node053, 4);
end

procedure Node052 begin
   Reply(307);
   NOption(308, Node053, 4);
   NLowOption(308, Node053);
end

// Что сказать у могилы
procedure Node053 begin
   Reply(309);
   NOption(310, Node054, 4);
   NOption(311, Node055, 4);
   NOption(312, Node056, 4);
   NLowOption(313, Node999);
   if (dude_iq < 4) then go_bury := 4;
end

procedure Node054 begin
   go_bury := 1;
end

procedure Node055 begin
   if (has_skill(dude_obj, SKILL_SPEECH) >= BURY_SPEECH_SKILL) then go_bury := 2;
   else go_bury := 5;
end

procedure Node056 begin
   go_bury := 3;
end

// Расчистка взорванного погреба в карьере (Егор 2026-10-09): кто платит — герой, касса или вскладчину
procedure Node140 begin
   variable c;
   c := pay_cash_now;
   Reply(801);
   if (can_pay_hero(CELL_CLEAR_PRICE)) then NOption(802, Node141, 4);
   if (can_pay_cash(CELL_CLEAR_PRICE)) then NOption(mstr(212) + c + mstr(215), Node142, 4);
   if (can_pay_split(CELL_CLEAR_PRICE)) then NOption(mstr(213) + c + mstr(214) + (CELL_CLEAR_PRICE - c) + mstr(219), Node143, 4);
   NOption(218, Node001, 4);
   NLowOption(117, Node999);
end

// Хэнк с людьми уходит в карьер: через сутки лаз открыт (cell_open в f2mlair.h)
procedure cell_pay(variable who) begin
   call pay_do(CELL_CLEAR_PRICE, who);
   set_sfall_global(GV_CELL_OPEN, bld_hour + CELL_CLEAR_HOURS + 1);
   Reply(803);
   NOption(166, Node999, 4);
   NLowOption(154, Node999);
end

procedure Node141 begin
   call cell_pay(PAY_HERO);
end

procedure Node142 begin
   call cell_pay(PAY_CASH);
end

procedure Node143 begin
   call cell_pay(PAY_SPLIT);
end

procedure Node999 begin
end

// ---- Улучшения зданий (0.7.0) ----

// Достроено, пока герой на карте: экран гаснет, на карте новый уровень (ждем, пока закрыты диалог, бой и окна)
procedure bld_map_sync begin
   if (cur_map_index != MAP_F2MOD_CAMP or combat_is_initialized or get_sfall_global_int(GV_BURY_ON)) then return;
   if ((get_game_mode bwand 0x3FFFFD) != 0) then return;
   gfade_out(1);
   call bld_apply;
   gfade_in(1);
end

// 1-й уровень (мастерская, пост, бар, медпункт): экран гаснет, три часа, постройка на месте
procedure do_l1 begin
   variable u;
   u := go_l1;
   go_l1 := -1;
   gfade_out(1);
   game_time_advance(bld_hours(u, 1) * ONE_GAME_HOUR);
   call bld_set_level(u, 1);
   call bld_commit;
   call bld_apply;
   gfade_in(1);
   display_msg(mstr(590) + mstr(600 + u * 5 + 1) + ".");
   if (helped) then begin
      give_exp_points(BLD_HELP_XP);
      display_msg(mstr(195) + BLD_HELP_XP + mstr(196));
   end
end

// Герой ждет у Хэнка: экран гаснет, проходит срок стройки, здание стоит
procedure do_wait begin
   variable j;
   j := go_wait;
   go_wait := 0;
   gfade_out(1);
   game_time_advance(bld_job_left(j) * ONE_GAME_HOUR);
   call bld_commit;
   call bld_apply;
   gfade_in(1);
   if (helped) then begin
      give_exp_points(BLD_HELP_XP * helped);
      display_msg(mstr(195) + (BLD_HELP_XP * helped) + mstr(196));
      helped := 0;
   end
end

// Следующий уровень, который можно заказать (0 — нельзя: уже наверху, строится, или 1-й уровень строит не этот пункт)
procedure bld_offer(variable u) begin
   variable lv;
   lv := bld_level(u) + 1;
   if (lv > bld_top(u) or bld_job_of(u)) then return 0;
   if (lv == 1 and bld_price(u, 1) == 0) then return 0;
   if (bld_is_house(u) and lv == 1) then return 0;
   return lv;
end

// Пункт меню: «Название: цена, срок»
procedure bld_opt(variable u) begin
   variable lv, t, h;
   lv := bld_offer(u);
   h := bld_hours(u, lv);
   t := mstr(bld_name(u, lv)) + ": " + bld_price(u, lv) + mstr(415);
   if (lv == 1 and u != U_BASE_UNIT) then t += h + mstr(418);
   else if (h <= 24) then t += (h / 24) + mstr(416);
   else t += (h / 24) + mstr(417);
   if (lv >= 2 or u == U_BASE_UNIT) then t += mstr(451);
   return t;
end

// Кто сейчас строит и сколько осталось
procedure bld_jobs_text begin
   variable j := 1, t := "", n := 0, u;
   while (j <= BLD_JOBS) do begin
      u := get_sfall_global_int(GV_JOB_U(j));
      if (u) then begin
         if (n) then t += mstr(406);
         if (u > BLD_BATCH) then t += mstr(446);
         else t += mstr(bld_name(u - 1, get_sfall_global_int(GV_JOB_L(j))));
         t += mstr(404) + bld_job_left(j) + mstr(405);
         n += 1;
      end
      j += 1;
   end
   if (n) then return mstr(402) + t;
   return mstr(403);
end

procedure Node060 begin
   Reply(mstr(401) + bld_jobs_text);
   NOption(407, Node061, 4);
   NOption(408, Node062, 4);
   NOption(409, Node063, 4);
   NOption(410, Node064, 4);
   if (bld_offer(U_HERO)) then NOption(411, Node065, 4);
   if (get_sfall_global_int("f2mlairs") >= 2) then NOption(452, Node066, 4);   // логово взято (f2mlair.h): военная база
   NOption(412, Node001, 4);
   NLowOption(117, Node999);
end

// Вода и огороды
procedure Node061 begin
   if ((bld_offer(U_OLDWELL) != 0) + (bld_offer(U_NEWWELL) != 0) + (bld_offer(U_GARDEN) != 0) + (bld_offer(U_GARDEN + 1) != 0)) then Reply(414);
   else Reply(413);
   if (bld_offer(U_OLDWELL)) then NOption(bld_opt(U_OLDWELL), Node100, 4);
   if (bld_offer(U_NEWWELL)) then NOption(bld_opt(U_NEWWELL), Node101, 4);
   if (bld_offer(U_GARDEN)) then NOption(bld_opt(U_GARDEN), Node102, 4);
   if (bld_offer(U_GARDEN + 1)) then NOption(bld_opt(U_GARDEN + 1), Node103, 4);
   NOption(419, Node060, 4);
   NLowOption(117, Node999);
end

// Сколько палаток еще не шатры и не в стройке; первая такая — в sel_u
procedure bld_houses_free begin
   variable i := 0, n := 0;
   sel_u := -1;
   while (i < 8) do begin
      if (bld_offer(bld_house_unit(i))) then begin
         if (sel_u < 0) then sel_u := bld_house_unit(i);
         n += 1;
      end
      i += 1;
   end
   return n;
end

// Жилье: шатер вместо одной палатки или вместо всех разом
procedure Node062 begin
   variable n;
   n := bld_houses_free;
   if (not n) then Reply(413);
   else begin
      Reply(414);
      NOption(441, Node080, 4);
      if (n >= 2) then NOption(mstr(439) + n + mstr(440), Node081, 4);
   end
   NOption(419, Node060, 4);
   NLowOption(117, Node999);
end

// Хозяйство
procedure Node063 begin
   if ((bld_offer(U_STORE) != 0) + (bld_offer(U_WORKSHOP) != 0) + (bld_offer(U_FARM) != 0)) then Reply(414);
   else Reply(413);
   if (bld_offer(U_STORE)) then NOption(bld_opt(U_STORE), Node112, 4);
   if (bld_offer(U_WORKSHOP)) then NOption(bld_opt(U_WORKSHOP), Node114, 4);
   if (bld_offer(U_FARM)) then NOption(bld_opt(U_FARM), Node116, 4);
   NOption(419, Node060, 4);
   NLowOption(117, Node999);
end

// Для людей
procedure Node064 begin
   if ((bld_offer(U_CENTRE) != 0) + (bld_offer(U_GUARD) != 0) + (bld_offer(U_BAR) != 0) + (bld_offer(U_MED) != 0)) then Reply(414);
   else Reply(413);
   if (bld_offer(U_CENTRE)) then NOption(bld_opt(U_CENTRE), Node113, 4);
   if (bld_offer(U_GUARD)) then NOption(bld_opt(U_GUARD), Node115, 4);
   if (bld_offer(U_BAR)) then NOption(bld_opt(U_BAR), Node117, 4);
   if (bld_offer(U_MED)) then NOption(bld_opt(U_MED), Node118, 4);
   NOption(419, Node060, 4);
   NLowOption(117, Node999);
end

procedure Node065 begin
   call bld_sel(U_HERO);
end

// Военная база в карьере (1.5): этапы за крышки, гарнизон — наемники, живут бесплатно
procedure Node066 begin
   if (not bld_level(U_BASE_UNIT) and not bld_camp_ready(BASE_CAMP_LEVEL)) then begin
      Reply(467);
      NOption(461, Node067, 4);
      NOption(419, Node060, 4);
      NLowOption(117, Node999);
      return;
   end
   if (not bld_level(U_BASE_UNIT)) then Reply(460);
   else if (bld_offer(U_BASE_UNIT)) then Reply(465);
   else Reply(466);
   if (bld_offer(U_BASE_UNIT)) then NOption(bld_opt(U_BASE_UNIT), Node120, 4);
   NOption(461, Node067, 4);
   NOption(463, Node068, 4);
   NLowOption(117, Node999);
end

procedure Node067 begin
   Reply(462);
   NOption(419, Node066, 4);
   NLowOption(117, Node999);
end

procedure Node068 begin
   Reply(464);
   NOption(419, Node060, 4);
   NLowOption(117, Node999);
end

procedure Node120 begin call bld_sel(U_BASE_UNIT); end

procedure Node100 begin call bld_sel(U_OLDWELL); end
procedure Node101 begin call bld_sel(U_NEWWELL); end
procedure Node102 begin call bld_sel(U_GARDEN); end
procedure Node103 begin call bld_sel(U_GARDEN + 1); end
procedure Node112 begin call bld_sel(U_STORE); end
procedure Node113 begin call bld_sel(U_CENTRE); end
procedure Node114 begin call bld_sel(U_WORKSHOP); end
procedure Node115 begin call bld_sel(U_GUARD); end
procedure Node116 begin call bld_sel(U_FARM); end
procedure Node117 begin call bld_sel(U_BAR); end
procedure Node118 begin call bld_sel(U_MED); end
procedure Node119 begin call bld_sel(U_HERO); end

procedure bld_sel(variable u) begin
   sel_u := u;
   sel_lv := bld_offer(u);
   sel_price := bld_price(u, sel_lv);
   call Node070;
end

// Кто платит: герой, касса или вскладчину (как частокол)
procedure bld_pay_opts(variable price) begin
   variable c;
   c := pay_cash_now;
   if (can_pay_hero(price)) then NOption(425, Node073, 4);
   if (can_pay_cash(price)) then NOption(mstr(426) + c + mstr(427), Node074, 4);
   if (can_pay_split(price)) then NOption(mstr(428) + c + mstr(429) + (price - c) + mstr(430), Node075, 4);
end

// Выбранное здание: что даст, цена, срок
procedure Node070 begin
   if (not sel_lv) then begin
      call Node060;
      return;
   end
   if (sel_lv == 1 and sel_u != U_BASE_UNIT) then begin
      Reply(mstr(700 + sel_u * 5 + 1) + " " + mstr(421) + sel_price + mstr(424));
      NOption(431, Node071, 4);
      if (dude_caps >= sel_price) then NOption(432, Node072, 4);
   end else if (not bld_job_free) then begin
      Reply(420);
   end else begin
      helped := 0;
      if (bld_is_house(sel_u)) then Reply(444);
      else Reply(mstr(bld_desc(sel_u, sel_lv)) + " " + mstr(421) + sel_price + mstr(422) + (bld_hours(sel_u, sel_lv) / 24) + mstr(423));
      call bld_pay_opts(sel_price);
      // 2-й уровень тоже можно строить своими руками (Егор 2026-10-08): на треть дешевле, но ждать на месте до конца
      if (get_critter_stat(dude_obj, STAT_st) >= BLD_HELP_STAT and get_critter_stat(dude_obj, STAT_en) >= BLD_HELP_STAT) then
         NOption(448, Node078, 4);
   end
   NOption(433, Node060, 4);
   NLowOption(117, Node999);
end

// 1-й уровень: помогает сам (Сила и Выносливость)
procedure Node071 begin
   if (get_critter_stat(dude_obj, STAT_st) >= BLD_HELP_STAT and get_critter_stat(dude_obj, STAT_en) >= BLD_HELP_STAT) then begin
      helped := 1;
      go_l1 := sel_u;
      Reply(447);
      NOption(153, Node999, 4);
      NLowOption(154, Node999);
   end else begin
      Reply(155);
      if (dude_caps >= sel_price) then NOption(432, Node072, 4);
      NOption(433, Node060, 4);
      NLowOption(117, Node999);
   end
end

// 1-й уровень: платит крышками
procedure Node072 begin
   item_caps_adjust(dude_obj, -sel_price);
   item_caps_adjust(self_obj, sel_price);
   helped := 0;
   go_l1 := sel_u;
   Reply(165);
   NOption(166, Node999, 4);
   NLowOption(154, Node999);
end

procedure Node073 begin call bld_pay(PAY_HERO); end
procedure Node074 begin call bld_pay(PAY_CASH); end
procedure Node075 begin call bld_pay(PAY_SPLIT); end

// Оплачено: бригада начинает. Шатры разом — одна бригада на все свободные палатки
procedure bld_pay(variable who) begin
   variable j, i := 0, mask := 0;
   if (not bld_job_free) then begin
      call Node070;
      return;
   end
   call pay_do(sel_price, who);
   if (sel_u < 0) then begin
      while (i < 8) do begin
         if (bld_offer(bld_house_unit(i))) then mask := mask bwor cv_bit(i);
         i += 1;
      end
      j := bld_job_start(BLD_BATCH + mask - 1, 2, BLD_BATCH_HOURS);
   end else
      j := bld_job_start(sel_u, sel_lv, bld_hours(sel_u, sel_lv));
   sel_lv := j;
   if (helped) then begin
      Reply(450);
      NOption(435, Node076, 4);
      NLowOption(445, Node076);
      return;
   end
   Reply(434);
   NOption(435, Node076, 4);
   NOption(436, Node077, 4);
   NLowOption(445, Node999);
end

procedure Node076 begin
   go_wait := sel_lv;
end

// 2-й уровень своими руками: цена меньше на треть, бригада с героем, ждем на месте
procedure Node078 begin
   helped := sel_lv;   // опыт за помощь растет с уровнем: 25 за каждый
   sel_price := sel_price * BLD_HELP_PCT / 100;
   Reply(mstr(449) + sel_price + mstr(422) + (bld_hours(sel_u, sel_lv) / 24) + mstr(423));
   call bld_pay_opts(sel_price);
   NOption(433, Node060, 4);
   NLowOption(117, Node999);
end

procedure Node077 begin
   Reply(437);
   NOption(438, Node999, 4);
   NLowOption(445, Node999);
end

// Шатер вместо одной палатки
procedure Node080 begin
   call bld_houses_free;
   call bld_sel(sel_u);
end

// Шатры вместо всех палаток разом
procedure Node081 begin
   variable n;
   n := bld_houses_free;
   sel_u := -1;
   sel_lv := 2;
   sel_price := n * bld_price(U_HOUSE, 2);
   if (not bld_job_free) then Reply(420);
   else begin
      Reply(mstr(442) + sel_price + mstr(443));
      call bld_pay_opts(sel_price);
   end
   NOption(433, Node060, 4);
   NLowOption(117, Node999);
end
