// Налетчик в логове (квест 1.4). Двое на посту у входа: окликают чужого и пропускают к главарю, если он пришел говорить.
// В лагере чужого без пропуска замечают на 7 клеток (со Скрытностью 60 в режиме скрытности — только вплотную): тревога.
// После союза с Кейном (LAIR_HOW_ALLY) — гарнизон карьера, свой для героя.
// Сторожа погреба (0.9.9, Егор: внизу была тишина) окликают героя и говорят: Красноречием 60 или сотней крышек
// их можно отправить наверх, можно уйти самому, можно драться. Во второй раз не говорят — сразу бой.
#define SCRIPT_REALNAME "f2mlrdr"
#include "define.h"
#include "f2mod.h"
#define NAME                    SCRIPT_F2MLRDR
#include "command.h"
#include "sfall.h"
#include "define_extra.h"
#include "scenepid.h"
#include "f2mcv.h"
#include "f2mcamp.h"
#include "f2mset.h"
#include "f2mpay.h"
#include "f2mraid.h"
#include "f2mlair.h"
#include "f2mlairl.h"
#include "f2mcelll.h"

procedure start;
procedure critter_p_proc;
procedure combat_p_proc;
procedure damage_p_proc;
procedure talk_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;
procedure destroy_p_proc;
procedure Node001;
procedure Node002;
procedure Node003;
procedure Node999;
procedure Node010;
procedure Node011;
procedure Node012;
procedure Node013;
procedure Node014;
procedure cell_watch;

// LVAR 0: роль (1 пост у входа, 2 лагерь), LVAR 1: 1 = уже окликнул героя
#define LVAR_ROLE       (0)
#define LVAR_WARNED     (1)
#define is_post         (local_var(LVAR_ROLE) == 1)
#define is_cell         (local_var(LVAR_ROLE) == 3)
// Разговор со сторожами погреба: 0 не было, 1 идет или герой ушел от ответа, 2 ушли наверх, 3 герою велели убираться
#define GV_CELL_TALK    "f2mcellk"
#define CELL_SPEECH     (60)
#define CELL_BRIBE      (100)

variable cell_go;   // 1 = после разговора герой поднимается наверх

procedure start begin
end

procedure look_at_p_proc begin
   script_overrides;
   display_msg(mstr(100));
end

procedure description_p_proc begin
   script_overrides;
   display_msg(mstr(101));
end

procedure critter_p_proc begin
   if (not local_var(LVAR_ROLE)) then begin
      if (cur_map_index == MAP_F2MOD_CELL) then
         set_local_var(LVAR_ROLE, 3);
      else if (tile_distance(tile_num(self_obj), LAIR_POST0) <= 1 or tile_distance(tile_num(self_obj), LAIR_POST1) <= 1) then
         set_local_var(LVAR_ROLE, 1);
      else
         set_local_var(LVAR_ROLE, 2);
   end
   if (get_sfall_global_int(GV_LAIR_HOW) == LAIR_HOW_ALLY or lair_done) then return;
   if (get_sfall_global_int(GV_LAIR_ALARM)) then begin
      if (not combat_is_initialized and (obj_can_see_obj(self_obj, dude_obj) or tile_distance_objs(self_obj, dude_obj) <= 2 * LAIR_SEE)) then
         attack(dude_obj);
      return;
   end
   if (is_cell) then begin
      call cell_watch;
      return;
   end
   if (get_sfall_global_int(GV_LAIR_PASS) or not lair_seen(self_obj)) then return;
   if (is_post) then begin
      // Часовой окликает и сам заговаривает, как Кейн у ворот поселения
      if (not local_var(LVAR_WARNED)) then begin
         set_local_var(LVAR_WARNED, 1);
         floater(110);
         dialogue_system_enter;
      end
   end else begin
      floater(111);
      call lair_alarm;
      attack(dude_obj);
   end
end

// Сторож погреба. В пещере темно, и obj_can_see_obj часто молчит: замечает по расстоянию (6 клеток,
// со Скрытностью 60 в режиме скрытности — 2)
procedure cell_watch begin
   variable d, k;
   k := get_sfall_global_int(GV_CELL_TALK);
   if (k == 2) then begin
      // отпустили наверх: идут к лестнице и уходят
      if (tile_distance(tile_num(self_obj), CELL_LADDER) <= 1) then begin
         set_sfall_global(GV_CELL_GANG, get_sfall_global_int(GV_CELL_GANG) - 1);
         destroy_object(self_obj);
      end else if (not anim_busy(self_obj)) then
         animate_move_obj_to_tile(self_obj, tile_num_in_direction(CELL_LADDER, 2, 1), 0);
      return;
   end
   d := tile_distance_objs(self_obj, dude_obj);
   if (dude_is_sneaking and has_skill(dude_obj, SKILL_SNEAK) >= LAIR_SNEAK) then begin
      if (d > LAIR_SNEAK_SEE) then return;
   end else if (d > 6) then return;
   if (k == 0) then begin
      set_sfall_global(GV_CELL_TALK, 1);
      floater(150);
      dialogue_system_enter;
   end else begin
      // во второй раз (или ушел от ответа) не разговаривают
      floater(112);
      call lair_alarm;
      attack(dude_obj);
   end
end

procedure combat_p_proc begin
   if (fixed_param == COMBAT_SUBTYPE_TURN and get_sfall_global_int(GV_LAIR_ALARM)
       and not get_object_data(self_obj, OBJ_DATA_WHO_HIT_ME)) then
      set_object_data(self_obj, OBJ_DATA_WHO_HIT_ME, dude_obj);
end

procedure damage_p_proc begin
   if (is_dude_side(source_obj) and get_sfall_global_int(GV_LAIR_HOW) != LAIR_HOW_ALLY and not lair_done) then begin
      call lair_alarm;
      attack(dude_obj);
   end
end

// Последний из банды пал в бою: логово взято
procedure destroy_p_proc begin
   call lair_gang_fall(self_obj);
end

procedure talk_p_proc begin
   if (get_sfall_global_int(GV_LAIR_HOW) == LAIR_HOW_ALLY) then begin
      floater(random(130, 132));
      return;
   end
   if (get_sfall_global_int(GV_LAIR_ALARM)) then begin
      floater(112);
      return;
   end
   if (is_cell) then begin
      if (get_sfall_global_int(GV_CELL_TALK) == 2) then begin
         floater(165);
         return;
      end
      set_sfall_global(GV_CELL_TALK, 1);
      start_gdialog(NAME, self_obj, 4, -1, -1);
      gSay_Start;
         call Node010;
      gSay_End;
      end_dialogue;
      if (get_sfall_global_int(GV_LAIR_ALARM)) then attack(dude_obj);
      else if (cell_go) then begin
         cell_go := 0;
         set_sfall_global(GV_CELL_BACK, 1);
         load_map(MAP_F2MOD_LAIR, 0);
      end
      return;
   end
   if (not is_post or get_sfall_global_int(GV_LAIR_PASS)) then begin
      floater(random(120, 122));
      return;
   end
   start_gdialog(NAME, self_obj, 4, -1, -1);
   gSay_Start;
      call Node001;
   gSay_End;
   end_dialogue;
   if (get_sfall_global_int(GV_LAIR_ALARM)) then attack(dude_obj);
end

// Часовой: чего надо?
procedure Node001 begin
   Reply(140);
   NOption(141, Node002, 4);
   NOption(142, Node003, 4);
   NOption(143, Node999, 4);
   NLowOption(144, Node002);
end

// Пришел говорить: пропуск к главарю
procedure Node002 begin
   set_sfall_global(GV_LAIR_PASS, 1);
   Reply(145);
   NOption(146, Node999, 4);
   NLowOption(147, Node999);
end

// Пришел за запасами: тревога
procedure Node003 begin
   call lair_alarm;
   Reply(148);
   NOption(149, Node999, 4);
end

// Сторож погреба: кто такой?
procedure Node010 begin
   Reply(151);
   if (lair_kane_dead) then NOption(164, Node011, 4);   // Кейн убит у ворот: о нем не врем
   else NOption(152, Node011, 4);
   if (dude_caps >= CELL_BRIBE) then NOption(153, Node012, 4);
   NOption(154, Node013, 4);
   NOption(155, Node014, 4);
   NLowOption(156, Node011);
end

// «Кейн велел подняться наверх»: Красноречие 60
procedure Node011 begin
   if (has_skill(dude_obj, SKILL_SPEECH) >= CELL_SPEECH) then begin
      set_sfall_global(GV_CELL_TALK, 2);
      if (lair_kane_dead) then Reply(166);
      else Reply(157);
      NOption(158, Node999, 4);
   end else begin
      call lair_alarm;
      if (lair_kane_dead) then Reply(167);
      else Reply(159);
      NOption(149, Node999, 4);
   end
end

// Сотня на выпивку
procedure Node012 begin
   item_caps_adjust(dude_obj, -CELL_BRIBE);
   set_sfall_global(GV_CELL_TALK, 2);
   Reply(160);
   NOption(158, Node999, 4);
end

// За запасами: бой
procedure Node013 begin
   call lair_alarm;
   Reply(161);
   NOption(149, Node999, 4);
end

// Ухожу: сторожа выпроваживают наверх, во второй раз стреляют
procedure Node014 begin
   set_sfall_global(GV_CELL_TALK, 3);
   cell_go := 1;
   Reply(162);
   NOption(163, Node999, 4);
end

procedure Node999 begin
end
