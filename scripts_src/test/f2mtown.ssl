// Песочница для обкатки стройки города (только с f2mod_test.dat). Пустая карта с полом будущего города
// (tools/layout/town_build.py), машина героя и строитель, который все ставит прямо из диалога.
#define SCRIPT_REALNAME "f2mtown"
#include "define.h"
#include "updatmap.h"
#include "command.h"
#include "scenepid.h"
#include "sfall.h"
#include "f2mod.h"

#define CAR_HEX       (32283)   // стоянка машины у двора каравана (u116 y161, как в town_max.py)
#define BUILDER_HEX   (30099)   // строитель на главной дороге за воротами (u100 y150)
#define GV_TB_INIT    "f2mtinit"   // 1 = строитель уже поставлен

procedure start;
procedure map_enter_p_proc;
procedure map_update_p_proc;
procedure map_exit_p_proc;

procedure start begin
end

procedure map_enter_p_proc begin
   variable who, item;
   Lighting;
   Check_Create_Car(CAR_HEX, 0)
   if (is_loading_game or get_sfall_global_int(GV_TB_INIT)) then return;
   set_sfall_global(GV_TB_INIT, 1);
   who := create_object_sid(PID_DOCK_WORKER, BUILDER_HEX, 0, SCRIPT_F2MTBLD);
   critter_add_trait(who, TRAIT_OBJECT, OBJECT_TEAM_NUM, TEAM_PLAYER);
   display_msg("F2mod: песочница стройки. Строитель стоит за воротами, на главной дороге.");
end

procedure map_update_p_proc begin
   Lighting;
end

procedure map_exit_p_proc begin
   if (not car_out_of_fuel) then begin
      if (tile_contains_pid_obj(global_var(GVAR_CAR_PLACED_TILE), 0, PID_DRIVABLE_CAR) != 0) then begin
         set_global_var(GVAR_CAR_PLACED_TILE, 0);
         car_give_to_party;
      end
   end
end
