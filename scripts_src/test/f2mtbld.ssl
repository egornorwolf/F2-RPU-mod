procedure Nb0 begin sel := 0; call Node012; end
procedure Nb1 begin sel := 1; call Node012; end
procedure Nb2 begin sel := 2; call Node012; end
procedure Nb3 begin sel := 3; call Node012; end
procedure Nb4 begin sel := 4; call Node012; end
procedure Nb5 begin sel := 5; call Node012; end
procedure Nb6 begin sel := 6; call Node012; end
procedure Nb7 begin sel := 7; call Node012; end
procedure Nb8 begin sel := 8; call Node012; end
procedure Nb9 begin sel := 9; call Node012; end
procedure Nb10 begin sel := 10; call Node012; end
procedure Nb11 begin sel := 11; call Node012; end
procedure Nb12 begin sel := 12; call Node012; end
procedure Nall begin sel := -1; call Node012; end

procedure Nl0 begin arg := 0; act := ACT_ALL if sel < 0 else ACT_BLD; end
procedure Nl1 begin arg := 1; act := ACT_ALL if sel < 0 else ACT_BLD; end
procedure Nl2 begin arg := 2; act := ACT_ALL if sel < 0 else ACT_BLD; end
procedure Nl3 begin arg := 3; act := ACT_ALL if sel < 0 else ACT_BLD; end
procedure Nl4 begin arg := 4; act := ACT_ALL if sel < 0 else ACT_BLD; end
procedure Ntree begin act := ACT_TREES; end
procedure Ntrash begin act := ACT_TRASH; end
procedure Nlight0 begin act := ACT_LIGHT; arg := 0; end
procedure Nlight1 begin act := ACT_LIGHT; arg := 1; end
procedure Nlight2 begin act := ACT_LIGHT; arg := 2; end
procedure Nfence0 begin act := ACT_FENCE; arg := 0; end
procedure Nfence1 begin act := ACT_FENCE; arg := 1; end
procedure Nfence2 begin act := ACT_FENCE; arg := 2; end
procedure Nfence3 begin act := ACT_FENCE; arg := 3; end
procedure Nouter begin act := ACT_OUTER; end
procedure Ntur0 begin act := ACT_TUR; arg := 0; end
procedure Ntur1 begin act := ACT_TUR; arg := 1; end
procedure Ntur2 begin act := ACT_TUR; arg := 2; end
procedure Ntur3 begin act := ACT_TUR; arg := 3; end
procedure Ntur4 begin act := ACT_TUR; arg := 4; end
procedure Nenemy begin act := ACT_ENEMY; end
procedure Nworld begin act := ACT_WORLD; end

procedure Node999 begin
end
