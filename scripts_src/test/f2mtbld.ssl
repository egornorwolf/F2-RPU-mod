// Строитель песочницы (только с f2mod_test.dat). Ставит любое здание на любой уровень 1-4 без квестов и без
// ожидания: экран гаснет, и все уже стоит. Отдельно: деревья, мусор, свет (бочки или фонари), забор
// (частокол, сетка, стена Убежища), внешняя сетка, турели и враги по 2 с каждой стороны города.
// Расстановка: f2mtblay.h (tools/layout/town_emit.py).
#define SCRIPT_REALNAME "f2mtbld"
#include "define.h"
#include "f2mod.h"
#define NAME                    SCRIPT_F2MTBLD
#include "command.h"
#include "sfall.h"
#include "define_extra.h"
#include "f2mtblay.h"

