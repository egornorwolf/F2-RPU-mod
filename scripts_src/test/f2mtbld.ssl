// Что делать после диалога (экран гаснет, все ставится, экран загорается)
#define ACT_NONE    (0)
#define ACT_BLD     (1)     // здание sel на уровень arg (0 = снести)
#define ACT_ALL     (2)     // все здания на уровень arg
#define ACT_TREES   (3)
#define ACT_TRASH   (4)
#define ACT_LIGHT   (5)     // 0 нет, 1 бочки, 2 фонари
#define ACT_FENCE   (6)     // 0 нет, 1 частокол, 2 сетка, 3 стена Убежища
#define ACT_OUTER   (7)
#define ACT_TUR     (8)     // 0 нет, 1 пулеметные, 2 плазменные, 3 лазерные, 4 вперемешку
#define ACT_ENEMY   (9)
#define ACT_WORLD   (10)

// Состояние песочницы в глобальных переменных sfall (сохраняется в игре)
#define gv_bld(b)       ("f2mtb_" + ((b) / 10) + ((b) % 10))
#define GV_TB_TREES     "f2mttree"
#define GV_TB_TRASH     "f2mttrsh"
#define GV_TB_LIGHT     "f2mtlite"
#define GV_TB_FENCE     "f2mtfenc"
#define GV_TB_OUTER     "f2mtoutr"
#define GV_TB_TUR       "f2mtturr"

// Турели: пулеметная (модель magunn, у нее анимации пулемета L — «Спаренный миниган» 518)
// и плазменная (модель magun2, анимации пистолета H — «Спаренная плазменная пушка» 498, как в Наварро).
// Лазерная: та же модель magun2 с лазерным пистолетом (16, тоже анимации H) и запасом малых энергоячеек.
#define TUR_PID(k)      (16777696 * ((k) == 1) + PID_AUTO_GAT_GUN * ((k) == 2 or (k) == 3))
#define TUR_WPN(k)      (518 * ((k) == 1) + PID_GUN_TURRET_WEAPON * ((k) == 2) + PID_LASER_PISTOL * ((k) == 3))

variable sel;
variable tur_i;     // счетчик турелей при обходе кольца: вперемешку тип = 1 + номер % 3
variable act;
variable arg;

procedure start begin
end

procedure look_at_p_proc begin
   script_overrides;
   display_msg(mstr(100));
end

procedure description_p_proc begin
   script_overrides;
   display_msg(mstr(101));
end

procedure talk_p_proc begin
   act := ACT_NONE;
   start_gdialog(NAME, self_obj, 4, -1, -1);
   gSay_Start;
      call Node001;
   gSay_End;
   end_dialogue;
   if (act != ACT_NONE) then call do_action;
end

// Здание b на уровень lv: старый уровень убираем, новый ставим на те же клетки
procedure tb_set(variable b, variable lv) begin
   variable cur;
   cur := get_sfall_global_int(gv_bld(b));
   if (cur == lv) then return;
   if (cur) then begin
      tb_mode := 0;
      call tb_bld(b, cur);
   end
   if (lv) then begin
      tb_mode := 1;
      call tb_bld(b, lv);
   end
   set_sfall_global(gv_bld(b), lv);
end

// Набор объектов: убрать old_s, поставить new_s (-1 = ничего)
procedure sys_swap(variable old_s, variable new_s) begin
   if (old_s >= 0) then begin
      tb_mode := 0;
      call tb_sys(old_s);
   end
   if (new_s >= 0) then begin
      tb_mode := 1;
      call tb_sys(new_s);
   end
end

procedure tb_t(variable tile, variable kind) begin
   variable obj, w;
   if (kind == 4) then begin
      // вперемешку: пулемет, плазма, лазер по кругу; при уборке тот же порядок дает те же типы
      kind := 1 + tur_i % 3;
      tur_i += 1;
   end
   if (tb_mode) then begin
      obj := create_object_sid(TUR_PID(kind), tile, 0, SCRIPT_F2MTUR);
      critter_add_trait(obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, TEAM_PLAYER);
      anim(obj, 1000, 3);
      w := create_object(TUR_WPN(kind), 0, 0);
      add_obj_to_inven(obj, w);
      wield_obj_critter(obj, w);
      if (kind == 3) then add_mult_objs_to_inven(obj, create_object(PID_SMALL_ENERGY_CELL, 0, 0), 5);
   end else begin
      obj := tile_contains_pid_obj(tile, 0, TUR_PID(kind));
      if (obj) then destroy_object(obj);
   end
end

procedure put_enemy(variable pid, variable tile, variable weapon, variable ammo) begin
   variable obj, item;
   obj := create_object_sid(pid, tile, 0, SCRIPT_ECRAIDER);
   critter_add_trait(obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, TEAM_RND_RAIDERS);
   critter_add_trait(obj, TRAIT_OBJECT, OBJECT_AI_PACKET, AI_TOUGH_GUARD);
   item := create_object(weapon, 0, 0);
   add_obj_to_inven(obj, item);
   wield_obj_critter(obj, item);
   add_mult_objs_to_inven(obj, create_object(ammo, 0, 0), 2);
end

procedure do_action begin
   variable b, cur;
   if (act == ACT_WORLD) then begin
      world_map;
      return;
   end
   gfade_out(1);
   if (act == ACT_BLD) then
      call tb_set(sel, arg);
   else if (act == ACT_ALL) then begin
      for (b := 0; b < TB_COUNT; b++) call tb_set(b, arg);
   end else if (act == ACT_TREES) then begin
      cur := get_sfall_global_int(GV_TB_TREES);
      if (cur) then call sys_swap(TB_SYS_TREES, -1); else call sys_swap(-1, TB_SYS_TREES);
      set_sfall_global(GV_TB_TREES, not cur);
   end else if (act == ACT_TRASH) then begin
      cur := get_sfall_global_int(GV_TB_TRASH);
      if (cur) then call sys_swap(TB_SYS_TRASH, -1); else call sys_swap(-1, TB_SYS_TRASH);
      set_sfall_global(GV_TB_TRASH, not cur);
   end else if (act == ACT_LIGHT) then begin
      cur := get_sfall_global_int(GV_TB_LIGHT);
      if (cur != arg) then begin
         call sys_swap((TB_SYS_BARRELS + cur - 1) if cur else -1, (TB_SYS_BARRELS + arg - 1) if arg else -1);
         set_sfall_global(GV_TB_LIGHT, arg);
      end
   end else if (act == ACT_FENCE) then begin
      cur := get_sfall_global_int(GV_TB_FENCE);
      if (cur != arg) then begin
         call sys_swap((TB_SYS_PALISADE + cur - 1) if cur else -1, (TB_SYS_PALISADE + arg - 1) if arg else -1);
         set_sfall_global(GV_TB_FENCE, arg);
      end
   end else if (act == ACT_OUTER) then begin
      cur := get_sfall_global_int(GV_TB_OUTER);
      if (cur) then call sys_swap(TB_SYS_OUTER, -1); else call sys_swap(-1, TB_SYS_OUTER);
      set_sfall_global(GV_TB_OUTER, not cur);
   end else if (act == ACT_TUR) then begin
      cur := get_sfall_global_int(GV_TB_TUR);
      if (cur != arg) then begin
         if (cur) then begin
            tb_mode := 0;
            tur_i := 0;
            call tb_turrets(cur);
         end
         if (arg) then begin
            tb_mode := 1;
            tur_i := 0;
            call tb_turrets(arg);
         end
         set_sfall_global(GV_TB_TUR, arg);
      end
   end else if (act == ACT_ENEMY) then begin
      // по 2 налетчика с каждой стороны, в 8 клетках за линией внешней сетки.
      // Оружие по модели: налетчик (nmlthr) — винтовки и дробовик, налетчица (nfmaxx) — пистолет-пулемет
      call put_enemy(PID_RAIDER_MALE, 18 * 200 + 80, PID_HUNTING_RIFLE, PID_223_FMJ);
      call put_enemy(PID_RAIDER_FEMALE, 18 * 200 + 120, PID_GREASE_GUN, PID_45_CALIBER_AMMO);
      call put_enemy(PID_RAIDER_MALE, 181 * 200 + 70, PID_COMBAT_SHOTGUN, PID_SHOTGUN_SHELLS);
      call put_enemy(PID_RAIDER_FEMALE, 181 * 200 + 130, PID_GREASE_GUN, PID_45_CALIBER_AMMO);
      call put_enemy(PID_RAIDER_MALE, 80 * 200 + 18, PID_HUNTING_RIFLE, PID_223_FMJ);
      call put_enemy(PID_RAIDER_FEMALE, 120 * 200 + 18, PID_GREASE_GUN, PID_45_CALIBER_AMMO);
      call put_enemy(PID_RAIDER_MALE, 80 * 200 + 181, PID_COMBAT_SHOTGUN, PID_SHOTGUN_SHELLS);
      call put_enemy(PID_RAIDER_FEMALE, 120 * 200 + 181, PID_GREASE_GUN, PID_45_CALIBER_AMMO);
   end
   gfade_in(1);
   display_msg(mstr(190));
   act := ACT_NONE;
end

// ---- диалог
procedure Node001 begin
   Reply(110);
   NOption(111, Node010, 1);
   NOption(112, Nall, 1);
   NOption(113, Node030, 1);
   NOption(114, Node040, 1);
   NOption(115, Nenemy, 1);
   NOption(116, Nworld, 1);
   NOption(117, Node999, 1);
end

// Здания по 5 на страницу
