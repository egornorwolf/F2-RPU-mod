   Reply(120);
   NOption(135, Nb5, 1);
   NOption(136, Nb6, 1);
   NOption(137, Nb7, 1);
   NOption(138, Nb8, 1);
   NOption(139, Nb9, 1);
   NOption(121, Node013, 1);
   NOption(122, Node001, 1);
end

procedure Node013 begin
   Reply(120);
   NOption(140, Nb10, 1);
   NOption(141, Nb11, 1);
   NOption(142, Nb12, 1);
   NOption(123, Node010, 1);
   NOption(122, Node001, 1);
end

// Уровень выбранного здания (sel) или всех сразу (sel = -1)
procedure Node012 begin
   if (sel >= 0) then
      Reply(mstr(130 + sel) + mstr(150) + get_sfall_global_int(gv_bld(sel)) + mstr(151));
   else
      Reply(152);
   NOption(153, Nl1, 1);
   NOption(154, Nl2, 1);
   NOption(155, Nl3, 1);
   NOption(156, Nl4, 1);
   NOption(157, Nl0, 1);
   NOption(122, Node001, 1);
end

// Деревья, мусор, свет
