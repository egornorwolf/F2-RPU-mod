   Reply(160);
   NOption(161, Ntree, 1);
   NOption(162, Ntrash, 1);
   NOption(163, Nlight1, 1);
   NOption(164, Nlight2, 1);
   NOption(165, Nlight0, 1);
   NOption(122, Node001, 1);
end

